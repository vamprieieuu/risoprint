0x1801d64e0=[{"size":498,"type":"s","subtype":56,"str":" no specific plate\\n        } else if (proofMode == 2) {       // C\\n            intensity = cCov;\\n            inkColor = inkC;\\n        } else if (proofMode == 3) {       // M\\n            intensity = mCov;\\n            inkColor = inkM;\\n        } else if (proofMode == 4) {       // Y\\n            intensity = yCov;\\n            inkColor = inkY;\\n        } else if (proofMode == 5) {       // K\\n            intensity = kCov;\\n            inkColor = inkK;\\n        } else if (proofMode == 6) {       // QUAD "}]
0x1801d66d5=[{"size":907,"type":"s","subtype":56,"str":" 4-up grid\\n            // Each quadrant shows full image for ONE plate in its actual\\n            // ink colour. Top-left=C, top-right=M, bottom-left=Y,\\n            // bottom-right=K. Re-sample the halftone (cmykTex) at the\\n            // remapped quadrant-local UV.\\n            int qx = (uv.x < 0.5) ? 0 : 1;\\n            int qy = (uv.y < 0.5) ? 0 : 1;\\n            vec2 quadUV = vec2(\\n                (uv.x - 0.5 * float(qx)) * 2.0,\\n                (uv.y - 0.5 * float(qy)) * 2.0\\n            );\\n            vec4 qDots = texture(cmykTex, quadUV);\\n            if      (qx == 0 && qy == 0) { intensity = qDots.r; inkColor = inkC; }\\n            else if (qx == 1 && qy == 0) { intensity = qDots.g; inkColor = inkM; }\\n            else if (qx == 0 && qy == 1) { intensity = qDots.b; inkColor = inkY; }\\n            else                          { intensity = qDots.a; inkColor = inkK; }\\n            // M1 fix mirror "}]
0x1801d6a63=[{"size":250,"type":"s","subtype":56,"str":" apply dotGain so QUAD shows the same\\n            // post-correction view as single-plate proof modes.\\n            if (dotGain > 1.001) {\\n                intensity = pow(max(intensity, 0.0), 1.0 / dotGain);\\n            }\\n            // M2 fix mirror "}]
0x1801d6b60=[{"size":989,"type":"s","subtype":56,"str":" 1-pixel-wide black guideline at quadrant\\n            // boundaries so the 4-up layout reads instantly even on\\n            // small previews. Force black overlay regardless of plate.\\n            float guidePx = 1.0 / max(resolution.x, resolution.y);\\n            float distVert = abs(uv.x - 0.5);\\n            float distHorz = abs(uv.y - 0.5);\\n            if (distVert < guidePx || distHorz < guidePx) {\\n                intensity = 1.0;\\n                inkColor = vec3(0.0, 0.0, 0.0);\\n            }\\n        }\\n        // Render: paper white where no ink, full ink colour where coverage = 1.\\n        // Linear blend matches how a single-pass Riso lays its drum's ink.\\n        float t = clamp(intensity, 0.0, 1.0);\\n        vec3 result = mix(vec3(1.0), inkColor, t);\\n        // OpenGL Pass 3 outputs straight RGBA (alpha pre-multiplied happens\\n        // at SwizzleOut). srcAlpha gates fully-transparent areas.\\n        colourOut = vec4(result, srcAlpha);\\n        return;\\n    }\\n\\n    // ====== F7 "}]
0x1801d6f40=[{"size":282,"type":"s","subtype":56,"str":" TOTAL AREA COVERAGE clamp + ink pooling ======\\n    // tacLimit = 3.0 means \\"no clamp\\" (sum of 4 channels can hit 4.0 max\\n    // anyway). 2.2 (220%) is the realistic offset-printing TAC. When the\\n    // sum exceeds the limit we proportionally scale all four channels\\n    // down so "}]
0x1801d705c=[{"size":341,"type":"s","subtype":56,"str":" = limit. The \\"excess\\" we trimmed away pools into a\\n    // colour-drift effect controlled by inkPool.\\n    float tacExcess = 0.0;\\n    if (tacLimit < 2.999) {\\n        float covSum = cCov + mCov + yCov + kCov;\\n        if (covSum > tacLimit) {\\n            float scale = tacLimit / covSum;\\n            tacExcess = covSum - tacLimit;       // > 0 "}]
0x1801d71b4=[{"size":219,"type":"s","subtype":56,"str":" there's pooling material\\n            cCov *= scale;\\n            mCov *= scale;\\n            yCov *= scale;\\n            kCov *= scale;\\n        }\\n    }\\n\\n    // ====== 3b. INK-PAPER INTERACTION (Blender: MULTIPLY halftone "}]
0x1801d7291=[{"size":89,"type":"s","subtype":56,"str":" paper structure) ======\\n    // Paper structure noise modulates ink coverage per channel "}]
0x1801d72ed=[{"size":253,"type":"s","subtype":56,"str":" ink sits\\n    // differently on rough vs smooth paper areas.\\n    if (usePaperBackground && paperStructure > 0.0) {\\n        float paperNoise = fbm(uv * paperScale * 0.25, 2);\\n        // Map noise to ~0.6..1.0 structure range (Blender: MapRange 0.4..0.54 "}]
0x1801d73ed=[{"size":554,"type":"s","subtype":56,"str":" 0..1)\\n        float structure = clamp((paperNoise - 0.4) / 0.14, 0.0, 1.0);\\n        // Interaction strength derived from paperStructure (maps ~0..0.2)\\n        float interaction = paperStructure * 0.2;\\n        cCov *= mix(1.0, structure, interaction);\\n        mCov *= mix(1.0, structure, interaction);\\n        yCov *= mix(1.0, structure, interaction);\\n        kCov *= mix(1.0, structure, interaction);\\n    }\\n\\n    // ====== 4. DARK SPECKS MASK ======\\n    // Light specks (per-channel ink erosion) are already baked into the\\n    // halftone mask by Pass 2 "}]
0x1801d761a=[{"size":597,"type":"s","subtype":56,"str":" matching Blender's subprocess, which\\n    // subtracts specks BEFORE the GREATER_THAN threshold. Here we only\\n    // derive Dark Specks (extra ink deposits, applied post-mix below).\\n    float darkSpeckMask = 0.0;\\n    if (darkSpecks > 0.0) {\\n        float noiseScale = specksSize * 0.2;\\n        float nFac = fbm(uv * noiseScale, 2);\\n        float dFromMin = darkSpecks * 0.07;\\n        float dFromMax = dFromMin + 0.05;\\n        darkSpeckMask = 1.0 - clamp((nFac - dFromMin) / max(dFromMax - dFromMin, 1e-4), 0.0, 1.0);\\n        darkSpeckMask *= darkSpecks;\\n    }\\n\\n    // ====== 5. INK-PIPELINE (fade "}]
