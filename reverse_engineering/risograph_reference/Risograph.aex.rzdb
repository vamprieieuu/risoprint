0x1801cb92e=[{"size":874,"type":"s","subtype":56,"str":" alt screens have no dot SDF.)\\n    if (screenType != RISO_SCREEN_VORONOI) {\\n        // Pre-blur CMYK if Softness > 0 (mirror of Voronoi sampleCMYKBlurred).\\n        vec4 cmyk = sampleCMYKBlurred(mUV, blurRadius);\\n        // Cell size derived from `scale` so frequency tracks the same\\n        // slider as Voronoi mode. scale is \\"cells per vertical axis\\", so\\n        // pixel cell = resolution.y / scale. Used by Line + scaling helper.\\n        float altCellPx = max(resolution.y / max(scale, 1.0), 1.0);\\n        float bayerStep = max(altCellPx / 8.0, 1.0);\\n        // Dot Hardness scales val: slider 100 = 1.0 (neutral); 200 = 2.0\\n        // (boosted midtones); 50 = 0.5 (lighter). Default 110 gives a\\n        // tiny 10% boost. The uniform is ALREADY pre-divided by 100 on\\n        // the host (see Risograph.cpp Pass 2 upload `* 0.01f`), so it\\n        // arrives as 0.5..3.0 "}]
0x1801cbc9b=[{"size":112,"type":"s","subtype":56,"str":" use directly without further scaling.\\n        float intensityScale = halftoneIntensity;\\n        // Dot Stretch "}]
0x1801cbd0e=[{"size":364,"type":"s","subtype":56,"str":" anisotropic Y-axis scaling of the position lookup.\\n        // Voronoi treats halftoneAspect as cell aspect; here we apply the\\n        // same Y multiplier so alt-screen grid patterns compress/elongate\\n        // along Y identically. Uniform is 0.5..2.0 (host-mapped from -100..100).\\n        float aspectScale = max(halftoneAspect, 0.01);\\n        // Edge Softness "}]
0x1801cbe7d=[{"size":113,"type":"s","subtype":56,"str":" half-width of the soft threshold transition.\\n        // Uniform is 0..1 (host pre-divides /100). At default 0.3 "}]
0x1801cbef1=[{"size":794,"type":"s","subtype":56,"str":" 0.015\\n        // (subtle anti-alias). 0 = legacy hard step. Capped at 0.10 so\\n        // a max slider doesn't wash out the dither pattern.\\n        float edgeHalf = clamp(dotSmoothness * 0.05, 0.0, 0.10);\\n        vec4 dots = vec4(0.0);\\n        for (int ch = 0; ch < 4; ch++) {\\n            // Per-plate transformations on the position-lookup UV. Mirror\\n            // of Voronoi's applyPlateXform + offset, so plate registration\\n            // drift, F4 rotation/skew and per-plate XY offsets all affect\\n            // alt screens identically to how they affect Voronoi.\\n            vec2 perPlateUV = applyPlateXform(mUV, ch);\\n            vec2 perPlateOffset = vec2(offsets[ch * 2], offsets[ch * 2 + 1]) / resolution;\\n            perPlateUV += perPlateOffset;\\n            // Anisotropic stretch "}]
0x1801cc20e=[{"size":331,"type":"s","subtype":56,"str":" same direction Voronoi stretches cells.\\n            perPlateUV.y *= aspectScale;\\n            // Distortion: add per-pixel hash jitter to threshold-lookup\\n            // position. distortion is 0..100; convert to \\"fraction of one\\n            // cell\\" via altCellPx/resolution.y so at distortion=100 the\\n            // jitter spans "}]
0x1801cc35b=[{"size":785,"type":"s","subtype":56,"str":"0.5 cells (visibly disrupts the regular grid)\\n            // and the magnitude tracks `scale` so it stays consistent\\n            // across resolutions.\\n            if (distortion > 0.0) {\\n                vec2 dpos = floor(mUV * resolution);\\n                float jx = hash(dpos + vec2(7.1, 13.7) + float(ch) * 4.3) - 0.5;\\n                float jy = hash(dpos + vec2(31.3, 5.1) + float(ch) * 9.7) - 0.5;\\n                float jScale = (distortion * 0.01) * (altCellPx / resolution.y);\\n                perPlateUV += vec2(jx, jy) * jScale;\\n            }\\n            float val = clamp((cmyk[ch] - specks[ch]) * channelFactors[ch] * intensityScale, 0.0, 1.0);\\n            float threshold = 0.5;\\n            if (screenType == RISO_SCREEN_BAYER) {\\n                // Bayer 8x8 ordered dither "}]
0x1801cc66f=[{"size":357,"type":"s","subtype":56,"str":" proper per-pixel threshold.\\n                ivec2 ipos = ivec2(floor(perPlateUV * resolution / bayerStep));\\n                threshold = bayer8Value(ipos);\\n            } else if (screenType == RISO_SCREEN_BLUENOISE) {\\n                // Per-pixel pseudo blue-noise threshold (no cell binning,\\n                // so each pixel gets its own decorrelated hash "}]
0x1801cc7d7=[{"size":760,"type":"s","subtype":56,"str":" real\\n                // stochastic screening rather than block-flat regions).\\n                vec2 ppos = floor(perPlateUV * resolution / bayerStep);\\n                threshold = pseudoBlueNoise(ppos);\\n            } else if (screenType == RISO_SCREEN_LINE) {\\n                // Line screen: rotated parallel lines whose width varies\\n                // with intensity. Per-channel angle for that classic\\n                // overprinted-line look.\\n                float ang = angles[ch];\\n                vec2 r = vec2(cos(ang), sin(ang));\\n                float yProj = dot(perPlateUV * resolution, r) / altCellPx;\\n                threshold = 0.5 + 0.5 * sin(yProj * 3.14159265);\\n            } else if (screenType == RISO_SCREEN_STIPPLED) {\\n                // F14 "}]
0x1801ccad2=[{"size":968,"type":"s","subtype":56,"str":" Stippled (error-diffusion approximation).\\n                // Per-PIXEL hash (no cell binning) gives fine grain. We\\n                // tighten the threshold range around the channel value to\\n                // approximate Ostromoukhov's adaptive coefficients: the\\n                // closer val is to 0 or 1, the lower the threshold\\n                // variance (so highlights/shadows quantise cleanly).\\n                vec2 ppos = floor(perPlateUV * resolution);\\n                float h0 = hash(ppos + vec2( 0.0,  0.0));\\n                float h1 = hash(ppos + vec2(13.7,  7.3));\\n                // Soft adaptive curve: at val=0.5 spread is full;\\n                // at val=0 or 1, spread collapses, so dots cluster cleanly.\\n                float adapt = 0.5 + 0.45 * (4.0 * val * (1.0 - val) - 1.0);\\n                threshold = mix(0.5, (h0 + h1) * 0.5, clamp(1.0 - adapt, 0.0, 1.0));\\n            } else if (screenType == RISO_SCREEN_ATKINSON) {\\n                // S5.A "}]
0x1801cce9d=[{"size":81,"type":"s","subtype":56,"str":" Atkinson approximation. Mirror of the CUDA\\n                // kernel branch: val"}]
0x1801ccef0=[{"size":320,"type":"s","subtype":56,"str":" lifts midtones (sparser dot pattern,\\n                // mimics Atkinson's \\"lost error\\" 6/8 propagation) plus\\n                // 4-level quantised hash for the discrete-cluster look.\\n                // Defensive 3.999 multiplier: hash is in [0,1) by construction\\n                // but if it ever hits 1.0 floorf(4.0)=4 "}]
0x1801cd033=[{"size":377,"type":"s","subtype":56,"str":" out-of-bucket.\\n                vec2 ppos = floor(perPlateUV * resolution);\\n                float h = hash(ppos);\\n                float liftedVal = val * val * 0.85 + val * 0.15;\\n                float qH = (floor(h * 3.999) + 0.5) * 0.25;\\n                threshold = qH * 0.7 + liftedVal * 0.3;\\n            } else if (screenType == RISO_SCREEN_FLOYD) {\\n                // S5.A "}]
0x1801cd1af=[{"size":880,"type":"s","subtype":56,"str":" Floyd-Steinberg approximation. Mirror of the CUDA\\n                // kernel branch: weighted neighbour-hash sum with the\\n                // F-S kernel weights (7/16, 3/16, 5/16, 1/16) for E, SW,\\n                // S, SE neighbours, mixed with the centre pixel's own hash\\n                // to produce the diagonal cluster bands characteristic of\\n                // real Floyd-Steinberg propagation.\\n                vec2 ppos = floor(perPlateUV * resolution);\\n                float h0 = hash(ppos);\\n                float h1 = hash(ppos + vec2( 1.0,  0.0)) * (7.0 / 16.0)\\n                         + hash(ppos + vec2(-1.0,  1.0)) * (3.0 / 16.0)\\n                         + hash(ppos + vec2( 0.0,  1.0)) * (5.0 / 16.0)\\n                         + hash(ppos + vec2( 1.0,  1.0)) * (1.0 / 16.0);\\n                threshold = h0 * 0.4 + h1 * 0.6;\\n            }\\n            // Edge Softness "}]
0x1801cd522=[{"size":96,"type":"s","subtype":56,"str":" soft transition around the threshold instead\\n            // of binary step. At dotSmoothness=0 "}]
