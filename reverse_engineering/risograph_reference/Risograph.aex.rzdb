0x1801c8c4a=[{"size":874,"type":"s","subtype":56,"str":" NOT for the ink\\n// threshold, which uses `unionDotInk` below so dots can freely overlap\\n// between cells.\\nVoronoiResult voronoiCell(vec2 p, int shape, float randomness)\\n{\\n    vec2 ip = floor(p);\\n    float hardMin    = 10.0;\\n    vec2  bestCenter = vec2(0.0);\\n    for (int j = -1; j <= 1; j++) {\\n        for (int i = -1; i <= 1; i++) {\\n            vec2 neighbor  = ip + vec2(float(i), float(j));\\n            vec2 rndOffset = hash2(neighbor);\\n            vec2  center   = neighbor + mix(vec2(0.5), rndOffset, randomness);\\n            float d        = cellDist(p - center, shape);\\n            if (d < hardMin) {\\n                hardMin    = d;\\n                bestCenter = center;\\n            }\\n        }\\n    }\\n    return VoronoiResult(hardMin, bestCenter);\\n}\\n\\n// Union of 9 neighboring cells' dot contributions.\\n// Each cell's dot is a circle of the same shared channel value "}]
0x1801c8fb7=[{"size":256,"type":"s","subtype":56,"str":" at\\n// `adjusted=1` the radius grows past the cell boundary, so adjacent\\n// cells' dots overlap naturally and dark regions collapse into solid\\n// ink. No Voronoi-cell constraint is applied, so the cell's square /\\n// diamond boundary shape is never visible "}]
0x1801c90ba=[{"size":976,"type":"s","subtype":56,"str":" dots stay perfectly round\\n// at every coverage level.\\nfloat unionDotInk(vec2 gridPos, int shape, float randomness,\\n                  float channelVal, float factor)\\n{\\n    vec2 ip = floor(gridPos);\\n    float ink = 0.0;\\n    for (int j = -1; j <= 1; j++) {\\n        for (int i = -1; i <= 1; i++) {\\n            vec2 neighbor  = ip + vec2(float(i), float(j));\\n            vec2 rndOffset = hash2(neighbor);\\n            vec2  center   = neighbor + mix(vec2(0.5), rndOffset, randomness);\\n            float d        = cellDist(gridPos - center, shape);\\n            ink = max(ink, applyThreshold(d, channelVal, factor));\\n        }\\n    }\\n    return ink;\\n}\\n\\n// ---- Per-plate rotation + skew (F4) ----\\n// Apply BEFORE the screen-angle rotation so the plate transformation is\\n// in image space, independent of which screen angle the plate uses. Both\\n// transforms share an inverse used in gridToUV.\\n//\\n// Order: skew, then rotate (so the rotation operates on already-skewed\\n// coordinates "}]
0x1801c948d=[{"size":903,"type":"s","subtype":56,"str":" matches how a tilted+slipped drum behaves geometrically).\\nvec2 applyPlateXform(vec2 uv, int ch)\\n{\\n    if (plateRotations[ch] == 0.0 && plateSkews[ch] == 0.0) return uv;\\n    // Move to centred pixel coords for stable rotation pivot.\\n    vec2 q = (uv - 0.5) * resolution;\\n    q.x += q.y * plateSkews[ch];\\n    float c = cos(plateRotations[ch]), s = sin(plateRotations[ch]);\\n    q = vec2(q.x * c - q.y * s, q.x * s + q.y * c);\\n    return q / resolution + 0.5;\\n}\\n\\n// Inverse: undo rotation first (it was applied last), then skew.\\nvec2 applyPlateXformInverse(vec2 uv, int ch)\\n{\\n    if (plateRotations[ch] == 0.0 && plateSkews[ch] == 0.0) return uv;\\n    vec2 q = (uv - 0.5) * resolution;\\n    float c = cos(-plateRotations[ch]), s = sin(-plateRotations[ch]);\\n    q = vec2(q.x * c - q.y * s, q.x * s + q.y * c);\\n    q.x -= q.y * plateSkews[ch];\\n    return q / resolution + 0.5;\\n}\\n\\n// ---- Forward transform: UV "}]
0x1801c9817=[{"size":73,"type":"s","subtype":56,"str":" grid position ----\\n// Grid frequency is \\"cells per vertical unit of UV\\" "}]
0x1801c9863=[{"size":133,"type":"s","subtype":56,"str":" same semantics as\\n// Blender's Voronoi Texture Scale. Horizontal cell count scales with\\n// aspect ratio (width/height) via the pixel"}]
0x1801c98eb=[{"size":741,"type":"s","subtype":56,"str":"UV conversion, giving square\\n// cells by default. `halftoneAspect` (0.5..2.0) then stretches the grid\\n// along Y to produce non-square cells, mirroring Blender's X Dim / Y Dim\\n// input to NTCMYK Halftone Process.\\n//\\n// `ch` selects which CMYK plate this is so we can apply per-plate\\n// rotation+skew (F4) before the screen-angle rotation.\\nvec2 computeGridPos(vec2 uv, int ch, float angle, vec2 offset, float freq)\\n{\\n    vec2 puv = applyPlateXform(uv, ch);\\n    vec2 uvOff = puv + offset / resolution;\\n    vec2 pixelPos = uvOff * resolution;\\n    vec2 rotPixel = rotate2D(pixelPos, angle);\\n    vec2 g = rotPixel * freq / resolution.y;\\n    // max() guards against div-by-zero in gridToUV when an expression pushes\\n    // halftoneAspect very low "}]
0x1801c9bd3=[{"size":144,"type":"s","subtype":56,"str":" slider itself is clamped to pow(2, -1..+1).\\n    g.y *= max(halftoneAspect, 0.01);\\n    return g;\\n}\\n\\n// ---- Inverse transform: grid cell center "}]
0x1801c9c66=[{"size":1081,"type":"s","subtype":56,"str":" UV ----\\nvec2 gridToUV(vec2 gridCenter, int ch, float angle, vec2 offset, float freq)\\n{\\n    float aspSafe  = max(halftoneAspect, 0.01);\\n    vec2 gUnaspect = vec2(gridCenter.x, gridCenter.y / aspSafe);\\n    vec2 rotPixel  = gUnaspect * resolution.y / freq;\\n    vec2 pixelPos  = rotate2D(rotPixel, -angle);\\n    vec2 puv = pixelPos / resolution - offset / resolution;\\n    return applyPlateXformInverse(puv, ch);\\n}\\n\\n// ---- Sample CMYK with optional 4-sample blur (Blender NT4SampleBlur) ----\\nvec4 sampleCMYKBlurred(vec2 centerUV, float blurRadius)\\n{\\n    if (blurRadius > 0.0001) {\\n        return (\\n            texture(cmykTex, centerUV + vec2( blurRadius, 0.0)) +\\n            texture(cmykTex, centerUV + vec2(-blurRadius, 0.0)) +\\n            texture(cmykTex, centerUV + vec2(0.0,  blurRadius)) +\\n            texture(cmykTex, centerUV + vec2(0.0, -blurRadius))\\n        ) * 0.25;\\n    }\\n    return texture(cmykTex, centerUV);\\n}\\n\\n// ---- Per-pixel speck values per CMYK channel ----\\n//   Blender NTSpecks: ShaderNodeTexNoise dim=3 (W=14.6, detail=2,\\n//     roughness=0.8, distortion=0.86) "}]
0x1801ca0a2=[{"size":73,"type":"s","subtype":56,"str":" 4 channels (Fac + Color R/G/B)\\n//     each smooth-step remapped to 0..1 "}]
0x1801ca0ee=[{"size":11,"type":"s","subtype":56,"str":" pow(0.36) "}]
0x1801ca0fb=[{"size":506,"type":"s","subtype":56,"str":" 2\\n//   We use fbm3D with W slices decorrelating the four speck fields. This\\n//   gives a 3D-noise character matching Blender's dim=3 node, and the\\n//   W=14.6 seed reproduces the same default pattern as the .blend file.\\nvec4 computeSpecks(vec2 uv)\\n{\\n    if (specksAmount <= 0.0) return vec4(0.0);\\n    float noiseScale = specksSize * 0.2;\\n    vec2  nuv = uv * noiseScale;\\n    // W=14.6 matches Blender NTSpecks `Noise Texture.W` default. Adding\\n    // drumAnimW (default 0) shifts each frame's noise slice "}]
0x1801ca2f8=[{"size":493,"type":"s","subtype":56,"str":" \\"different\\n    // print on each frame\\" when the user enables drum animation.\\n    float nK = fbm3D(vec3(nuv,                  14.6 + drumAnimW),        2);\\n    float nC = fbm3D(vec3(nuv + vec2(17.3, 5.7), 17.1 + drumAnimW),       2);\\n    float nM = fbm3D(vec3(nuv + vec2(31.1, 43.2), 29.4 + drumAnimW),      2);\\n    float nY = fbm3D(vec3(nuv + vec2(71.9, 23.8), 41.8 + drumAnimW),      2);\\n\\n    // Blender: MapRange(noise, 1-amount*0.4, (1-amount*0.4)+0.09, 0,1, smoothstep)\\n    //            "}]
0x1801ca4e8=[{"size":425,"type":"s","subtype":56,"str":" pow(0.36) * 2   (clamp after)\\n    float fromMin = 1.0 - specksAmount * 0.4;\\n    float fromMax = fromMin + 0.09;\\n    float inv = 1.0 / max(fromMax - fromMin, 1e-4);\\n\\n    vec4 n = vec4(nC, nM, nY, nK);\\n    vec4 t = clamp((n - fromMin) * inv, 0.0, 1.0);\\n    // smoothstep curve (matches Blender's \\"Smooth Step\\" interpolation)\\n    t = t * t * (3.0 - 2.0 * t);\\n    return clamp(pow(t, vec4(0.36)) * 2.0, 0.0, 1.0);\\n}\\n\\n// ---- F6 "}]
0x1801ca694=[{"size":640,"type":"s","subtype":56,"str":" Recursive 8x8 Bayer threshold via bit interleaving ----\\n// Avoids GLSL `const float arr[64] = ...` constructor which some drivers\\n// botch; computes the same Bayer-8 matrix value purely from coordinates.\\nfloat bayer8Value(ivec2 p)\\n{\\n    int x = p.x & 7, y = p.y & 7;\\n    int v = 0;\\n    // Standard Bayer recursive interleave for size 8 = 2^3.\\n    v |= ((y >> 2) & 1);            v <<= 1;\\n    v |= ((x >> 2) & 1);            v <<= 1;\\n    v |= ((y >> 1) & 1);            v <<= 1;\\n    v |= ((x >> 1) & 1);            v <<= 1;\\n    v |= ( y       & 1);            v <<= 1;\\n    v |=   x       & 1;\\n    return float(v) / 64.0;\\n}\\n\\n// ---- F6 / E1 "}]
0x1801ca917=[{"size":88,"type":"s","subtype":56,"str":" Interleaved Gradient Noise (Jimenez 2014) ----\\n// Originally used a 3-tap hash average "}]
0x1801ca972=[{"size":329,"type":"s","subtype":56,"str":" visibly clumped, not blue-noise.\\n// E1 replaces it with Jorge Jimenez's IGN (\\"Next Generation Post Processing\\n// in Call of Duty: Advanced Warfare\\", SIGGRAPH 2014). IGN is a hand-tuned\\n// rational expression that produces a genuinely blue-noise-like spectrum\\n// (verified by FFT analysis in Jimenez's paper) at zero memory cost "}]
0x1801caabe=[{"size":293,"type":"s","subtype":56,"str":" no\\n// LUT upload required. Two extra orthogonal samples are averaged to lift\\n// it from ~32 levels of perceived quantisation to ~96 levels, which is\\n// indistinguishable from a real blue-noise texture for halftone screening\\n// purposes.\\n//\\n// Visible improvements vs. legacy 3-tap hash:\\n//   "}]
0x1801cabe6=[{"size":40,"type":"s","subtype":56,"str":" No more \\"clumping\\" of dots at midtones "}]
0x1801cac11=[{"size":34,"type":"s","subtype":56,"str":" IGN is uniform at all greys\\n//   "}]
0x1801cac36=[{"size":71,"type":"s","subtype":56,"str":" Spectral character matches real blue-noise (high frequency only)\\n//   "}]
0x1801cac80=[{"size":160,"type":"s","subtype":56,"str":" Animation-stable: deterministic on (x,y), so static keyframes stay\\n//     pixel-stable across re-renders.\\n//\\n// Future upgrade (E1+): Christoph Peters' CC0 256"}]
0x1801cad22=[{"size":953,"type":"s","subtype":56,"str":"256 R8 LUT uploaded as\\n// a real GL texture. Would give a marginal further quality lift; deferred\\n// because IGN already captures most of the benefit at zero infrastructure\\n// cost.\\nfloat ignNoise(vec2 pos)\\n{\\n    // Magic constants from Jimenez's paper. The \\"52.9829189\\" multiplier is\\n    // chosen so the fractional part of the dot-product wraps cleanly across\\n    // the full screen.\\n    return fract(52.9829189 * fract(0.06711056 * pos.x + 0.00583715 * pos.y));\\n}\\n\\nfloat pseudoBlueNoise(vec2 cellPos)\\n{\\n    // Two orthogonal IGN samples averaged. Single-tap IGN already has good\\n    // blue-noise spectrum; averaging two decorrelated taps tightens the\\n    // histogram around 0.5 (more uniform threshold distribution) while\\n    // keeping the high-frequency character.\\n    float a = ignNoise(cellPos);\\n    float b = ignNoise(cellPos.yx + vec2(11.71, 23.49));\\n    return clamp((a + b) * 0.5, 0.0, 1.0);\\n}\\n\\nvoid main()\\n{\\n    // Vector zoom (if active) "}]
0x1801cb0de=[{"size":489,"type":"s","subtype":56,"str":" re-bind the per-pass UV to the zoomed\\n    // source region so EVERY downstream computation (specks, grid sampling,\\n    // CMYK lookup, supersample offsets) is mathematically re-evaluated for\\n    // the zoom. magnifyUV is identity when the user isn't using Vector mode.\\n    vec2 mUV = magnifyUV(out_uvs);\\n\\n    float freq         = scale;\\n    float blurRadius   = softness * 0.01 * 0.003;\\n    int   noiseOctaves = 2 + quality;\\n    vec4  specks       = computeSpecks(mUV);\\n\\n    // ====== F6 "}]
0x1801cb2ca=[{"size":255,"type":"s","subtype":56,"str":" Alternative screen patterns (Bayer / Blue-noise / Line) ======\\n    // These bypass the Voronoi grid entirely and apply per-pixel\\n    // ordered/stochastic thresholding directly on the source CMYK values.\\n    // The result is RADICALLY different visually "}]
0x1801cb3cc=[{"size":44,"type":"s","subtype":56,"str":" sharp, grid-snapped,\\n    // or line-banded "}]
