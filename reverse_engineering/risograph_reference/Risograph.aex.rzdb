0x1801d59f6=[{"size":612,"type":"s","subtype":56,"str":" pow() per pixel for the default-state render.\\n    if (abs(inkCurve.x - 1.0) > 0.005 || abs(inkCurve.y - 1.0) > 0.005 ||\\n        abs(inkCurve.z - 1.0) > 0.005 || abs(inkCurve.w - 1.0) > 0.005) {\\n        cCov = pow(max(cCov, 0.0), 1.0 / max(inkCurve.x, 0.001));\\n        mCov = pow(max(mCov, 0.0), 1.0 / max(inkCurve.y, 0.001));\\n        yCov = pow(max(yCov, 0.0), 1.0 / max(inkCurve.z, 0.001));\\n        kCov = pow(max(kCov, 0.0), 1.0 / max(inkCurve.w, 0.001));\\n    }\\n\\n    // ====== 3a'. ROLLER MARKS (F5) ======\\n    // Shared 1D fbm modulator across all plates simulates uneven ink supply\\n    // as the drum rolls "}]
