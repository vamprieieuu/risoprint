0x1801d2823=[{"size":218,"type":"s","subtype":56,"str":" Use OUTPUT UV (out_uvs), NOT mUV (uv),\\n    // as the base. Pass 2 stores its halftone output indexed by output\\n    // pixel position, with content computed from mUV. Pass 3 must read\\n    // from the same output pixel "}]
