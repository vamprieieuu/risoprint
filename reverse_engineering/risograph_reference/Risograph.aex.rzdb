0x1801c6c51=[{"size":720,"type":"s","subtype":56,"str":" a plate slips on the drum, not just translates.\\nuniform float plateRotations[4]; // C,M,Y,K plate rotation (radians)\\nuniform float plateSkews[4];     // C,M,Y,K plate horizontal skew\\n\\n// F6 - Screen type uses the same RISO_SCREEN_* values as the shared\\n// CUDA/OpenCL/Metal kernel contract. Voronoi runs the existing AM\\n// Voronoi+union-of-circles pipeline; the other branches use per-pixel\\n// ordered/stochastic thresholding.\\nconst int RISO_SCREEN_VORONOI   = 1;\\nconst int RISO_SCREEN_BAYER     = 2;\\nconst int RISO_SCREEN_BLUENOISE = 3;\\nconst int RISO_SCREEN_LINE      = 4;\\nconst int RISO_SCREEN_STIPPLED  = 5;\\nconst int RISO_SCREEN_ATKINSON  = 6;\\nconst int RISO_SCREEN_FLOYD     = 7;\\n\\nuniform int screenType;\\n\\n// F15 "}]
