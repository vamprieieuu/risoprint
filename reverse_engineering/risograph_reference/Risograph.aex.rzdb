0x1801c5c33=[{"size":1179,"type":"s","subtype":56,"str":" Gamma,\\n    // which is visibly different whenever more than one slider is non-zero).\\n\\n    // --- 1. Gamma (Blender ShaderNodeGamma) ---\\n    rgb = clamp(rgb, 0.0, 1.0);\\n    rgb = pow(rgb, vec3(1.0 / gamma));\\n\\n    // --- 2. HSV shift (Blender ShaderNodeHueSaturationValue) ---\\n    // Hue slider is user-facing degrees; Blender's Hue input is 0..1 where\\n    // 0.5 is \\"no shift\\". We translate: hueShift_01 = hue / 360.\\n    if (abs(hue) > 0.001 || abs(saturation) > 0.001 || abs(value) > 0.001) {\\n        vec3 hsv = rgb2hsv(clamp(rgb, 0.0, 1.0));\\n        hsv.x = fract(hsv.x + hue / 360.0);\\n        hsv.y = clamp(hsv.y * (1.0 + saturation / 100.0), 0.0, 1.0);\\n        hsv.z = clamp(hsv.z * (1.0 + value      / 100.0), 0.0, 1.0);\\n        rgb = hsv2rgb(hsv);\\n    }\\n\\n    // --- 3. Brightness/Contrast (Blender ShaderNodeBrightContrast) ---\\n    //   a = 1 + contrast/100\\n    //   b = brightness/100 - 0.5 * (a - 1)\\n    //   rgb = a * rgb + b\\n    float a = 1.0 + contrast / 100.0;\\n    float b = brightness / 100.0 - 0.5 * (a - 1.0);\\n    rgb = rgb * a + b;\\n    rgb = clamp(rgb, 0.0, 1.0);\\n\\n    float lineMask = lineArtMaskFor(rgb, sampleUV);\\n\\n    if (colorMode == 1) {\\n        // ---- F1 "}]
0x1801c60d1=[{"size":332,"type":"s","subtype":56,"str":" Spot-Riso decomposition (greedy projection w/ residual) ----\\n        // For each spot ink i in order: density = projection of REMAINING\\n        // target absorption onto absorption direction a_i. After each ink\\n        // we subtract its contribution so subsequent inks only fight over\\n        // what's left. This is implicit GCR "}]
0x1801c6220=[{"size":1088,"type":"s","subtype":56,"str":" when plate 4 is black/dark,\\n        // it ends up handling the gray component the chromatic inks didn't\\n        // absorb, instead of double-printing on top of them.\\n        // a_i = (1,1,1) - inkColor (= absorption); target = (1,1,1) - rgb.\\n        // Inks beyond `spotPlateCount` get zero density so Pass 2 skips them.\\n        vec3 target = vec3(1.0) - rgb;\\n        vec3 a0 = vec3(1.0) - spotInk0;\\n        vec3 a1 = vec3(1.0) - spotInk1;\\n        vec3 a2 = vec3(1.0) - spotInk2;\\n        vec3 a3 = vec3(1.0) - spotInk3;\\n\\n        colourOut = (spotSeparationMode == 2)\\n            ? spotBalanced(target, a0, a1, a2, a3, spotPlateCount)\\n            : spotGreedy(target, a0, a1, a2, a3, spotPlateCount);\\n    } else {\\n        // --- Legacy CMYK path: raw CMY and normalized CMYK ---\\n        vec3 cmy = 1.0 - rgb;                  // raw CMY (Blender NTRGB to CMY)\\n        float k = min(min(cmy.r, cmy.g), cmy.b);\\n        vec3 cmyNorm = (k >= 1.0) ? vec3(0.0)\\n                                  : (cmy - k) / (1.0 - k);  // Blender NTRGB to CMYK\\n\\n        // Enrich Dark Tones: interpolate CMYK "}]
0x1801c6663=[{"size":256,"type":"s","subtype":98,"str":" CMY\\n        vec3 cmyOut = mix(cmyNorm, cmy, enrichDarkTones);\\n        float kOut  = k * (1.0 - enrichDarkTones);\\n\\n        colourOut = vec4(cmyOut, kOut);\\n    }\\n    colourOut = applyLineArt(colourOut, lineMask, lineArtPlate, colorMode, spotPlateCount);\\n}\\n"}]
0x1801c6770=[{"size":989,"type":"s","subtype":56,"str":"\\n#version 330\\nuniform sampler2D cmykTex;\\nuniform vec2 resolution;\\nuniform float scale;             // LPI (cells per vertical axis)\\nuniform int dotShape;            // 0=circle, 1=ellipse, 2=diamond, 3=square\\nuniform float angles[4];         // C,M,Y,K angles in radians\\nuniform float offsets[8];        // Cx,Cy, Mx,My, Yx,Yy, Kx,Ky  (in pixels)\\nuniform float softness;          // 0..100 (cell-center sampling blur radius)\\nuniform float distortion;        // 0..100\\nuniform float halftoneIntensity; // linear Voronoi-distance scale (default 1.1)\\nuniform float halftoneAspect;    // cell aspect ratio 0.5..2.0 (1.0 = square)\\nuniform float dotSmoothness;     // Voronoi smooth-min k (0..1; 0.3 default, 1.0 = Blender exact)\\nuniform float channelFactors[4]; // Per-channel CMYK factors\\nuniform float specksAmount;      // 0..1 (strength of per-channel speck erosion)\\nuniform float specksSize;        // 1..100 (noise scale, bigger = smaller specks)\\nuniform int quality;             // 0..3 "}]
