0x1801cda26=[{"size":469,"type":"s","subtype":56,"str":" fwidth-based derivative AA fails there\\n    // because distance-field derivatives go flat. Unrolled below to\\n    // avoid GLSL array-constructor syntax, which some drivers dislike.\\n    vec2 px = 1.0 / resolution;\\n\\n    vec4 result = vec4(0.0);\\n\\n    for (int ch = 0; ch < 4; ch++) {\\n        float angle  = angles[ch];\\n        vec2  offset = vec2(offsets[ch * 2], offsets[ch * 2 + 1]);\\n        float factor = channelFactors[ch];\\n\\n        // Forward transform: (zoomed) UV "}]
