0x1801d2e2a=[{"size":83,"type":"s","subtype":56,"str":" back to coverage space\\n    // At jitter == 0 every impression samples the same UV "}]
0x1801d2e80=[{"size":530,"type":"s","subtype":56,"str":" coverage\\n    // unchanged (idempotent). At jitter > 0 each impression's pixel-space\\n    // offset is hashed deterministically by impression index so the\\n    // result is consistent across animation frames.\\n    vec4 dots;\\n    if (impressions <= 1 || impressionJitter < 0.001) {\\n        dots = texture(halftoneTex, halftoneUV);\\n    } else {\\n        // Accumulate transmittance; (1 - cov) is \\"fraction of light that\\n        // passed through this impression's ink\\".\\n        vec4 trans = vec4(1.0);\\n        // Jitter scale in pixels "}]
0x1801d3095=[{"size":21,"type":"s","subtype":56,"str":" slider 0..1 maps to "}]
0x1801d30ac=[{"size":1064,"type":"s","subtype":56,"str":"2 px max, which\\n        // is realistic for drum-slip on a well-maintained machine.\\n        float jitterPx = impressionJitter * 2.0;\\n        for (int i = 0; i < 3; i++) {\\n            if (i >= impressions) break;\\n            // Per-impression deterministic offset. Seed by index so the\\n            // pattern is consistent across frames at static keyframes.\\n            // Hash on (i+13.7, i*7.3+5.1) decorrelates X from Y. First\\n            // impression (i=0) has zero offset so it matches single-press.\\n            float fi = float(i);\\n            vec2 jitterUV;\\n            if (i == 0) {\\n                jitterUV = vec2(0.0);\\n            } else {\\n                vec2 h = vec2(hash(vec2(fi * 13.7 + 5.1, 7.3)),\\n                              hash(vec2(fi * 17.9 + 2.1, 11.5)));\\n                jitterUV = (h - 0.5) * 2.0 * jitterPx / resolution;\\n            }\\n            vec4 d = texture(halftoneTex, halftoneUV + jitterUV);\\n            trans *= (vec4(1.0) - d);\\n        }\\n        dots = clamp(vec4(1.0) - trans, vec4(0.0), vec4(1.0));\\n    }\\n\\n\\n    // ====== F3 "}]
