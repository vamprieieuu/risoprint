0x1801d5d07=[{"size":409,"type":"s","subtype":56,"str":" horizontal bands.\\n    if (rollerAmount > 0.001) {\\n        float ca = cos(rollerAngle);\\n        float sa = sin(rollerAngle);\\n        // Project UV onto the band-perpendicular axis, then sample 1D-ish\\n        // fbm (Y component fixed at 0 collapses to a 1D pattern).\\n        float bandCoord = uv.y * ca - uv.x * sa;\\n        float roller = fbm(vec2(bandCoord * rollerFreq, 0.0), 3);\\n        // Map [0,1] noise "}]
0x1801d5ea3=[{"size":401,"type":"s","subtype":56,"str":" multiplier centred at 1.0; amount controls band\\n        // depth. At amount=1 modulator ranges 0.5..1.5.\\n        float modulator = 1.0 + (roller - 0.5) * rollerAmount;\\n        cCov = clamp(cCov * modulator, 0.0, 1.0);\\n        mCov = clamp(mCov * modulator, 0.0, 1.0);\\n        yCov = clamp(yCov * modulator, 0.0, 1.0);\\n        kCov = clamp(kCov * modulator, 0.0, 1.0);\\n    }\\n\\n\\n    // ====== S5.C+S5.D "}]
