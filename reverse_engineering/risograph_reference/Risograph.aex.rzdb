isograph\\\\\\\\core\\\\\\\\kernels\\\\\\\\../RisographProofCoords.h\\"\\n\\n\\n\\n\\n\\n\\n#line 8 \\"C:\\\\\\\\AE\\\\\\\\Examples\\\\\\\\Effect\\\\\\\\Risograph\\\\\\\\core\\\\\\\\kernels\\\\\\\\../RisographProofCoords.h\\"\\n\\n#line 10 \\"C:\\\\\\\\AE\\\\\\\\Examples\\\\\\\\Effect\\\\\\\\Risograph\\\\\\\\core\\\\\\\\kernels\\\\\\\\../RisographProofCoords.h\\"\\n\\ninline float\\nRisoApplyProofCrumpleCoordinate(float baseCoordinate,\\n                                float crumpleHeight,\\n                                float paperCrumpling)\\n{\\n    return baseCoordinate + (crumpleHeight - 0.5f) * paperCrumpling * 0.02f;\\n}\\n\\n\\n\\n#line 22 \\"C:\\\\\\\\AE\\\\\\\\Examples\\\\\\\\Effect\\\\\\\\Risograph\\\\\\\\core\\\\\\\\kernels\\\\\\\\../RisographProofCoords.h\\"\\n#line 50 \\"C:\\\\\\\\AE\\\\\\\\Examples\\\\\\\\Effect\\\\\\\\Risograph\\\\\\\\core\\\\\\\\kernels\\\\\\\\Risograph_Kernel.cu\\"\\n\\n\\n\\n\\n\\n\\n\\n\\n    \\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n#line 71 \\"C:\\\\\\\\AE\\\\\\\\Examples\\\\\\\\Effect\\\\\\\\Risograph\\\\\\\\core\\\\\\\\kernels\\\\\\\\Risograph_Kernel.cu\\"\\n#line 72 \\"C:\\\\\\\\AE\\\\\\\\Examples\\\\\\\\Effect\\\\\\\\Risograph\\\\\\\\core\\\\\\\\kernels\\\\\\\\Risograph_Kernel.cu\\"\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n    \\n        \\n        \\n        \\n        \\n        \\n        \\n        \\n        \\n        \\n    #line 104 \\"C:\\\\\\\\AE\\\\\\\\Examples\\\\\\\\Effect\\\\\\\\Risograph\\\\\\\\core\\\\\\\\kernels\\\\\\\\Risograph_Kernel.cu\\"\\n#line 105 \\"C:\\\\\\\\AE\\\\\\\\Examples\\\\\\\\Effect\\\\\\\\Risograph\\\\\\\\core"}]
0x1801e859a=[{"size":2025,"type":"s","subtype":98,"str":"\\\\kernels\\\\\\\\Risograph_Kernel.cu\\"\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n#line 119 \\"C:\\\\\\\\AE\\\\\\\\Examples\\\\\\\\Effect\\\\\\\\Risograph\\\\\\\\core\\\\\\\\kernels\\\\\\\\Risograph_Kernel.cu\\"\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\ninline float2 RisoMagnifyUV(float2 uv, float magZoom, float2 magCenter)\\n{\\n    if (magZoom > 1.001f) {\\n        float2 zoomed;\\n        zoomed.x = magCenter.x + (uv.x - 0.5f) / magZoom;\\n        zoomed.y = magCenter.y + (uv.y - 0.5f) / magZoom;\\n        zoomed.x = fmax(0.0f, fmin(1.0f, zoomed.x));\\n        zoomed.y = fmax(0.0f, fmin(1.0f, zoomed.y));\\n        return zoomed;\\n    }\\n    return uv;\\n}\\n\\ninline float2 RisoFullToWindowUV(float2 uv, float fullW, float fullH,\\n                                 int originX, int originY,\\n                                 unsigned int windowW, unsigned int windowH)\\n{\\n    float2 windowUV;\\n    windowUV.x = (uv.x * fullW - (float)originX) / (float)windowW;\\n    windowUV.y = (uv.y * fullH - (float)originY) / (float)windowH;\\n    return windowUV;\\n}\\n\\n\\n\\n\\ninline float3 RisoRGBToHSV(float3 c)\\n{\\n    \\n\\n\\n\\n\\n\\n\\n\\n    const float K_x =  0.0f;\\n    const float K_y = -1.0f / 3.0f;\\n    const float K_z =  2.0f / 3.0f;\\n    const float K_w = -1.0f;\\n\\n    \\n\\n\\n    float4 p;\\n    float step_bg = (c.y >= c.z) ? 1.0f : 0.0f;\\n    p.x = (1.0f - step_bg) * c.z + step_bg * c.y;\\n    p.y = (1.0f - step_bg) * c.y + step_bg * c.z;\\n    p.z = (1.0f - step_bg) * K_w + step_bg * K_x;\\n    p.w = (1.0f - step_bg) * K_z + step_bg * K_y;\\n\\n    float step_xr = (c.x >= p.x) ? 1.0f : 0.0f;\\n    float4 q;\\n    q.x = (1.0f - step_xr) * p.x + step_xr * c.x;\\n    \\n\\n\\n\\n\\n    q.y = p.y;\\n    q.z = (1.0f - step_xr) * p.w + step_xr * p.z;\\n    q.w = (1.0f - step_xr) * c.x + step_xr * p.x;\\n\\n    float d = q.x - fmin(q.w, q.y);\\n    const float eps = 1.0e-10f;\\n    float3 hsv;\\n    hsv.x = fabs(q.z + (q.w - q.y) / (6.0f * d + eps));\\n    hsv.y = d / (q.x + eps);\\n    hsv.z = q.x;\\n    return hsv;\\n}\\n\\ninline float3 RisoHSVToRGB(float3 c)\\n{\\n    \\n\\n\\n\\n\\n    float fx = c.x + 1.0f;       \\n    float fy = c.x + 2.0f/3.0f;  \\n    float fz = c.x + 1.0f/3.0f;  \\n\\n    \\n    fx = fx - floor(fx);\\n    fy = fy - floor(fy);"}]
0x1801e8d83=[{"size":2047,"type":"s","subtype":98,"str":"    fz = fz - floor(fz);\\n\\n    fx = fabs(fx * 6.0f - 3.0f);\\n    fy = fabs(fy * 6.0f - 3.0f);\\n    fz = fabs(fz * 6.0f - 3.0f);\\n\\n    \\n    fx = fmax(0.0f, fmin(1.0f, fx - 1.0f));\\n    fy = fmax(0.0f, fmin(1.0f, fy - 1.0f));\\n    fz = fmax(0.0f, fmin(1.0f, fz - 1.0f));\\n\\n    \\n    float3 rgb;\\n    rgb.x = c.z * (1.0f + (fx - 1.0f) * c.y);\\n    rgb.y = c.z * (1.0f + (fy - 1.0f) * c.y);\\n    rgb.z = c.z * (1.0f + (fz - 1.0f) * c.y);\\n    return rgb;\\n}\\n\\n\\ninline float3 RisoClampF3(float3 c)\\n{\\n    float3 r;\\n    r.x = fmax(0.0f, fmin(1.0f, c.x));\\n    r.y = fmax(0.0f, fmin(1.0f, c.y));\\n    r.z = fmax(0.0f, fmin(1.0f, c.z));\\n    return r;\\n}\\n\\n\\ninline float RisoMix(float a, float b, float t) { return a + (b - a) * t; }\\n\\ninline float3 RisoHostPixelToRgb(float4 p, int hostPixelLayout)\\n{\\n    float3 rgb;\\n    if (hostPixelLayout == 2) {\\n        rgb.x = p.x; rgb.y = p.y; rgb.z = p.z;\\n    } else {\\n        rgb.x = p.z; rgb.y = p.y; rgb.z = p.x;\\n    }\\n    return rgb;\\n}\\n\\ninline float3 RisoUnpremulHostPixelToRgb(float4 p, int hostPixelLayout)\\n{\\n    float alpha = p.w;\\n    float3 rgb;\\n    if (alpha > 0.0f) {\\n        float invAlpha = 1.0f / alpha;\\n        rgb = RisoHostPixelToRgb(p, hostPixelLayout);\\n        rgb.x *= invAlpha;\\n        rgb.y *= invAlpha;\\n        rgb.z *= invAlpha;\\n    } else {\\n        rgb.x = 0.0f; rgb.y = 0.0f; rgb.z = 0.0f;\\n    }\\n    return rgb;\\n}\\n\\ninline float4 RisoPremulRgbAlphaToHostPixel(float3 premulRgb, float alpha, int hostPixelLayout)\\n{\\n    float4 p;\\n    if (hostPixelLayout == 2) {\\n        p.x = premulRgb.x;\\n        p.y = premulRgb.y;\\n        p.z = premulRgb.z;\\n    } else {\\n        p.x = premulRgb.z;\\n        p.y = premulRgb.y;\\n        p.z = premulRgb.x;\\n    }\\n    p.w = alpha;\\n    return p;\\n}\\n\\ninline float4 RisoStraightRgbAlphaToHostPixel(float3 rgb, float alpha, int hostPixelLayout)\\n{\\n    float3 premul;\\n    premul.x = rgb.x * alpha;\\n    premul.y = rgb.y * alpha;\\n    premul.z = rgb.z * alpha;\\n    return RisoPremulRgbAlphaToHostPixel(premul, alpha, hostPixelLayout);\\n}\\n\\ninline float4 RisoApplyTrialWatermarkHost(float4 pixel, "}]
0x1801e9582=[{"size":2041,"type":"s","subtype":98,"str":"uint2 xy,\\n                                          unsigned int width, unsigned int height,\\n                                          int isLicensed, int hostPixelLayout)\\n{\\n    if (isLicensed != 0 || width == 0 || height == 0) {\\n        return pixel;\\n    }\\n    float w = (float)width;\\n    float h = (float)height;\\n    float x01 = (width > 1) ? (float)xy.x / (w - 1.0f) : 0.0f;\\n    float diagA = x01 * (h - 1.0f);\\n    float diagB = (1.0f - x01) * (h - 1.0f);\\n    float dist = fmin(fabs((float)xy.y - diagA), fabs((float)xy.y - diagB));\\n    float minDim = fmin(w, h);\\n    float inner = fmax(1.0f, minDim * 0.004f);\\n    float outer = fmax(inner + 1.0f, minDim * 0.012f);\\n    if (dist >= outer) {\\n        return pixel;\\n    }\\n\\n    float s = (dist <= inner)\\n        ? 0.58f\\n        : 0.58f * (1.0f - ((dist - inner) / (outer - inner)));\\n    float alpha = fmax(pixel.w, 0.72f * s);\\n    float3 rgb = RisoHostPixelToRgb(pixel, hostPixelLayout);\\n    rgb.x = RisoMix(rgb.x, alpha, s);\\n    rgb.y = RisoMix(rgb.y, 0.0f, s);\\n    rgb.z = RisoMix(rgb.z, alpha * 0.18f, s);\\n    return RisoPremulRgbAlphaToHostPixel(rgb, alpha, hostPixelLayout);\\n}\\ninline float2 RisoMix2(float2 a, float2 b, float t)\\n{\\n    float2 r;\\n    r.x = a.x + (b.x - a.x) * t;\\n    r.y = a.y + (b.y - a.y) * t;\\n    return r;\\n}\\n\\n\\ninline float RisoFract(float x) { return x - floor(x); }\\ninline float2 RisoFract2(float2 v)\\n{\\n    float2 r;\\n    r.x = v.x - floor(v.x);\\n    r.y = v.y - floor(v.y);\\n    return r;\\n}\\n\\n\\ninline float RisoStep(float edge, float x) { return (x >= edge) ? 1.0f : 0.0f; }\\n\\n\\ninline float RisoSmoothstep(float e0, float e1, float x)\\n{\\n    float t = (x - e0) / fmax(e1 - e0, 1e-9f);\\n    t = fmax(0.0f, fmin(1.0f, t));\\n    return t * t * (3.0f - 2.0f * t);\\n}\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\ninline float RisoSrgbToLinearF(float c)\\n{\\n    float clamped = fmax(0.0f, fmin(1.0f, c));\\n    if (clamped < 0.04045f) {\\n        return clamped / 12.92f;\\n    }\\n    return pow((clamped + 0.055f) / 1.055f, 2.4f);\\n}\\n\\ninline float RisoLinearToSrgbF(float c)\\n{\\n    float clamped = fmax(0.0f, fmin(1.0f, c));"}]
0x1801e9d7b=[{"size":2020,"type":"s","subtype":98,"str":"    if (clamped < 0.0031308f) {\\n        return clamped * 12.92f;\\n    }\\n    return 1.055f * pow(clamped, 1.0f / 2.4f) - 0.055f;\\n}\\n\\ninline float3 RisoSrgbToLinear3(float3 c)\\n{\\n    float3 r;\\n    r.x = RisoSrgbToLinearF(c.x);\\n    r.y = RisoSrgbToLinearF(c.y);\\n    r.z = RisoSrgbToLinearF(c.z);\\n    return r;\\n}\\n\\ninline float3 RisoLinearToSrgb3(float3 c)\\n{\\n    float3 r;\\n    r.x = RisoLinearToSrgbF(c.x);\\n    r.y = RisoLinearToSrgbF(c.y);\\n    r.z = RisoLinearToSrgbF(c.z);\\n    return r;\\n}\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\ninline float RisoHash(float2 p)\\n{\\n    float dotResult = p.x * 127.1f + p.y * 311.7f;\\n    return RisoFract(sin(dotResult) * 43758.5453123f);\\n}\\n\\ninline float2 RisoHash2(float2 p)\\n{\\n    float2 r;\\n    r.x = sin(p.x * 127.1f + p.y * 311.7f) * 43758.5453f;\\n    r.y = sin(p.x * 269.5f + p.y * 183.3f) * 43758.5453f;\\n    return RisoFract2(r);\\n}\\n\\ninline float RisoHash3(float3 p)\\n{\\n    float dotResult = p.x * 127.1f + p.y * 311.7f + p.z * 74.7f;\\n    return RisoFract(sin(dotResult) * 43758.5453123f);\\n}\\n\\ninline float RisoNoise2D(float2 p)\\n{\\n    float2 i;\\n    i.x = floor(p.x);\\n    i.y = floor(p.y);\\n    float2 f;\\n    f.x = p.x - i.x;\\n    f.y = p.y - i.y;\\n    float2 u;\\n    u.x = f.x * f.x * (3.0f - 2.0f * f.x);\\n    u.y = f.y * f.y * (3.0f - 2.0f * f.y);\\n\\n    float a = RisoHash(i);\\n    float2 ix = i; ix.x += 1.0f;\\n    float b = RisoHash(ix);\\n    float2 iy = i; iy.y += 1.0f;\\n    float c = RisoHash(iy);\\n    float2 ixy = i; ixy.x += 1.0f; ixy.y += 1.0f;\\n    float d = RisoHash(ixy);\\n\\n    return RisoMix(RisoMix(a, b, u.x), RisoMix(c, d, u.x), u.y);\\n}\\n\\n\\n\\n\\ninline float RisoNoise3D(float3 p)\\n{\\n    float3 i;\\n    i.x = floor(p.x); i.y = floor(p.y); i.z = floor(p.z);\\n    float3 f;\\n    f.x = p.x - i.x; f.y = p.y - i.y; f.z = p.z - i.z;\\n    float3 u;\\n    u.x = f.x * f.x * (3.0f - 2.0f * f.x);\\n    u.y = f.y * f.y * (3.0f - 2.0f * f.y);\\n    u.z = f.z * f.z * (3.0f - 2.0f * f.z);\\n\\n    \\n    float3 c000 = i;\\n    float3 c100 = i; c100.x += 1.0f;\\n    float3 c010 = i; c010.y += 1.0f;\\n    float3 c110 = i; c110.x += 1.0f; c110.y += 1.0f;"}]
0x1801ea55f=[{"size":2018,"type":"s","subtype":98,"str":"    float3 c001 = i; c001.z += 1.0f;\\n    float3 c101 = i; c101.x += 1.0f; c101.z += 1.0f;\\n    float3 c011 = i; c011.y += 1.0f; c011.z += 1.0f;\\n    float3 c111 = i; c111.x += 1.0f; c111.y += 1.0f; c111.z += 1.0f;\\n\\n    float n000 = RisoHash3(c000), n100 = RisoHash3(c100);\\n    float n010 = RisoHash3(c010), n110 = RisoHash3(c110);\\n    float n001 = RisoHash3(c001), n101 = RisoHash3(c101);\\n    float n011 = RisoHash3(c011), n111 = RisoHash3(c111);\\n\\n    float nx00 = RisoMix(n000, n100, u.x);\\n    float nx10 = RisoMix(n010, n110, u.x);\\n    float nx01 = RisoMix(n001, n101, u.x);\\n    float nx11 = RisoMix(n011, n111, u.x);\\n    float nxy0 = RisoMix(nx00, nx10, u.y);\\n    float nxy1 = RisoMix(nx01, nx11, u.y);\\n    return RisoMix(nxy0, nxy1, u.z);\\n}\\n\\ninline float RisoFBM(float2 p, int octaves)\\n{\\n    float value = 0.0f;\\n    float amp = 0.5f;\\n    float2 q = p;\\n    for (int i = 0; i < octaves; i++) {\\n        value += amp * RisoNoise2D(q);\\n        q.x *= 2.0f; q.y *= 2.0f;\\n        amp *= 0.5f;\\n    }\\n    return value;\\n}\\n\\ninline float RisoFBM3D(float3 p, int octaves)\\n{\\n    float value = 0.0f;\\n    float amp = 0.5f;\\n    float3 q = p;\\n    for (int i = 0; i < octaves; i++) {\\n        value += amp * RisoNoise3D(q);\\n        q.x *= 2.0f; q.y *= 2.0f; q.z *= 2.0f;\\n        amp *= 0.5f;\\n    }\\n    return value;\\n}\\n\\n\\n\\n\\n\\ninline float2 RisoRotate2D(float2 p, float angle)\\n{\\n    float cs = cos(angle);\\n    float sn = sin(angle);\\n    float2 r;\\n    r.x = p.x * cs - p.y * sn;\\n    r.y = p.x * sn + p.y * cs;\\n    return r;\\n}\\n\\n\\n\\ninline float RisoCellDist(float2 d, int shape)\\n{\\n    if (shape == 2) {\\n        float dx = d.x;\\n        float dy = d.y * 1.5f;\\n        return sqrt(dx*dx + dy*dy);\\n    } else if (shape == 3) {\\n        return fabs(d.x) + fabs(d.y);\\n    } else if (shape == 4) {\\n        return fmax(fabs(d.x), fabs(d.y));\\n    }\\n    \\n    return sqrt(d.x * d.x + d.y * d.y);\\n}\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\ninline float RisoApplyThreshold(float dist, float channelVal, float factor,\\n                                 float intensity, float smoothness)"}]
0x1801ead41=[{"size":2041,"type":"s","subtype":98,"str":"{\\n    float adjusted = fmax(0.0f, fmin(1.0f, channelVal * factor));\\n\\n    \\n\\n    float sat  = RisoSmoothstep(0.7f, 1.0f, adjusted);\\n    float effI = intensity * RisoMix(1.0f, 0.55f, sat);\\n\\n    float len      = dist * effI * 1.7320508f;       \\n    float r        = fmax(1.0f - len, 0.0f);\\n    float gradSq   = r * r;                          \\n    float inverted = 1.0f - gradSq;\\n\\n    \\n\\n\\n    float swidth = smoothness * smoothness * 0.4f;\\n    float th = (swidth < 1e-4f)\\n        ? RisoStep(inverted, adjusted)\\n        : RisoSmoothstep(inverted - swidth, inverted + swidth, adjusted);\\n\\n    \\n\\n\\n\\n\\n\\n\\n\\n\\n    float saturationFloor = RisoSmoothstep(0.92f, 0.99f, adjusted);\\n    return RisoMix(th, 1.0f, saturationFloor);\\n}\\n\\n\\n\\n\\n\\n\\n\\ninline void RisoVoronoiCell(float2 p, int shape, float randomness,\\n                             float* outDist,\\n                             float2* outCenter)\\n{\\n    float2 ip;\\n    ip.x = floor(p.x);\\n    ip.y = floor(p.y);\\n\\n    float hardMin = 10.0f;\\n    float2 bestCenter; bestCenter.x = 0.0f; bestCenter.y = 0.0f;\\n\\n    for (int j = -1; j <= 1; j++) {\\n        for (int i = -1; i <= 1; i++) {\\n            float2 neighbor;\\n            neighbor.x = ip.x + (float)i;\\n            neighbor.y = ip.y + (float)j;\\n            float2 rndOffset = RisoHash2(neighbor);\\n            float2 center;\\n            center.x = neighbor.x + RisoMix(0.5f, rndOffset.x, randomness);\\n            center.y = neighbor.y + RisoMix(0.5f, rndOffset.y, randomness);\\n            float2 d;\\n            d.x = p.x - center.x;\\n            d.y = p.y - center.y;\\n            float dist = RisoCellDist(d, shape);\\n            if (dist < hardMin) {\\n                hardMin    = dist;\\n                bestCenter = center;\\n            }\\n        }\\n    }\\n    (*outDist) = hardMin;\\n    (*outCenter) = bestCenter;\\n}\\n\\n\\n\\n\\n\\ninline float RisoUnionDotInk(float2 gridPos, int shape, float randomness,\\n                              float channelVal, float factor,\\n                              float intensity, float smoothness)\\n{\\n    float2 ip;\\n    ip.x = floor(gridPos.x);"}]
0x1801eb53a=[{"size":2040,"type":"s","subtype":98,"str":"    ip.y = floor(gridPos.y);\\n    float ink = 0.0f;\\n\\n    for (int j = -1; j <= 1; j++) {\\n        for (int i = -1; i <= 1; i++) {\\n            float2 neighbor;\\n            neighbor.x = ip.x + (float)i;\\n            neighbor.y = ip.y + (float)j;\\n            float2 rndOffset = RisoHash2(neighbor);\\n            float2 center;\\n            center.x = neighbor.x + RisoMix(0.5f, rndOffset.x, randomness);\\n            center.y = neighbor.y + RisoMix(0.5f, rndOffset.y, randomness);\\n            float2 d;\\n            d.x = gridPos.x - center.x;\\n            d.y = gridPos.y - center.y;\\n            float dist = RisoCellDist(d, shape);\\n            float v = RisoApplyThreshold(dist, channelVal, factor,\\n                                          intensity, smoothness);\\n            if (v > ink) ink = v;\\n        }\\n    }\\n    return ink;\\n}\\n\\n\\n\\ninline float2 RisoApplyPlateXform(float2 uv, float plateRotRad, float plateSkew,\\n                                   float resW, float resH)\\n{\\n    if (plateRotRad == 0.0f && plateSkew == 0.0f) return uv;\\n    float2 q;\\n    q.x = (uv.x - 0.5f) * resW;\\n    q.y = (uv.y - 0.5f) * resH;\\n    q.x += q.y * plateSkew;\\n    float c = cos(plateRotRad), s = sin(plateRotRad);\\n    float qx = q.x * c - q.y * s;\\n    float qy = q.x * s + q.y * c;\\n    float2 r;\\n    r.x = qx / resW + 0.5f;\\n    r.y = qy / resH + 0.5f;\\n    return r;\\n}\\n\\n\\n\\n\\ninline float2 RisoApplyPlateXformInverse(float2 uv, float plateRotRad, float plateSkew,\\n                                          float resW, float resH)\\n{\\n    if (plateRotRad == 0.0f && plateSkew == 0.0f) return uv;\\n    float2 q;\\n    q.x = (uv.x - 0.5f) * resW;\\n    q.y = (uv.y - 0.5f) * resH;\\n    float c = cos(-plateRotRad), s = sin(-plateRotRad);\\n    float qx = q.x * c - q.y * s;\\n    float qy = q.x * s + q.y * c;\\n    qx -= qy * plateSkew;\\n    float2 r;\\n    r.x = qx / resW + 0.5f;\\n    r.y = qy / resH + 0.5f;\\n    return r;\\n}\\n\\n\\n\\n\\ninline float2 RisoComputeGridPos(float2 uv, float plateRotRad, float plateSkew,\\n                                  float angle, float offsetX, float offsetY,"}]
0x1801ebd32=[{"size":2025,"type":"s","subtype":98,"str":"                                  float freq, float halftoneAspect,\\n                                  float resW, float resH)\\n{\\n    float2 puv = RisoApplyPlateXform(uv, plateRotRad, plateSkew, resW, resH);\\n    float2 uvOff;\\n    uvOff.x = puv.x + offsetX / resW;\\n    uvOff.y = puv.y + offsetY / resH;\\n    float2 pixelPos;\\n    pixelPos.x = uvOff.x * resW;\\n    pixelPos.y = uvOff.y * resH;\\n    float2 rotPixel = RisoRotate2D(pixelPos, angle);\\n    float2 g;\\n    g.x = rotPixel.x * freq / resH;\\n    g.y = rotPixel.y * freq / resH;\\n    float aspSafe = fmax(halftoneAspect, 0.01f);\\n    g.y *= aspSafe;\\n    return g;\\n}\\n\\n\\n\\n\\ninline float2 RisoGridToUV(float2 gridCenter, float plateRotRad, float plateSkew,\\n                            float angle, float offsetX, float offsetY,\\n                            float freq, float halftoneAspect,\\n                            float resW, float resH)\\n{\\n    float aspSafe = fmax(halftoneAspect, 0.01f);\\n    float2 gUnaspect;\\n    gUnaspect.x = gridCenter.x;\\n    gUnaspect.y = gridCenter.y / aspSafe;\\n    float2 rotPixel;\\n    rotPixel.x = gUnaspect.x * resH / freq;\\n    rotPixel.y = gUnaspect.y * resH / freq;\\n    float2 pixelPos = RisoRotate2D(rotPixel, -angle);\\n    float2 puv;\\n    puv.x = pixelPos.x / resW - offsetX / resW;\\n    puv.y = pixelPos.y / resH - offsetY / resH;\\n    return RisoApplyPlateXformInverse(puv, plateRotRad, plateSkew, resW, resH);\\n}\\n\\n\\n\\n\\ninline float4 RisoComputeSpecks(float2 uv, float specksAmount, float specksSize,\\n                                 float drumAnimW)\\n{\\n    float4 r;\\n    if (specksAmount <= 0.0f) {\\n        r.x = 0.0f; r.y = 0.0f; r.z = 0.0f; r.w = 0.0f;\\n        return r;\\n    }\\n    float noiseScale = specksSize * 0.2f;\\n    float2 nuv;\\n    nuv.x = uv.x * noiseScale;\\n    nuv.y = uv.y * noiseScale;\\n\\n    float3 pK; pK.x = nuv.x;          pK.y = nuv.y;        pK.z = 14.6f + drumAnimW;\\n    float3 pC; pC.x = nuv.x + 17.3f;  pC.y = nuv.y + 5.7f; pC.z = 17.1f + drumAnimW;\\n    float3 pM; pM.x = nuv.x + 31.1f;  pM.y = nuv.y + 43.2f;pM.z = 29.4f + drumAnimW;"}]
0x1801ec51b=[{"size":2047,"type":"s","subtype":98,"str":"    float3 pY; pY.x = nuv.x + 71.9f;  pY.y = nuv.y + 23.8f;pY.z = 41.8f + drumAnimW;\\n\\n    float nK = RisoFBM3D(pK, 2);\\n    float nC = RisoFBM3D(pC, 2);\\n    float nM = RisoFBM3D(pM, 2);\\n    float nY = RisoFBM3D(pY, 2);\\n\\n    float fromMin = 1.0f - specksAmount * 0.4f;\\n    float fromMax = fromMin + 0.09f;\\n    float inv = 1.0f / fmax(fromMax - fromMin, 1e-4f);\\n\\n    float tC = fmax(0.0f, fmin(1.0f, (nC - fromMin) * inv));\\n    float tM = fmax(0.0f, fmin(1.0f, (nM - fromMin) * inv));\\n    float tY = fmax(0.0f, fmin(1.0f, (nY - fromMin) * inv));\\n    float tK = fmax(0.0f, fmin(1.0f, (nK - fromMin) * inv));\\n    \\n    tC = tC * tC * (3.0f - 2.0f * tC);\\n    tM = tM * tM * (3.0f - 2.0f * tM);\\n    tY = tY * tY * (3.0f - 2.0f * tY);\\n    tK = tK * tK * (3.0f - 2.0f * tK);\\n    \\n    r.x = fmax(0.0f, fmin(1.0f, pow(tC, 0.36f) * 2.0f));\\n    r.y = fmax(0.0f, fmin(1.0f, pow(tM, 0.36f) * 2.0f));\\n    r.z = fmax(0.0f, fmin(1.0f, pow(tY, 0.36f) * 2.0f));\\n    r.w = fmax(0.0f, fmin(1.0f, pow(tK, 0.36f) * 2.0f));\\n    return r;\\n}\\n\\n\\n\\n\\ninline float4 RisoSampleCMYKBlurred(__global const float4* cmykTex,\\n                                     float2 centerUV, float blurRadius,\\n                                     int srcPitch, int width, int height,\\n                                     int basePixel, int is16f)\\n{\\n    \\n    \\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n    if (blurRadius > 0.0001f) {\\n        float4 a, b, c, d;\\n        do { float fx = (centerUV.x + blurRadius) * (float)width - 0.5f; float fy = (centerUV.y) * (float)height - 0.5f; int x0 = (int)floor(fx); int y0 = (int)floor(fy); float tx = fx - (float)x0; float ty = fy - (float)y0; int x1 = x0 + 1; int y1 = y0 + 1; if (x0 < 0) x0 = 0; if (x0 >= width) x0 = width - 1; if (x1 < 0) x1 = 0; if (x1 >= width) x1 = width - 1; if (y0 < 0) y0 = 0; if (y0 >= height) y0 = height - 1; if (y1 < 0) y1 = 0; if (y1 >= height) y1 = height - 1; int row0 = basePixel + y0 * srcPitch; int row1 = basePixel + y1 * srcPitch; float4 s00 = ReadFloat4(cmykTex, row0 + x0, !!is16f); float4 s10 = ReadFloat4(cmykTex, row0 + x1, !!is1"}]
