0x1801d0453=[{"size":324,"type":"s","subtype":56,"str":" Drum-stencil ink-bleed halo. The blurred halftone texture is\\n// bound when haloRadius > 0; otherwise we skip the lookup entirely.\\nuniform sampler2D halftoneBlurTex;  // bound only when haloRadius > 0\\nuniform float haloRadius;           // px (0 = halo off)\\nuniform float haloIntensity;        // 0..1 (0 = halo off)\\n\\n// F9 "}]
0x1801d059a=[{"size":309,"type":"s","subtype":56,"str":" Ghost / second-impression overlay. Samples halftoneTex at\\n// (uv + offset/resolution) and merges via max(). Simulates Riso drum\\n// re-pickup or a second impression smear.\\nuniform float ghostOffsetX;         // pixels (-30..+30)\\nuniform float ghostOffsetY;\\nuniform float ghostOpacity;         // 0..1\\n\\n// F11 "}]
0x1801d06d2=[{"size":274,"type":"s","subtype":56,"str":" Ink reticulation: cracked oil-based-ink overlay where coverage\\n// is high. Worley-cells distance gives a fine \\"thread\\" pattern that\\n// reads as ink crackle.\\nuniform float reticulation;         // 0..1\\nuniform float reticulationScale;    // 10..200 (Worley density)\\n\\n// F10 "}]
0x1801d07e7=[{"size":134,"type":"s","subtype":56,"str":" Paper show-through: blurred mirrored input visible through\\n// translucent paper.\\nuniform float showThrough;          // 0..1\\n\\n// F15 "}]
0x1801d0870=[{"size":75,"type":"s","subtype":56,"str":" Drum animation W slice shared with Pass 2.\\nuniform float drumAnimW;\\n\\n// F-"}]
0x1801d08c1=[{"size":248,"type":"s","subtype":56,"str":" Plate inspect mask (1 = visible, 0 = muted) per plate. Default\\n// (1,1,1,1) shows everything; setting to e.g. (1,0,0,0) shows only Plate\\n// 1's halftone, ideal for studying a single screen with the Magnifier.\\nuniform vec4 plateMask;\\n\\n// Magnifier "}]
0x1801d09bc=[{"size":1006,"type":"s","subtype":56,"str":" Vector zoom (pre-pipeline UV transform shared with Pass 1/2).\\n// When active (magZoom > 1) the per-pass `uv` rebases to the zoomed source\\n// region so every paper-noise sample, halftone lookup, ink mix, lighting\\n// normal, reticulation Worley etc. re-renders at the new resolution. Halo\\n// radius is scaled separately on the C++ side (in SmartRender) so the halo\\n// grows proportionally to the magnified dot.\\nuniform float magZoom;\\nuniform vec2  magCenter;\\n\\nvec2 magnifyUV(vec2 uv) {\\n    if (magZoom > 1.001) {\\n        return clamp(magCenter + (uv - vec2(0.5)) / magZoom, vec2(0.0), vec2(1.0));\\n    }\\n    return uv;\\n}\\n\\n// Lighting\\nuniform float lightIntensity;     // 0..1  (directional lamp)\\nuniform float lightAngle;         // radians\\nuniform float lightElevation;     // 0..PI/2\\nuniform float ambientLight;       // 0..1\\nuniform float threePointLighting; // 0..1  (3 fixed Blender lamps blend)\\n\\n// Output\\nuniform float outputGamma;      // 0.1..4.0 (default 1.3, Blender post-mix gamma)\\n\\n// S5.C+S5.D "}]
0x1801d0dad=[{"size":364,"type":"s","subtype":56,"str":" Plate-Proof popup. 0 = OFF (composite, default; identical\\n// to pre-S5 render). Other values short-circuit ink mixing/lighting/gamma\\n// to render a black-on-white separation view. Host uploads value - 1\\n// (PrGPU side uses 1-based RISO_PROOF_MODE_OFF=1; here it's 0-based).\\n//   1 DOT_MASK  2 C  3 M  4 Y  5 K  6 QUAD (4-up grid).\\nuniform int proofMode;\\n\\n// S5.G "}]
0x1801d0f1c=[{"size":1246,"type":"s","subtype":56,"str":" Paper Type. 0 = CUSTOM (default; isotropic FBM, original\\n// behaviour). Other values re-shape the paper-structure FBM sampling UV\\n// to produce a specific real-paper grain. Host uploads value - 1.\\n//   1 NEWSPRINT  2 COTTON  3 KRAFT  4 PAPYRUS  5 SMOOTH.\\nuniform int paperType;\\n\\nuniform vec2 resolution;\\nuniform int quality;\\n\\nin vec2 out_uvs;\\nlayout(location = 0) out vec4 colourOut;\\n\\n// ---- Noise helpers ----\\n\\nfloat hash(vec2 p)\\n{\\n    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);\\n}\\n\\nfloat noise2D(vec2 p)\\n{\\n    vec2 i = floor(p);\\n    vec2 f = fract(p);\\n    vec2 u = f * f * (3.0 - 2.0 * f);\\n    float a = hash(i);\\n    float b = hash(i + vec2(1.0, 0.0));\\n    float c = hash(i + vec2(0.0, 1.0));\\n    float d = hash(i + vec2(1.0, 1.0));\\n    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\\n}\\n\\n\\n\\n// 2-channel hash for Worley/voronoi cell randomisation (F11 reticulation).\\nvec2 hash2(vec2 p)\\n{\\n    p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));\\n    return fract(sin(p) * 43758.5453);\\n}\\n\\nfloat fbm(vec2 p, int octaves)\\n{\\n    float val = 0.0;\\n    float amp = 0.5;\\n    for (int i = 0; i < octaves; i++) {\\n        val += amp * noise2D(p);\\n        p *= 2.0;\\n        amp *= 0.5;\\n    }\\n    return val;\\n}\\n\\n// ---- RGB "}]
0x1801d13fd=[{"size":683,"type":"s","subtype":56,"str":" HSV conversion (for hue-based color inconsistency) ----\\nvec3 rgb2hsv(vec3 c)\\n{\\n    vec4 K = vec4(0.0, -1.0/3.0, 2.0/3.0, -1.0);\\n    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));\\n    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));\\n    float d = q.x - min(q.w, q.y);\\n    float e = 1.0e-10;\\n    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);\\n}\\n\\nvec3 hsv2rgb(vec3 c)\\n{\\n    vec4 K = vec4(1.0, 2.0/3.0, 1.0/3.0, 3.0);\\n    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);\\n    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);\\n}\\n\\n// ---- Soft-light blend (Blender MixRGB blend=SOFT_LIGHT at Fac=1) ----\\n//   if light "}]
0x1801d16ab=[{"size":37,"type":"s","subtype":56,"str":" 0.5: base - (1-2*light)*(base - base"}]
0x1801d16d2=[{"size":503,"type":"s","subtype":56,"str":")\\n//   else:           base + (2*light-1)*(sqrt(base) - base)\\nvec3 softLight(vec3 base, vec3 light) {\\n    return mix(base - (1.0 - 2.0 * light) * (base - base * base),\\n               base + (2.0 * light - 1.0) * (sqrt(max(base, 0.0)) - base),\\n               step(0.5, light));\\n}\\n\\n// ---- Artificial lamp contribution (Blender NTArtificial Light) ----\\n// Mirrors the node chain exactly:\\n//   shifted = UV - lightPos.xy                       (Vector Math.006 ADD with inverted pos)\\n//   scaled  = shifted "}]
0x1801d18cb=[{"size":109,"type":"s","subtype":56,"str":" (1 - Radius)                 (Vector Math.001 SCALE; clamp 1-R to [0,1])\\n//   grad    = max(1 - |scaled|, 0)"}]
0x1801d193a=[{"size":53,"type":"s","subtype":56,"str":"                  (Gradient Texture QUADRATIC_SPHERE "}]
0x1801d1972=[{"size":278,"type":"s","subtype":56,"str":" verified\\n//                                                     gradient_type=5 in .blend for this node too)\\n//   lit     = dot(lightNormal, lightPos)             (Vector Math.004 DOT_PRODUCT; position used\\n//                                                     as a direction "}]
