0x1801d7b78=[{"size":82,"type":"s","subtype":56,"str":" K).\\n\\n    vec3 useC = inkC, useM = inkM, useY = inkY, useK = inkK;\\n\\n    // ---- F-"}]
0x1801d7bd0=[{"size":266,"type":"s","subtype":56,"str":" Per-render ink personality drift ----\\n    // Apply a tiny hue shift per ink seeded by frameTime so each frame /\\n    // each render shows a slightly different ink hue, matching how real\\n    // Riso barrels drift print-to-print. Maximum drift at slider=100 is\\n    // "}]
0x1801d7ce0=[{"size":298,"type":"s","subtype":56,"str":" (just visible as a subtle shift, never enough to look broken).\\n    // Each ink gets a different time-frequency seed so they drift\\n    // independently rather than all moving together.\\n    if (inkDrift > 0.001) {\\n        // Drift magnitude in normalised hue (0..1 wraps a full cycle).\\n        // 10"}]
0x1801d7e10=[{"size":44,"type":"s","subtype":56,"str":" 0.0278 in 0..1 hue space. inkDrift is 0..1 "}]
0x1801d7e3f=[{"size":1750,"type":"s","subtype":56,"str":" max 0.0278.\\n        float maxShift = 0.0278;\\n        float dC = sin(frameTime * 0.31 +  1.7) * inkDrift * maxShift;\\n        float dM = sin(frameTime * 0.43 +  4.1) * inkDrift * maxShift;\\n        float dY = sin(frameTime * 0.27 +  9.3) * inkDrift * maxShift;\\n        float dK = sin(frameTime * 0.19 + 13.7) * inkDrift * maxShift;\\n        // Apply hue shift in HSV space then back to RGB so each ink\\n        // moves along its hue axis without changing saturation/value.\\n        vec3 hC = rgb2hsv(useC); hC.x = fract(hC.x + dC); useC = hsv2rgb(hC);\\n        vec3 hM = rgb2hsv(useM); hM.x = fract(hM.x + dM); useM = hsv2rgb(hM);\\n        vec3 hY = rgb2hsv(useY); hY.x = fract(hY.x + dY); useY = hsv2rgb(hY);\\n        vec3 hK = rgb2hsv(useK); hK.x = fract(hK.x + dK); useK = hsv2rgb(hK);\\n    }\\n\\n    // ---- Ink Muting (Blender NTQualityControl Ink Color Factor) ----\\n    // Blends user-picked inks toward Blender's default \\"real Riso\\" muted\\n    // tones. At 0 the user's exact inks are used; at 1 it becomes a full\\n    // Riso look regardless of the color pickers. Applied BEFORE fade so\\n    // both the original and faded versions reflect the muting choice.\\n    if (inkColorFactor > 0.0) {\\n        // Muted CMYK targets from NTQualityControl Mix.Color2 defaults.\\n        const vec3 mutedC = vec3(0.052823, 0.445925, 0.850980);\\n        const vec3 mutedM = vec3(1.000000, 0.077374, 0.597661);\\n        const vec3 mutedY = vec3(0.918134, 0.695481, 0.030740);\\n        const vec3 mutedK = vec3(0.004287, 0.006604, 0.004020);\\n        useC = mix(useC, mutedC, inkColorFactor);\\n        useM = mix(useM, mutedM, inkColorFactor);\\n        useY = mix(useY, mutedY, inkColorFactor);\\n        useK = mix(useK, mutedK, inkColorFactor);\\n    }\\n\\n    // Directional fade mask "}]
0x1801d8518=[{"size":136,"type":"s","subtype":56,"str":" simulates a poster bleached from one side.\\n    // fadeDir = angle toward which the fade peaks (e.g. 0 = east side fades\\n    // most, 90"}]
0x1801d85a2=[{"size":1287,"type":"s","subtype":56,"str":" = north side, etc). Mask goes 0 at the opposite edge to 1\\n    // at the facing edge, so user's `inkFade` slider = maximum fade, not\\n    // uniform fade. Useful for \\"sun-damaged\\" looks.\\n    float fadeMask = 1.0;\\n    if (inkFade > 0.0) {\\n        vec2 dir = vec2(cos(fadeDir), sin(fadeDir));\\n        fadeMask = clamp(0.5 + dot(uv - 0.5, dir), 0.0, 1.0);\\n    }\\n    float effFade = inkFade * fadeMask;\\n\\n    if (effFade > 0.0) {\\n        useC = mix(useC, vec3(1.0), effFade * 0.3);\\n        useM = mix(useM, vec3(1.0), effFade * 0.95);\\n        useY = mix(useY, vec3(1.0), effFade * 0.8);\\n        useK = mix(mix(useK, useC, effFade * 0.33), vec3(1.0), effFade * 0.02);\\n    }\\n\\n    if (colorInconsistency > 0.0) {\\n        float structNoise = fbm(uv * paperScale * 0.25, 2);\\n        float hueShift = (structNoise - 0.5) * colorInconsistency * 0.15;\\n        // Inline hue shift (avoids reinstancing rgb2hsv/hsv2rgb per ink).\\n        vec3 hsv;\\n        hsv = rgb2hsv(useC); hsv.x = fract(hsv.x + hueShift); useC = hsv2rgb(hsv);\\n        hsv = rgb2hsv(useM); hsv.x = fract(hsv.x + hueShift); useM = hsv2rgb(hsv);\\n        hsv = rgb2hsv(useY); hsv.x = fract(hsv.x + hueShift); useY = hsv2rgb(hsv);\\n        hsv = rgb2hsv(useK); hsv.x = fract(hsv.x + hueShift); useK = hsv2rgb(hsv);\\n    }\\n\\n    // ====== F2 "}]
0x1801d8aac=[{"size":97,"type":"s","subtype":56,"str":" Overprint mode (Beer-Lambert vs legacy multiply) ======\\n    // Multiply (legacy, mode=0): paper "}]
0x1801d8b0f=[{"size":20,"type":"s","subtype":56,"str":" mix(1, useC, cCov) "}]
0x1801d8b25=[{"size":5,"type":"s","subtype":56,"str":" ... "}]
0x1801d8b2d=[{"size":89,"type":"s","subtype":56,"str":" order-\\n    // dependent, ink-on-ink looks muddy.\\n    // Beer-Lambert (mode=1): T = exp(-"}]
0x1801d8b88=[{"size":9,"type":"s","subtype":56,"str":" density "}]
0x1801d8b93=[{"size":115,"type":"s","subtype":56,"str":" absorption). Order-\\n    // independent translucent stacking. Gives glowing purple where Pink+\\n    // Blue overlap "}]
0x1801d8c09=[{"size":649,"type":"s","subtype":56,"str":" the Riso signature.\\n    vec3 result;\\n    if (overprintMode == 1) {\\n        vec3 absorb = vec3(0.0);\\n        absorb += cCov * inkOpacity[0] * (vec3(1.0) - useC);\\n        absorb += mCov * inkOpacity[1] * (vec3(1.0) - useM);\\n        absorb += yCov * inkOpacity[2] * (vec3(1.0) - useY);\\n        absorb += kCov * inkOpacity[3] * (vec3(1.0) - useK);\\n        result = paper * exp(-absorb);\\n    } else {\\n        result = paper;\\n        result = mix(result, result * useC, cCov);\\n        result = mix(result, result * useM, mCov);\\n        result = mix(result, result * useY, yCov);\\n        result = mix(result, result * useK, kCov);\\n    }\\n\\n    // ====== F7 "}]
0x1801d8e95=[{"size":221,"type":"s","subtype":56,"str":" INK POOLING ======\\n    // The \\"excess\\" coverage we trimmed during the TAC clamp accumulates\\n    // into a darker, colour-shifted patch. Without this the user's\\n    // formerly solid blacks would just look slightly faded "}]
0x1801d8f75=[{"size":371,"type":"s","subtype":56,"str":" with it,\\n    // they read as \\"wet ink pooled and dried unevenly.\\"\\n    if (inkPool > 0.001 && tacExcess > 0.001) {\\n        float pool = clamp(tacExcess * inkPool * 0.6, 0.0, 0.6);\\n        // Drift toward the dominant ink among the over-saturated channels.\\n        // We weight inks by their post-clamp coverage; in pure-black areas\\n        // this collapses to the K ink "}]
0x1801d90eb=[{"size":330,"type":"s","subtype":56,"str":" looks like wet K pooling.\\n        float wsum = cCov + mCov + yCov + kCov + 1e-4;\\n        vec3 dominantInk = (useC * cCov + useM * mCov + useY * yCov + useK * kCov) / wsum;\\n        // Multiplicative blend pulls the result toward the dominant ink.\\n        result = mix(result, result * dominantInk, pool);\\n    }\\n\\n    // ====== F11 "}]
0x1801d9238=[{"size":1221,"type":"s","subtype":56,"str":" INK RETICULATION (Worley crackle on high-coverage) ======\\n    // Oil-based Riso ink can crackle on humid paper, especially in solid-\\n    // fill areas. Computed Worley distance: thin \\"thread\\" mask appears at\\n    // cell boundaries, masked by max coverage so blank paper stays clean.\\n    if (reticulation > 0.001) {\\n        float coverage = max(max(cCov, mCov), max(yCov, kCov));\\n        if (coverage > 0.35) {\\n            // Anchor pattern to OUTPUT UV (out_uvs) not magnified mUV,\\n            // otherwise cracks slide over the halftone when zooming\\n            // via Magnify (FBM resamples a different noise region).\\n            // Same Q2-style fix as Pass 2 alt-screens. See matching\\n            // CUDA kernel comment for full rationale.\\n            vec2 wPos = out_uvs * reticulationScale;\\n            float n = fbm(wPos, 3);\\n            float crackMask = smoothstep(0.47, 0.50, n) *\\n                              (1.0 - smoothstep(0.50, 0.53, n));\\n            float sparse = smoothstep(0.45, 0.65, fbm(wPos * 0.3, 2));\\n            float covMask = smoothstep(0.35, 0.85, coverage);\\n            float reticAmount = crackMask * sparse * reticulation * 0.55 * covMask;\\n            // Paper shows through fine cracks "}]
0x1801d9700=[{"size":146,"type":"s","subtype":56,"str":" blend toward paperColor.\\n            result = mix(result, paper, reticAmount);\\n        }\\n    }\\n\\n    // ====== 6. DARK SPECKS (extra ink deposits "}]
0x1801d9795=[{"size":126,"type":"s","subtype":56,"str":" darken result) ======\\n    if (darkSpeckMask > 0.0) {\\n        result *= 1.0 - darkSpeckMask * 0.4;\\n    }\\n\\n    // ====== 6b. F-"}]
0x1801d9819=[{"size":894,"type":"s","subtype":56,"str":" REVERSE-PRINT MODE ======\\n    // Inversion of the ink-paper composite BEFORE output gamma + lighting,\\n    // so lighting + gamma still apply correctly to the reversed image.\\n    // Gives the white-ink-on-dark-paper Riso aesthetic (e.g., black paper\\n    // with fluorescent ink). Distinct from G4 Negative which inverts at\\n    // SwizzleOut AFTER lighting + I4/I5; the difference shows up clearly\\n    // when lighting > 0 because here lights illuminate the dark ground,\\n    // there lights illuminate the bright print.\\n    if (reversePrint != 0) {\\n        result = vec3(1.0) - clamp(result, 0.0, 1.0);\\n    }\\n\\n\\n    // ====== 7. OUTPUT GAMMA (Blender: Gamma node after ink mixing) ======\\n    // Blender Gamma node: pow(color, gamma). gamma > 1 darkens, < 1 brightens.\\n    if (outputGamma != 1.0) {\\n        result = pow(max(result, vec3(0.0)), vec3(outputGamma));\\n    }\\n\\n    // ====== 8. LIGHTING "}]
0x1801d9b9a=[{"size":300,"type":"s","subtype":56,"str":" two mutually fading modes ======\\n    // Mode A (section 8a): single user-controlled directional lamp with a\\n    // subtle tri-color rim tint. Cheap fallback / default look.\\n    // Mode B (section 8b): three fixed Blender NTLighting Setup lamps with\\n    // radial falloff per `artificialLampContrib` "}]
0x1801d9cc9=[{"size":780,"type":"s","subtype":56,"str":" the accurate Blender match.\\n    //\\n    // `threePointLighting` crossfades between the two modes: at 0 only mode A\\n    // runs, at 1 only mode B. Running both at full strength would\\n    // double-expose (each softLight call brightens the base independently),\\n    // so the weights are explicitly complementary.\\n    float dirWeight = 1.0 - threePointLighting;\\n\\n    // ---- Section 8a: directional lamp + tri-color tint ----\\n    if (lightIntensity > 0.0 && dirWeight > 0.0) {\\n        vec3 lightDir = normalize(vec3(\\n            cos(lightAngle) * cos(lightElevation),\\n            sin(lightAngle) * cos(lightElevation),\\n            sin(lightElevation)\\n        ));\\n        float diffuse = max(dot(paperNormal, lightDir), 0.0);\\n\\n        // Tri-color rim tint based on paper normal tilt "}]
0x1801d9fd8=[{"size":1208,"type":"s","subtype":56,"str":" cheap multi-light feel.\\n        vec3 warmWhite  = vec3(1.00, 0.90, 0.86);\\n        vec3 coolBlue   = vec3(0.50, 0.72, 1.00);\\n        vec3 warmOrange = vec3(1.00, 0.70, 0.55);\\n        float wCool = clamp( paperNormal.x * 0.5 + 0.5, 0.0, 1.0);\\n        float wWarm = clamp(-paperNormal.y * 0.5 + 0.5, 0.0, 1.0);\\n        vec3 lightTint = warmWhite;\\n        lightTint = mix(lightTint, coolBlue,   wCool * 0.3);\\n        lightTint = mix(lightTint, warmOrange, wWarm * 0.3);\\n\\n        float lighting = ambientLight + diffuse * lightIntensity;\\n        vec3 lightVec  = clamp(vec3(lighting) * lightTint, 0.0, 1.0);\\n        vec3 lit       = softLight(result, lightVec);\\n        result = mix(result, lit, dirWeight);\\n    }\\n\\n    // ---- Section 8b: 3-lamp Blender-exact (NTLighting Setup) ----\\n    // Positions, intensities, radii and colors come straight from NTMRMO's\\n    // default Group Input values:\\n    //   L1: pos (-4,    3.22,   1.02),  I=8.7,   R=0.87, warm-white\\n    //   L2: pos ( 5.25, -2.48, -0.30),  I=8.2,   R=0.85, cool-blue\\n    //   L3: pos ( 5.05,  2.66,  2.00),  I=10.7,  R=0.77, warm-orange\\n    // paperNormal plays the role of Blender's \\"Light Normal\\" (which comes\\n    // from NTNormal Paper Texture "}]
0x1801da493=[{"size":1434,"type":"s","subtype":98,"str":" an RGB normal map).\\n    if (threePointLighting > 0.0) {\\n        const vec3 L1_pos = vec3(-4.00,  3.22,  1.02);\\n        const vec3 L2_pos = vec3( 5.25, -2.48, -0.30);\\n        const vec3 L3_pos = vec3( 5.05,  2.66,  2.00);\\n        const vec3 L1_col = vec3(1.000000, 0.903833, 0.862987);\\n        const vec3 L2_col = vec3(0.132054, 0.525919, 1.000000);\\n        const vec3 L3_col = vec3(1.000000, 0.504518, 0.277420);\\n        const float L1_I  = 8.7,  L2_I = 8.2,  L3_I = 10.7;\\n        const float L1_R  = 0.87, L2_R = 0.85, L3_R = 0.77;\\n\\n        vec3 lampSum = vec3(0.0);\\n        lampSum += artificialLampContrib(L1_pos, L1_col, L1_I, L1_R, paperNormal, uv, result);\\n        lampSum += artificialLampContrib(L2_pos, L2_col, L2_I, L2_R, paperNormal, uv, result);\\n        lampSum += artificialLampContrib(L3_pos, L3_col, L3_I, L3_R, paperNormal, uv, result);\\n\\n        vec3 lit = softLight(result, clamp(lampSum, 0.0, 1.0));\\n        result   = mix(result, lit, threePointLighting);\\n    }\\n\\n    result = clamp(result, 0.0, 1.0);\\n\\n    // ====== 9. OUTPUT ======\\n    // Re-premultiply. Transparent mode emits only printed ink coverage.\\n    float outAlpha = srcAlpha;\\n    if (transparentBackground) {\\n        float printAlpha = max(max(cCov, mCov), max(yCov, kCov));\\n        printAlpha = max(printAlpha, darkSpeckMask * 0.6);\\n        outAlpha = srcAlpha * clamp(printAlpha, 0.0, 1.0);\\n    }\\n    colourOut = vec4(result * outAlpha, outAlpha);\\n}\\n"}]
