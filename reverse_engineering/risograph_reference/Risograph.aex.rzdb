0x1801cddc9=[{"size":402,"type":"s","subtype":56,"str":" drumAnimW shifts noise W slice per frame for animated\\n            // distortion (default 0 = static).\\n            float w = 2.49 + 7.0 * float(ch) + drumAnimW;\\n            float n1 = fbm3D(vec3(gridPos * 0.5,                  w), noiseOctaves) - 0.5;\\n            float n2 = fbm3D(vec3(gridPos * 0.5 + vec2(5.2, 1.3), w), noiseOctaves) - 0.5;\\n            // Amplitude bumped 5x (0.06 -> 0.30, 2026-05) "}]
0x1801cdf5e=[{"size":402,"type":"s","subtype":56,"str":" see matching\\n            // CUDA kernel comment for user-report rationale.\\n            gridDistortOff = vec2(n1, n2) * dist01 * 0.30;\\n            gridPos += gridDistortOff;\\n        }\\n\\n        // ---- CMYK sampling: one texture lookup per pass per channel ----\\n        // Find nearest cell center for pass 1 & pass 2 (hard-min Voronoi).\\n        // The CMYK value is then sampled once at each cell's UV "}]
0x1801ce0f3=[{"size":42,"type":"s","subtype":56,"str":" per-\\n        // subpixel sampling would 4"}]
0x1801ce11f=[{"size":773,"type":"s","subtype":56,"str":" the texture bandwidth with negligible\\n        // quality gain since channel values barely change across 1-pixel\\n        // distances.\\n        VoronoiResult v1 = voronoiCell(gridPos, dotShape, randomness);\\n        VoronoiResult v2 = voronoiCell(gridPos + vec2(20.0, 0.0),\\n                                       dotShape, randomness);\\n\\n        vec2 cellUV1 = gridToUV(v1.cellCenter,                     ch, angle, offset, freq);\\n        vec2 cellUV2 = gridToUV(v2.cellCenter - vec2(20.0, 0.0),   ch, angle, offset, freq);\\n\\n        vec4 cmyk1 = sampleCMYKBlurred(cellUV1, blurRadius);\\n        vec4 cmyk2 = sampleCMYKBlurred(cellUV2, blurRadius);\\n\\n        float val1 = max(cmyk1[ch] - specks[ch], 0.0);\\n        float val2 = max(cmyk2[ch] - specks[ch], 0.0);\\n\\n        // ---- 2"}]
0x1801ce426=[{"size":313,"type":"s","subtype":56,"str":"2 supersample the ink threshold (union of 9 neighbor cells) ----\\n        // Union-of-circles means each cell's dot is a free circle around\\n        // its center, not bounded by the Voronoi cell shape. At high\\n        // coverage, adjacent cells' circles naturally overlap and fill\\n        // dark regions solidly "}]
0x1801ce562=[{"size":129,"type":"s","subtype":56,"str":" no \\"square fill\\" artifact, and no\\n        // corner mesh of holes. Combined with supersampling, angle-\\n        // dependent Moir"}]
0x1801ce5e5=[{"size":193,"type":"s","subtype":56,"str":" also disappears.\\n        // Subpixel supersample uses raw `out_uvs` offsets divided by zoom\\n        // so the AA neighbourhood stays tight in source-space (we want 4\\n        // samples within "}]
0x1801ce6a8=[{"size":94,"type":"s","subtype":56,"str":"0.25 px of the true zoomed pixel center, not 4\\n        // samples inflated by the zoom factor "}]
0x1801ce709=[{"size":1408,"type":"s","subtype":98,"str":" which would oversample\\n        // adjacent cells and blur the edges).\\n        float ssScale = (magZoom > 1.001) ? (1.0 / magZoom) : 1.0;\\n        vec2 g0 = computeGridPos(mUV + vec2(-0.25, -0.25) * px * ssScale, ch, angle, offset, freq) + gridDistortOff;\\n        vec2 g1 = computeGridPos(mUV + vec2( 0.25, -0.25) * px * ssScale, ch, angle, offset, freq) + gridDistortOff;\\n        vec2 g2 = computeGridPos(mUV + vec2(-0.25,  0.25) * px * ssScale, ch, angle, offset, freq) + gridDistortOff;\\n        vec2 g3 = computeGridPos(mUV + vec2( 0.25,  0.25) * px * ssScale, ch, angle, offset, freq) + gridDistortOff;\\n\\n        float dot1 = 0.25 * (\\n            unionDotInk(g0, dotShape, randomness, val1, factor) +\\n            unionDotInk(g1, dotShape, randomness, val1, factor) +\\n            unionDotInk(g2, dotShape, randomness, val1, factor) +\\n            unionDotInk(g3, dotShape, randomness, val1, factor));\\n        float dot2 = 0.25 * (\\n            unionDotInk(g0 + vec2(20.0, 0.0), dotShape, randomness, val2, factor) +\\n            unionDotInk(g1 + vec2(20.0, 0.0), dotShape, randomness, val2, factor) +\\n            unionDotInk(g2 + vec2(20.0, 0.0), dotShape, randomness, val2, factor) +\\n            unionDotInk(g3 + vec2(20.0, 0.0), dotShape, randomness, val2, factor));\\n\\n        // ADD both dual-pass contributions and clamp.\\n        result[ch] = clamp(dot1 + dot2, 0.0, 1.0);\\n    }\\n\\n    colourOut = result;\\n}\\n"}]
0x1801cec90=[{"size":276,"type":"s","subtype":56,"str":"\\n#version 330\\nuniform sampler2D srcTex;\\nuniform vec2  direction;       // (1,0) for H, (0,1) for V\\nuniform vec2  resolution;\\nuniform float haloRadius;      // pixels (0 = halo off; clamp prevents)\\n\\nin vec2 out_uvs;\\nlayout(location = 0) out vec4 colourOut;\\n\\n// 9-tap Gaussian, "}]
0x1801cedaa=[{"size":32,"type":"s","subtype":56,"str":" radius/3. Weights computed for "}]
0x1801cedcc=[{"size":118,"type":"s","subtype":56,"str":"=1, then we\\n// rescale offsets by haloRadius so the kernel actually spans `radius`\\n// pixels per side. Sum of weights "}]
0x1801cee45=[{"size":824,"type":"s","subtype":56,"str":" 1.0.\\nconst float w[5] = float[5](\\n    0.20416368871516756,   // centre\\n    0.18017382291138086,   // ±1\\n    0.12383154862992032,   // ±2\\n    0.06628224528792877,   // ±3\\n    0.02763055259194701    // ±4\\n);\\n\\nvoid main()\\n{\\n    vec2 step = direction / resolution * max(haloRadius * 0.25, 0.5);\\n    vec4 sum = texture(srcTex, out_uvs) * w[0];\\n    sum += texture(srcTex, out_uvs + step * 1.0) * w[1];\\n    sum += texture(srcTex, out_uvs - step * 1.0) * w[1];\\n    sum += texture(srcTex, out_uvs + step * 2.0) * w[2];\\n    sum += texture(srcTex, out_uvs - step * 2.0) * w[2];\\n    sum += texture(srcTex, out_uvs + step * 3.0) * w[3];\\n    sum += texture(srcTex, out_uvs - step * 3.0) * w[3];\\n    sum += texture(srcTex, out_uvs + step * 4.0) * w[4];\\n    sum += texture(srcTex, out_uvs - step * 4.0) * w[4];\\n    colourOut = sum;\\n}\\n"}]
0x1801cf180=[{"size":616,"type":"s","subtype":56,"str":"\\n#version 330\\nuniform sampler2D inputTex;     // original RGBA (premultiplied)\\nuniform sampler2D halftoneTex;  // CMYK dot masks from pass 2\\n\\n// Ink\\nuniform vec3 inkC;              // Cyan ink RGB (0..1)\\nuniform vec3 inkM;              // Magenta ink RGB\\nuniform vec3 inkY;              // Yellow ink RGB\\nuniform vec3 inkK;              // Black ink RGB\\nuniform float inkIntensity;     // 0..2\\n// \\"Black Boost\\" multiplier on K-plate coverage. Applied at coverage\\n// stage (BEFORE F2 Beer-Lambert exp() / Multiply transmittance), so the\\n// K plate prints physically denser at multiplyK > 1 in BOTH overprint\\n// modes "}]
0x1801cf3eb=[{"size":334,"type":"s","subtype":56,"str":" Beer-Lambert sees more K density per unit coverage; legacy\\n// Multiply sees more K transmittance attenuation. E5 doc clarification:\\n// historical confusion was that this was thought to \\"double-apply\\" in\\n// Beer-Lambert mode; in fact it applies once (at coverage), then\\n// inkKOpacity (Translucency) further modulates K transmittance "}]
