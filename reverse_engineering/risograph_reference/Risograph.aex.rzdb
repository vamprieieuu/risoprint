0x1801d3be5=[{"size":529,"type":"s","subtype":56,"str":" paperType aggressively re-shapes the FBM sampling UV AND\\n    // for KRAFT / PAPYRUS overlays an explicit horizontal banding pattern\\n    // so the directional grain is unmistakably visible even at low\\n    // paperStructure. Mirror of CUDA kernel branch so the OpenGL fallback\\n    // sees identical paper looks. Host uploads value - 1 from\\n    // RISO_PAPER_TYPE_*; here paperType == 0 means CUSTOM (no transform).\\n    //\\n    // Effect is GATED by paperStructure: if user has Paper Grain at 0%,\\n    // the entire block is skipped "}]
0x1801d3df9=[{"size":544,"type":"s","subtype":56,"str":" all types render identically. Default\\n    // 20 % gives visible grain.\\n    if (usePaperBackground && paperStructure > 0.0) {\\n        vec2 fp = uv * paperScale * 2.0;\\n        float fiberStrength = 1.0;\\n        float overlay = 0.5;  // neutral overlay (no contribution)\\n\\n        if (paperType == 1) {              // NEWSPRINT\\n            fp *= 2.5;\\n            fiberStrength = 2.0;\\n        } else if (paperType == 2) {       // COTTON\\n            fp *= 0.55;\\n            fiberStrength = 0.7;\\n        } else if (paperType == 3) {       // KRAFT "}]
0x1801d401c=[{"size":334,"type":"s","subtype":56,"str":" strong horizontal fibers\\n            fp.x *= 1.0;  fp.y *= 0.10;\\n            fiberStrength = 1.5;\\n            float bandY = uv.y * paperScale * 0.6;\\n            float bandX = uv.x * paperScale * 0.08;\\n            overlay = 0.5 + 0.18 * sin(bandY * 6.2832) * cos(bandX * 6.2832);\\n        } else if (paperType == 4) {       // PAPYRUS "}]
0x1801d416d=[{"size":369,"type":"s","subtype":56,"str":" woven horizontal weave\\n            fp.x *= 1.5;  fp.y *= 0.07;\\n            fiberStrength = 1.7;\\n            float bandY = uv.y * paperScale * 1.2;\\n            overlay = 0.5 + 0.25 * sin(bandY * 6.2832);\\n        } else if (paperType == 5) {       // SMOOTH\\n            fp *= 0.30;\\n            fiberStrength = 0.20;\\n        }\\n        // paperType == 0 (CUSTOM, default) "}]
0x1801d42e1=[{"size":311,"type":"s","subtype":56,"str":" no transform, identical\\n        // to pre-S5.G render so saved comps render unchanged.\\n        float fiber = fbm(fp, noiseOctaves);\\n        float combined = fiber * 0.6 + overlay * 0.4;\\n        vec3 fiberShade = vec3(0.5 + (combined - 0.5) * 0.85 * fiberStrength);\\n\\n        // Blend boost for non-CUSTOM types "}]
0x1801d441b=[{"size":136,"type":"s","subtype":56,"str":" at default Paper Grain=20%\\n        // the original mix factor was too subtle to read the difference\\n        // between paper types. 2.5"}]
0x1801d44a5=[{"size":388,"type":"s","subtype":56,"str":" boost (clamped at 1.0) makes types\\n        // visibly distinct at 20% while CUSTOM retains 1:1 backward\\n        // compat with v2.1.1 saved projects. Mirror of CUDA kernel.\\n        float typeBoost = (paperType == 0) ? 1.0 : 2.5;\\n        float effStruct = min(1.0, paperStructure * typeBoost);\\n        paper = mix(paper, softLight(paper, fiberShade), effStruct);\\n    }\\n\\n    // Paper tone "}]
