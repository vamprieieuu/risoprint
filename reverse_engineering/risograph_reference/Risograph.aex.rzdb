0x1801d4b8c=[{"size":2047,"type":"s","subtype":98,"str":" user\\n    // reported it appeared as a vertical flip. v2.1.5+ uses Y-only,\\n    // confirmed-correct horizontal mirror.\\n    if (usePaperBackground && showThrough > 0.001) {\\n        vec2 stUV = vec2(uv.x, 1.0 - uv.y);\\n        float pxX = 1.5 / resolution.x;\\n        float pxY = 1.5 / resolution.y;\\n        vec3 stCol = (\\n            texture(inputTex, stUV + vec2( pxX,  pxY)).rgb +\\n            texture(inputTex, stUV + vec2(-pxX,  pxY)).rgb +\\n            texture(inputTex, stUV + vec2( pxX, -pxY)).rgb +\\n            texture(inputTex, stUV + vec2(-pxX, -pxY)).rgb\\n        ) * 0.25;\\n        // Convert to luminance darkness; full black input darkens paper most.\\n        float stDark = 1.0 - dot(stCol, vec3(0.299, 0.587, 0.114));\\n        // Cap at 35 % multiplicative darkening at full slider.\\n        paper *= mix(vec3(1.0), vec3(1.0 - 0.35 * stDark), showThrough);\\n    }\\n\\n    paper = clamp(paper, 0.0, 1.0);\\n\\n    // ====== 2. PAPER NORMAL (bump from crumple height field) ======\\n    // Always compute some bump so lighting has a surface; amplitude scales\\n    // with crumpling. Blender derives this from a baked normal + Bump node;\\n    // here we differentiate the same height field used above.\\n    vec3 paperNormal;\\n    if (!usePaperBackground) {\\n        paperNormal = vec3(0.0, 0.0, 1.0);\\n    } else {\\n        float eps = 1.5 / max(resolution.x, resolution.y);\\n        float hL = fbm((uv + vec2(-eps, 0.0)) * crScale, noiseOctaves);\\n        float hR = fbm((uv + vec2( eps, 0.0)) * crScale, noiseOctaves);\\n        float hD = fbm((uv + vec2(0.0, -eps)) * crScale, noiseOctaves);\\n        float hU = fbm((uv + vec2(0.0,  eps)) * crScale, noiseOctaves);\\n        // Keep a small baseline so non-crumpled paper still has micro-shading\\n        // when the user turns lighting up. Crumpling amplifies it sharply.\\n        float amp = 0.5 + paperCrumpling * 12.0;\\n        paperNormal = normalize(vec3((hL - hR) * amp,\\n                                     (hD - hU) * amp,\\n                                     1.0));\\n    }\\n\\n    // ====== 3. INK COVERAGE (from"}]
0x1801d538b=[{"size":273,"type":"s","subtype":56,"str":" halftone pass) ======\\n    float cCov = clamp(dots.r * inkIntensity, 0.0, 1.0);\\n    float mCov = clamp(dots.g * inkIntensity, 0.0, 1.0);\\n    float yCov = clamp(dots.b * inkIntensity, 0.0, 1.0);\\n    float kCov = clamp(dots.a * inkIntensity * multiplyK, 0.0, 1.0);\\n\\n    // F-"}]
0x1801d54a2=[{"size":529,"type":"s","subtype":56,"str":" Plate inspect mask (1 visible, 0 muted). Default vec4(1)\\n    // is no-op; \\"Solo Plate 2\\" sends (0,1,0,0) to isolate Magenta etc.\\n    cCov *= plateMask.x;\\n    mCov *= plateMask.y;\\n    yCov *= plateMask.z;\\n    kCov *= plateMask.w;\\n\\n    // ====== 3a. YULE-NIELSEN DOT GAIN (F8) ======\\n    // Physical model of optical dot gain: ink dots appear larger than the\\n    // raw coverage suggests because light scatters laterally inside the\\n    // paper substrate. Apply pow(coverage, 1/n) where n is the Yule-Nielsen\\n    // exponent. n=1 "}]
