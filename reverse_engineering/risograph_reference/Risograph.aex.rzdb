0x1801d29ea=[{"size":93,"type":"s","subtype":56,"str":" halftone visually drifted\\n    // away from paper/ink at zoom > 1, especially with magCenter "}]
0x1801d2a4a=[{"size":491,"type":"s","subtype":56,"str":" 50%.\\n    //\\n    // 2026-05-17 follow-up: the crumple offset must also be output-anchored\\n    // during Vector zoom. Source-anchored hC/hC2 changed on every zoom step\\n    // while being applied to output-indexed halftoneTex, causing subtle\\n    // dot-to-dot shimmer. Paper grain / normals below still use source-space\\n    // `uv`; only this halftone texture-read displacement is stabilized.\\n    vec2 halftoneUV = out_uvs + vec2(hC - 0.5, hC2 - 0.5) * paperCrumpling * 0.02;\\n\\n    // ====== F-"}]
0x1801d2c3b=[{"size":395,"type":"s","subtype":56,"str":" Multi-press / sequential impressions ======\\n    // Single-press (impressions == 1) is the legacy path: one halftone\\n    // texture lookup. >1 simulates the sheet running through the machine\\n    // N times; each impression jitters slightly relative to the first\\n    // (drum slip on re-feed) and accumulates ink in transmittance space.\\n    // Composite formula (per channel):\\n    //   T_total = "}]
0x1801d2dc8=[{"size":21,"type":"s","subtype":56,"str":" (1 - dots_i)        "}]
