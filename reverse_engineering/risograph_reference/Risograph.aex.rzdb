0x1801f24b5=[{"size":2047,"type":"s","subtype":98,"str":"moothness, int screenType, float specksAmount, float specksSize, int quality, float drumAnimW, float angleC, float angleM, float angleY, float angleK, float offCX, float offCY, float offMX, float offMY, float offYX, float offYY, float offKX, float offKY, float rotC, float rotM, float rotY, float rotK, float skewC, float skewM, float skewY, float skewK, float factorC, float factorM, float factorY, float factorK, float magZoom, float magCenterX, float magCenterY, unsigned int inFullWidth, unsigned int inFullHeight, int inOutputOriginX, int inOutputOriginY  , uint2 inXY    )\\n#line 1365 \\"C:\\\\\\\\AE\\\\\\\\Examples\\\\\\\\Effect\\\\\\\\Risograph\\\\\\\\core\\\\\\\\kernels\\\\\\\\Risograph_Kernel.cu\\"\\n{\\n    if (inXY.x >= inWidth || inXY.y >= inHeight) {\\n        return;\\n    }\\n\\n    float resW = (float)inFullWidth;\\n    float resH = (float)inFullHeight;\\n\\n    \\n    float2 outUV;\\n    outUV.x = ((float)inXY.x + (float)inOutputOriginX + 0.5f) / resW;\\n    outUV.y = ((float)inXY.y + (float)inOutputOriginY + 0.5f) / resH;\\n    float2 magCenter; magCenter.x = magCenterX; magCenter.y = magCenterY;\\n    float2 mUV = RisoMagnifyUV(outUV, magZoom, magCenter);\\n\\n    float freq         = scale;\\n    \\n\\n\\n    float blurRadius   = softness * 0.003f;\\n    int   noiseOctaves = 2 + quality;\\n    float4 specks      = RisoComputeSpecks(mUV, specksAmount, specksSize, drumAnimW);\\n\\n    \\n\\n\\n    float angles[4]   = { angleC, angleM, angleY, angleK };\\n    float offX[4]     = { offCX,  offMX,  offYX,  offKX };\\n    float offY[4]     = { offCY,  offMY,  offYY,  offKY };\\n    float plateRot[4] = { rotC,   rotM,   rotY,   rotK   };\\n    float plateSkw[4] = { skewC,  skewM,  skewY,  skewK  };\\n    float chFactor[4] = { factorC, factorM, factorY, factorK };\\n    float spk[4];\\n    spk[0] = specks.x; spk[1] = specks.y; spk[2] = specks.z; spk[3] = specks.w;\\n\\n    \\n    if (screenType != 1) {\\n        \\n\\n\\n\\n\\n\\n\\n        \\n        float2 sampleMUV = RisoFullToWindowUV(mUV, resW, resH,\\n                                               inOutputOriginX, inOutputOriginY,\\n                                               inWidth, in"}]
0x1801f2cb4=[{"size":2047,"type":"s","subtype":98,"str":"Height);\\n        float4 cmyk = RisoSampleCMYKBlurred(inSrc, sampleMUV, blurRadius,\\n                                             inSrcPitch, (int)inWidth, (int)inHeight, 0, in16f);\\n\\n        \\n        float altCellPx = fmax(resH / fmax(scale, 1.0f), 1.0f);\\n        float bayerStep = fmax(altCellPx / 8.0f, 1.0f);\\n\\n        \\n\\n\\n        float intensityScale = halftoneIntensity;\\n        \\n\\n        float aspectScale = fmax(halftoneAspect, 0.01f);\\n        \\n\\n\\n        float edgeHalf = fmax(0.0f, fmin(0.10f, dotSmoothness * 0.05f));\\n\\n        \\n        float vals[4]; vals[0] = cmyk.x; vals[1] = cmyk.y; vals[2] = cmyk.z; vals[3] = cmyk.w;\\n        float ch_out[4]; ch_out[0] = ch_out[1] = ch_out[2] = ch_out[3] = 0.0f;\\n\\n        for (int ch = 0; ch < 4; ch++) {\\n            \\n\\n\\n\\n            float2 perPlateUV = RisoApplyPlateXform(mUV, plateRot[ch], plateSkw[ch], resW, resH);\\n            perPlateUV.x += offX[ch] / resW;\\n            perPlateUV.y += offY[ch] / resH;\\n            \\n            perPlateUV.y *= aspectScale;\\n            \\n\\n\\n\\n\\n            if (distortion > 0.0f) {\\n                float2 dpos; dpos.x = floor(mUV.x * resW); dpos.y = floor(mUV.y * resH);\\n                float2 hpx; hpx.x = dpos.x + 7.1f + (float)ch * 4.3f; hpx.y = dpos.y + 13.7f;\\n                float2 hpy; hpy.x = dpos.x + 31.3f + (float)ch * 9.7f; hpy.y = dpos.y + 5.1f;\\n                float jx = RisoHash(hpx) - 0.5f;\\n                float jy = RisoHash(hpy) - 0.5f;\\n                float jScale = distortion * (altCellPx / resH);\\n                perPlateUV.x += jx * jScale;\\n                perPlateUV.y += jy * jScale;\\n            }\\n            float val = fmax(0.0f, fmin(1.0f, (vals[ch] - spk[ch]) * chFactor[ch] * intensityScale));\\n            float threshold = 0.5f;\\n\\n            \\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n            if (screenType == 2) {\\n                \\n                int ix = (int)floor(perPlateUV.x * resW / bayerStep);\\n                int iy = (int)floor(perPlateUV.y * resH / bayerStep);\\n                threshold = RisoBayer8Value(ix, iy);\\n            } else if (screenType =="}]
0x1801f34b3=[{"size":2027,"type":"s","subtype":98,"str":" 3) {\\n                \\n                float2 ppos;\\n                ppos.x = floor(perPlateUV.x * resW / bayerStep);\\n                ppos.y = floor(perPlateUV.y * resH / bayerStep);\\n                threshold = RisoPseudoBlueNoise(ppos);\\n            } else if (screenType == 4) {\\n                \\n                float ang = angles[ch];\\n                float rx = cos(ang), ry = sin(ang);\\n                float yProj = (perPlateUV.x * resW * rx + perPlateUV.y * resH * ry) / altCellPx;\\n                threshold = 0.5f + 0.5f * sin(yProj * 3.14159265f);\\n            } else if (screenType == 5) {\\n                \\n\\n                float2 ppos;\\n                ppos.x = floor(perPlateUV.x * resW);\\n                ppos.y = floor(perPlateUV.y * resH);\\n                float h0 = RisoHash(ppos);\\n                float2 ppos2; ppos2.x = ppos.x + 13.7f; ppos2.y = ppos.y + 7.3f;\\n                float h1 = RisoHash(ppos2);\\n                float adapt = 0.5f + 0.45f * (4.0f * val * (1.0f - val) - 1.0f);\\n                float oneMinusAdapt = fmax(0.0f, fmin(1.0f, 1.0f - adapt));\\n                threshold = RisoMix(0.5f, (h0 + h1) * 0.5f, oneMinusAdapt);\\n            } else if (screenType == 6) {\\n                \\n\\n\\n\\n\\n\\n\\n\\n\\n\\n                float2 ppos;\\n                ppos.x = floor(perPlateUV.x * resW);\\n                ppos.y = floor(perPlateUV.y * resH);\\n                float h = RisoHash(ppos);\\n                \\n                float liftedVal = val * val * 0.85f + val * 0.15f;\\n                \\n\\n\\n\\n\\n\\n\\n\\n                float qH = (floor(h * 3.999f) + 0.5f) * 0.25f;\\n                threshold = qH * 0.7f + liftedVal * 0.3f;\\n            } else if (screenType == 7) {\\n                \\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n                float2 ppos;\\n                ppos.x = floor(perPlateUV.x * resW);\\n                ppos.y = floor(perPlateUV.y * resH);\\n                float h0 = RisoHash(ppos);\\n                \\n                float2 pE; pE.x = ppos.x + 1.0f;  pE.y = ppos.y;\\n                float2 pSW; pSW.x = ppos.x - 1.0f; pSW.y = ppos.y + 1.0f;"}]
0x1801f3c9e=[{"size":2044,"type":"s","subtype":98,"str":"                float2 pS; pS.x = ppos.x;          pS.y = ppos.y + 1.0f;\\n                float2 pSE; pSE.x = ppos.x + 1.0f; pSE.y = ppos.y + 1.0f;\\n                \\n                float h1 = RisoHash(pE)  * (7.0f/16.0f) +\\n                           RisoHash(pSW) * (3.0f/16.0f) +\\n                           RisoHash(pS)  * (5.0f/16.0f) +\\n                           RisoHash(pSE) * (1.0f/16.0f);\\n                \\n\\n\\n                threshold = h0 * 0.4f + h1 * 0.6f;\\n            }\\n\\n            \\n\\n            if (edgeHalf > 0.0001f) {\\n                float lo = (1.0f - val) - edgeHalf;\\n                float hi = (1.0f - val) + edgeHalf;\\n                ch_out[ch] = RisoSmoothstep(lo, hi, threshold);\\n            } else {\\n                ch_out[ch] = RisoStep(1.0f - val, threshold);\\n            }\\n        }\\n\\n        float4 outF; outF.x = ch_out[0]; outF.y = ch_out[1];\\n        outF.z = ch_out[2]; outF.w = ch_out[3];\\n        WriteFloat4(outF, outDst, inXY.y * inDstPitch + inXY.x, !!in16f);\\n        return;\\n    }\\n\\n    \\n    \\n    float cellPx = resH / fmax(scale, 1.0f);\\n    float randomness = RisoMix(0.45f, 0.25f, RisoSmoothstep(2.0f, 6.0f, cellPx));\\n\\n    \\n    float pxX = 1.0f / resW;\\n    float pxY = 1.0f / resH;\\n\\n    float result_ch[4]; result_ch[0] = result_ch[1] = result_ch[2] = result_ch[3] = 0.0f;\\n\\n    for (int ch = 0; ch < 4; ch++) {\\n        float angle  = angles[ch];\\n        float fX     = offX[ch];\\n        float fY     = offY[ch];\\n        float factor = chFactor[ch];\\n        float pRot   = plateRot[ch];\\n        float pSkw   = plateSkw[ch];\\n\\n        \\n        float2 gridPos = RisoComputeGridPos(mUV, pRot, pSkw,\\n                                              angle, fX, fY,\\n                                              freq, halftoneAspect,\\n                                              resW, resH);\\n\\n        \\n\\n\\n\\n\\n\\n\\n        float2 gridDistortOff; gridDistortOff.x = 0.0f; gridDistortOff.y = 0.0f;\\n        if (distortion > 0.0f) {\\n            float dist01 = distortion;\\n            float w = 2.49f + 7.0f * (float)ch + drumAnimW;"}]
0x1801f449a=[{"size":2047,"type":"s","subtype":98,"str":"            float3 p1; p1.x = gridPos.x * 0.5f;        p1.y = gridPos.y * 0.5f;        p1.z = w;\\n            float3 p2; p2.x = gridPos.x * 0.5f + 5.2f; p2.y = gridPos.y * 0.5f + 1.3f; p2.z = w;\\n            float n1 = RisoFBM3D(p1, noiseOctaves) - 0.5f;\\n            float n2 = RisoFBM3D(p2, noiseOctaves) - 0.5f;\\n            gridDistortOff.x = n1 * dist01 * 0.30f;\\n            gridDistortOff.y = n2 * dist01 * 0.30f;\\n            gridPos.x += gridDistortOff.x;\\n            gridPos.y += gridDistortOff.y;\\n        }\\n\\n        \\n        float v1Dist; float2 v1Center;\\n        float2 gp = gridPos;\\n        RisoVoronoiCell(gp, dotShape, randomness,\\n                        (&v1Dist), (&v1Center));\\n\\n        float v2Dist; float2 v2Center;\\n        float2 gp2; gp2.x = gridPos.x + 20.0f; gp2.y = gridPos.y;\\n        RisoVoronoiCell(gp2, dotShape, randomness,\\n                        (&v2Dist), (&v2Center));\\n\\n        \\n        float2 cellUV1 = RisoGridToUV(v1Center, pRot, pSkw, angle, fX, fY,\\n                                        freq, halftoneAspect, resW, resH);\\n        float2 v2CenterAdj; v2CenterAdj.x = v2Center.x - 20.0f; v2CenterAdj.y = v2Center.y;\\n        float2 cellUV2 = RisoGridToUV(v2CenterAdj, pRot, pSkw, angle, fX, fY,\\n                                        freq, halftoneAspect, resW, resH);\\n\\n        float2 cellSampleUV1 = RisoFullToWindowUV(cellUV1, resW, resH,\\n                                                   inOutputOriginX, inOutputOriginY,\\n                                                   inWidth, inHeight);\\n        float2 cellSampleUV2 = RisoFullToWindowUV(cellUV2, resW, resH,\\n                                                   inOutputOriginX, inOutputOriginY,\\n                                                   inWidth, inHeight);\\n        float4 cmyk1 = RisoSampleCMYKBlurred(inSrc, cellSampleUV1, blurRadius,\\n                                                inSrcPitch, (int)inWidth, (int)inHeight, 0, in16f);\\n        float4 cmyk2 = RisoSampleCMYKBlurred(inSrc, cellSampleUV2, blurRadius,\\n                                  "}]
0x1801f4c99=[{"size":2047,"type":"s","subtype":98,"str":"              inSrcPitch, (int)inWidth, (int)inHeight, 0, in16f);\\n\\n        float ch1 = (ch == 0) ? cmyk1.x : (ch == 1) ? cmyk1.y : (ch == 2) ? cmyk1.z : cmyk1.w;\\n        float ch2 = (ch == 0) ? cmyk2.x : (ch == 1) ? cmyk2.y : (ch == 2) ? cmyk2.z : cmyk2.w;\\n\\n        float val1 = fmax(ch1 - spk[ch], 0.0f);\\n        float val2 = fmax(ch2 - spk[ch], 0.0f);\\n\\n        \\n\\n\\n        float ssScale = (magZoom > 1.001f) ? (1.0f / magZoom) : 1.0f;\\n        float2 g_offsets[4];\\n        float dx[4] = { -0.25f,  0.25f, -0.25f,  0.25f };\\n        float dy[4] = { -0.25f, -0.25f,  0.25f,  0.25f };\\n        for (int s = 0; s < 4; s++) {\\n            float2 ssUV;\\n            ssUV.x = mUV.x + dx[s] * pxX * ssScale;\\n            ssUV.y = mUV.y + dy[s] * pxY * ssScale;\\n            float2 g = RisoComputeGridPos(ssUV, pRot, pSkw, angle, fX, fY,\\n                                            freq, halftoneAspect, resW, resH);\\n            g.x += gridDistortOff.x;\\n            g.y += gridDistortOff.y;\\n            g_offsets[s] = g;\\n        }\\n\\n        float dot1 = 0.25f * (\\n            RisoUnionDotInk(g_offsets[0], dotShape, randomness, val1, factor, halftoneIntensity, dotSmoothness) +\\n            RisoUnionDotInk(g_offsets[1], dotShape, randomness, val1, factor, halftoneIntensity, dotSmoothness) +\\n            RisoUnionDotInk(g_offsets[2], dotShape, randomness, val1, factor, halftoneIntensity, dotSmoothness) +\\n            RisoUnionDotInk(g_offsets[3], dotShape, randomness, val1, factor, halftoneIntensity, dotSmoothness));\\n\\n        \\n        float2 g0_2, g1_2, g2_2, g3_2;\\n        g0_2.x = g_offsets[0].x + 20.0f; g0_2.y = g_offsets[0].y;\\n        g1_2.x = g_offsets[1].x + 20.0f; g1_2.y = g_offsets[1].y;\\n        g2_2.x = g_offsets[2].x + 20.0f; g2_2.y = g_offsets[2].y;\\n        g3_2.x = g_offsets[3].x + 20.0f; g3_2.y = g_offsets[3].y;\\n        float dot2 = 0.25f * (\\n            RisoUnionDotInk(g0_2, dotShape, randomness, val2, factor, halftoneIntensity, dotSmoothness) +\\n            RisoUnionDotInk(g1_2, dotShape, randomness, val2, factor, halftoneIntensity, dotS"}]
0x1801f5498=[{"size":2044,"type":"s","subtype":98,"str":"moothness) +\\n            RisoUnionDotInk(g2_2, dotShape, randomness, val2, factor, halftoneIntensity, dotSmoothness) +\\n            RisoUnionDotInk(g3_2, dotShape, randomness, val2, factor, halftoneIntensity, dotSmoothness));\\n\\n        result_ch[ch] = fmax(0.0f, fmin(1.0f, dot1 + dot2));\\n    }\\n\\n    float4 outVal;\\n    outVal.x = result_ch[0];\\n    outVal.y = result_ch[1];\\n    outVal.z = result_ch[2];\\n    outVal.w = result_ch[3];\\n    WriteFloat4(outVal, outDst, inXY.y * inDstPitch + inXY.x, !!in16f);\\n}\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\nstatic __inline__ void RisoHaloKernel_Delegate( __global const float4* inSrc, __global float4* outDst  , int inSrcPitch, int inDstPitch, int in16f, unsigned int inWidth, unsigned int inHeight, float directionX, float directionY, float haloRadius  , uint2 inXY    ); __kernel void RisoHaloKernel( __global const float4* inSrc, __global float4* outDst  , int inSrcPitch, int inDstPitch, int in16f, unsigned int inWidth, unsigned int inHeight, float directionX, float directionY, float haloRadius  ) {   RisoHaloKernel_Delegate( inSrc, outDst  , inSrcPitch, inDstPitch, in16f, inWidth, inHeight, directionX, directionY, haloRadius  , KernelXYUnsigned()    ); } static __inline__ void RisoHaloKernel_Delegate( __global const float4* inSrc, __global float4* outDst  , int inSrcPitch, int inDstPitch, int in16f, unsigned int inWidth, unsigned int inHeight, float directionX, float directionY, float haloRadius  , uint2 inXY    )\\n#line 1733 \\"C:\\\\\\\\AE\\\\\\\\Examples\\\\\\\\Effect\\\\\\\\Risograph\\\\\\\\core\\\\\\\\kernels\\\\\\\\Risograph_Kernel.cu\\"\\n{\\n    if (inXY.x >= inWidth || inXY.y >= inHeight) {\\n        return;\\n    }\\n    \\n    float w0 = 0.20416368871516756f;\\n    float w1 = 0.18017382291138086f;\\n    float w2 = 0.12383154862992032f;\\n    float w3 = 0.06628224528792877f;\\n    float w4 = 0.02763055259194701f;\\n\\n    \\n    float stepScale = fmax(haloRadius * 0.25f, 0.5f);\\n    float sx = directionX * stepScale;\\n    float sy = directionY * stepScale;\\n\\n    int cx = (int)inXY.x;\\n    int cy = (int)inXY.y;\\n\\n    \\n    \\n\\n\\n\\n\\n\\n\\n\\n    float4 c, p1, n1, p2, n2, p3, n3, p4, n4;"}]
0x1801f5c94=[{"size":2047,"type":"s","subtype":98,"str":"    do { int x = (int)((float)cx + sx * (float)(0) + 0.5f); int y = (int)((float)cy + sy * (float)(0) + 0.5f); if (x < 0) x = 0; if (x >= (int)inWidth) x = (int)inWidth - 1; if (y < 0) y = 0; if (y >= (int)inHeight) y = (int)inHeight - 1; c = ReadFloat4(inSrc, y * inSrcPitch + x, !!in16f); } while (0);\\n    do { int x = (int)((float)cx + sx * (float)(1) + 0.5f); int y = (int)((float)cy + sy * (float)(1) + 0.5f); if (x < 0) x = 0; if (x >= (int)inWidth) x = (int)inWidth - 1; if (y < 0) y = 0; if (y >= (int)inHeight) y = (int)inHeight - 1; p1 = ReadFloat4(inSrc, y * inSrcPitch + x, !!in16f); } while (0); do { int x = (int)((float)cx + sx * (float)(-1) + 0.5f); int y = (int)((float)cy + sy * (float)(-1) + 0.5f); if (x < 0) x = 0; if (x >= (int)inWidth) x = (int)inWidth - 1; if (y < 0) y = 0; if (y >= (int)inHeight) y = (int)inHeight - 1; n1 = ReadFloat4(inSrc, y * inSrcPitch + x, !!in16f); } while (0);\\n    do { int x = (int)((float)cx + sx * (float)(2) + 0.5f); int y = (int)((float)cy + sy * (float)(2) + 0.5f); if (x < 0) x = 0; if (x >= (int)inWidth) x = (int)inWidth - 1; if (y < 0) y = 0; if (y >= (int)inHeight) y = (int)inHeight - 1; p2 = ReadFloat4(inSrc, y * inSrcPitch + x, !!in16f); } while (0); do { int x = (int)((float)cx + sx * (float)(-2) + 0.5f); int y = (int)((float)cy + sy * (float)(-2) + 0.5f); if (x < 0) x = 0; if (x >= (int)inWidth) x = (int)inWidth - 1; if (y < 0) y = 0; if (y >= (int)inHeight) y = (int)inHeight - 1; n2 = ReadFloat4(inSrc, y * inSrcPitch + x, !!in16f); } while (0);\\n    do { int x = (int)((float)cx + sx * (float)(3) + 0.5f); int y = (int)((float)cy + sy * (float)(3) + 0.5f); if (x < 0) x = 0; if (x >= (int)inWidth) x = (int)inWidth - 1; if (y < 0) y = 0; if (y >= (int)inHeight) y = (int)inHeight - 1; p3 = ReadFloat4(inSrc, y * inSrcPitch + x, !!in16f); } while (0); do { int x = (int)((float)cx + sx * (float)(-3) + 0.5f); int y = (int)((float)cy + sy * (float)(-3) + 0.5f); if (x < 0) x = 0; if (x >= (int)inWidth) x = (int)inWidth - 1; if (y < 0) y = 0; if (y >= (int)inHeight) y = (int"}]
0x1801f6493=[{"size":2047,"type":"s","subtype":98,"str":")inHeight - 1; n3 = ReadFloat4(inSrc, y * inSrcPitch + x, !!in16f); } while (0);\\n    do { int x = (int)((float)cx + sx * (float)(4) + 0.5f); int y = (int)((float)cy + sy * (float)(4) + 0.5f); if (x < 0) x = 0; if (x >= (int)inWidth) x = (int)inWidth - 1; if (y < 0) y = 0; if (y >= (int)inHeight) y = (int)inHeight - 1; p4 = ReadFloat4(inSrc, y * inSrcPitch + x, !!in16f); } while (0); do { int x = (int)((float)cx + sx * (float)(-4) + 0.5f); int y = (int)((float)cy + sy * (float)(-4) + 0.5f); if (x < 0) x = 0; if (x >= (int)inWidth) x = (int)inWidth - 1; if (y < 0) y = 0; if (y >= (int)inHeight) y = (int)inHeight - 1; n4 = ReadFloat4(inSrc, y * inSrcPitch + x, !!in16f); } while (0);\\n\\n    float4 sum;\\n    sum.x = c.x*w0 + (p1.x+n1.x)*w1 + (p2.x+n2.x)*w2 + (p3.x+n3.x)*w3 + (p4.x+n4.x)*w4;\\n    sum.y = c.y*w0 + (p1.y+n1.y)*w1 + (p2.y+n2.y)*w2 + (p3.y+n3.y)*w3 + (p4.y+n4.y)*w4;\\n    sum.z = c.z*w0 + (p1.z+n1.z)*w1 + (p2.z+n2.z)*w2 + (p3.z+n3.z)*w3 + (p4.z+n4.z)*w4;\\n    sum.w = c.w*w0 + (p1.w+n1.w)*w1 + (p2.w+n2.w)*w2 + (p3.w+n3.w)*w3 + (p4.w+n4.w)*w4;\\n\\n    WriteFloat4(sum, outDst, inXY.y * inDstPitch + inXY.x, !!in16f);\\n    \\n}\\n\\n\\n\\n\\n\\n\\n\\n\\n\\ninline float3 RisoSoftLight(float3 base, float light)\\n{\\n    float3 r;\\n    \\n\\n    float bx = base.x, by = base.y, bz = base.z;\\n    float l = light;\\n    float fx, fy, fz;\\n    if (l <= 0.5f) {\\n        fx = bx - (1.0f - 2.0f * l) * (bx - bx * bx);\\n        fy = by - (1.0f - 2.0f * l) * (by - by * by);\\n        fz = bz - (1.0f - 2.0f * l) * (bz - bz * bz);\\n    } else {\\n        fx = bx + (2.0f * l - 1.0f) * (sqrt(fmax(bx, 0.0f)) - bx);\\n        fy = by + (2.0f * l - 1.0f) * (sqrt(fmax(by, 0.0f)) - by);\\n        fz = bz + (2.0f * l - 1.0f) * (sqrt(fmax(bz, 0.0f)) - bz);\\n    }\\n    r.x = fx; r.y = fy; r.z = fz;\\n    return r;\\n}\\n\\n\\n\\ninline float3 RisoSoftLight3(float3 base, float3 light)\\n{\\n    float3 r;\\n    \\n    float bx = base.x, by = base.y, bz = base.z;\\n    float lx = light.x, ly = light.y, lz = light.z;\\n    float fx_lo = bx - (1.0f - 2.0f * lx) * (bx - bx * bx);\\n    float fy_lo = by - (1.0f - 2.0f * ly)"}]
0x1801f6c92=[{"size":2019,"type":"s","subtype":98,"str":" * (by - by * by);\\n    float fz_lo = bz - (1.0f - 2.0f * lz) * (bz - bz * bz);\\n    float fx_hi = bx + (2.0f * lx - 1.0f) * (sqrt(fmax(bx, 0.0f)) - bx);\\n    float fy_hi = by + (2.0f * ly - 1.0f) * (sqrt(fmax(by, 0.0f)) - by);\\n    float fz_hi = bz + (2.0f * lz - 1.0f) * (sqrt(fmax(bz, 0.0f)) - bz);\\n    r.x = (lx >= 0.5f) ? fx_hi : fx_lo;\\n    r.y = (ly >= 0.5f) ? fy_hi : fy_lo;\\n    r.z = (lz >= 0.5f) ? fz_hi : fz_lo;\\n    return r;\\n}\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\ninline float3 RisoArtificialLamp(float3 pos, float3 color, float intensity,\\n                                  float radius, float3 normal,\\n                                  float2 uv, float3 img)\\n{\\n    float2 shifted; shifted.x = uv.x - pos.x; shifted.y = uv.y - pos.y;\\n    float scaleAtten = 1.0f - fmax(0.0f, fmin(1.0f, radius));\\n    float2 scaled; scaled.x = shifted.x * scaleAtten; scaled.y = shifted.y * scaleAtten;\\n    float len = sqrt(scaled.x * scaled.x + scaled.y * scaled.y);\\n    float rSph = fmax(1.0f - len, 0.0f);\\n    float grad = rSph * rSph;\\n    float lit  = normal.x * pos.x + normal.y * pos.y + normal.z * pos.z;\\n    float fac  = fmax(lit, 0.0f) * grad * intensity;\\n    float3 r;\\n    r.x = fac * img.x * color.x;\\n    r.y = fac * img.y * color.y;\\n    r.z = fac * img.z * color.z;\\n    return r;\\n}\\n\\n\\ninline float3 RisoNormalize3(float3 v)\\n{\\n    float len = sqrt(v.x * v.x + v.y * v.y + v.z * v.z);\\n    if (len < 1e-9f) {\\n        float3 r; r.x = 0.0f; r.y = 0.0f; r.z = 1.0f;\\n        return r;\\n    }\\n    float3 r; r.x = v.x / len; r.y = v.y / len; r.z = v.z / len;\\n    return r;\\n}\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\ninline float RisoSampleOriginalAlpha(__global const float4* original,\\n                                     float2 fullUV,\\n                                     float fullW, float fullH,\\n                                     int outputOriginX, int outputOriginY,\\n                                     int width, int height,\\n                                     int pitch, int basePixel, int is16f)\\n{\\n    int x = (int)floor(fullUV.x * fullW - 0.5f) - outputOriginX;"}]
0x1801f7475=[{"size":2020,"type":"s","subtype":98,"str":"    int y = (int)floor(fullUV.y * fullH - 0.5f) - outputOriginY;\\n    if (x < 0) x = 0; if (x >= width) x = width - 1;\\n    if (y < 0) y = 0; if (y >= height) y = height - 1;\\n    return ReadFloat4(original, basePixel + y * pitch + x, !!is16f).w;\\n}\\n\\n\\n\\n\\ninline float4 RisoSampleProofCoverage(\\n    __global const float4* halftone,\\n    __global const float4* halo,\\n    float2 sampleUV, float2 wearUV,\\n    float resW, float resH,\\n    int outputOriginX, int outputOriginY,\\n    int width, int height, int srcPitch, int haloPitch, int is16f,\\n    int impressions, float impressionJitter,\\n    float haloRadius, float haloIntensity,\\n    float ghostOffsetX, float ghostOffsetY, float ghostOpacity,\\n    float inkIntensity, float multiplyK,\\n    float plateMaskC, float plateMaskM, float plateMaskY, float plateMaskK,\\n    float dotGain,\\n    float inkCurveC, float inkCurveM, float inkCurveY, float inkCurveK,\\n    float rollerAmount, float rollerFreq, float rollerAngleRad)\\n{\\n    float4 dots;\\n    float2 windowUV = RisoFullToWindowUV(sampleUV, resW, resH,\\n                                          outputOriginX, outputOriginY,\\n                                          (unsigned int)width, (unsigned int)height);\\n    if (impressions <= 1 || impressionJitter < 0.001f) {\\n        dots = RisoSampleCMYKBlurred(halftone, windowUV, 0.0f,\\n                                     srcPitch, width, height, 0, is16f);\\n    } else {\\n        float4 transmittance;\\n        transmittance.x = 1.0f; transmittance.y = 1.0f;\\n        transmittance.z = 1.0f; transmittance.w = 1.0f;\\n        const float jitterPx = impressionJitter * 2.0f;\\n        for (int i = 0; i < 3; ++i) {\\n            if (i >= impressions) break;\\n            float2 jitterUV = sampleUV;\\n            if (i != 0) {\\n                const float fi = (float)i;\\n                float2 hxArg; hxArg.x = fi * 13.7f + 5.1f; hxArg.y = 7.3f;\\n                float2 hyArg; hyArg.x = fi * 17.9f + 2.1f; hyArg.y = 11.5f;\\n                jitterUV.x += (RisoHash(hxArg) - 0.5f) * 2.0f * jitterPx / resW;"}]
0x1801f7c59=[{"size":2041,"type":"s","subtype":98,"str":"                jitterUV.y += (RisoHash(hyArg) - 0.5f) * 2.0f * jitterPx / resH;\\n            }\\n            float2 jitterWindowUV = RisoFullToWindowUV(jitterUV, resW, resH,\\n                                                        outputOriginX, outputOriginY,\\n                                                        (unsigned int)width, (unsigned int)height);\\n            float4 d = RisoSampleCMYKBlurred(halftone, jitterWindowUV, 0.0f,\\n                                             srcPitch, width, height, 0, is16f);\\n            transmittance.x *= 1.0f - d.x; transmittance.y *= 1.0f - d.y;\\n            transmittance.z *= 1.0f - d.z; transmittance.w *= 1.0f - d.w;\\n        }\\n        dots.x = RisoClamp01(1.0f - transmittance.x);\\n        dots.y = RisoClamp01(1.0f - transmittance.y);\\n        dots.z = RisoClamp01(1.0f - transmittance.z);\\n        dots.w = RisoClamp01(1.0f - transmittance.w);\\n    }\\n\\n    if (haloRadius > 0.001f && haloIntensity > 0.001f) {\\n        float4 haloDots = RisoSampleCMYKBlurred(halo, windowUV, 0.0f,\\n                                                haloPitch, width, height, 0, is16f);\\n        haloDots.x *= haloIntensity; haloDots.y *= haloIntensity;\\n        haloDots.z *= haloIntensity; haloDots.w *= haloIntensity;\\n        if (haloDots.x > dots.x) dots.x = haloDots.x;\\n        if (haloDots.y > dots.y) dots.y = haloDots.y;\\n        if (haloDots.z > dots.z) dots.z = haloDots.z;\\n        if (haloDots.w > dots.w) dots.w = haloDots.w;\\n    }\\n\\n    if (ghostOpacity > 0.001f) {\\n        float2 ghostUV;\\n        ghostUV.x = sampleUV.x + ghostOffsetX / resW;\\n        ghostUV.y = sampleUV.y + ghostOffsetY / resH;\\n        float2 ghostWindowUV = RisoFullToWindowUV(ghostUV, resW, resH,\\n                                                   outputOriginX, outputOriginY,\\n                                                   (unsigned int)width, (unsigned int)height);\\n        float4 ghostDots = RisoSampleCMYKBlurred(halftone, ghostWindowUV, 0.0f,\\n                                                 srcPitch, width, height, 0, is16f);"}]
0x1801f8452=[{"size":2047,"type":"s","subtype":98,"str":"        ghostDots.x *= ghostOpacity; ghostDots.y *= ghostOpacity;\\n        ghostDots.z *= ghostOpacity; ghostDots.w *= ghostOpacity;\\n        if (ghostDots.x > dots.x) dots.x = ghostDots.x;\\n        if (ghostDots.y > dots.y) dots.y = ghostDots.y;\\n        if (ghostDots.z > dots.z) dots.z = ghostDots.z;\\n        if (ghostDots.w > dots.w) dots.w = ghostDots.w;\\n    }\\n\\n    float4 coverage;\\n    coverage.x = RisoClamp01(dots.x * inkIntensity) * plateMaskC;\\n    coverage.y = RisoClamp01(dots.y * inkIntensity) * plateMaskM;\\n    coverage.z = RisoClamp01(dots.z * inkIntensity) * plateMaskY;\\n    coverage.w = RisoClamp01(dots.w * inkIntensity * multiplyK) * plateMaskK;\\n    if (dotGain > 1.001f) {\\n        const float invGain = 1.0f / dotGain;\\n        coverage.x = pow(coverage.x, invGain); coverage.y = pow(coverage.y, invGain);\\n        coverage.z = pow(coverage.z, invGain); coverage.w = pow(coverage.w, invGain);\\n    }\\n\\n    if (fabs(inkCurveC - 1.0f) > 0.005f || fabs(inkCurveM - 1.0f) > 0.005f ||\\n        fabs(inkCurveY - 1.0f) > 0.005f || fabs(inkCurveK - 1.0f) > 0.005f) {\\n        coverage.x = pow(fmax(coverage.x, 0.0f), 1.0f / fmax(inkCurveC, 0.001f));\\n        coverage.y = pow(fmax(coverage.y, 0.0f), 1.0f / fmax(inkCurveM, 0.001f));\\n        coverage.z = pow(fmax(coverage.z, 0.0f), 1.0f / fmax(inkCurveY, 0.001f));\\n        coverage.w = pow(fmax(coverage.w, 0.0f), 1.0f / fmax(inkCurveK, 0.001f));\\n    }\\n\\n    if (rollerAmount > 0.001f) {\\n        const float bandCoord = wearUV.y * cos(rollerAngleRad) -\\n                                wearUV.x * sin(rollerAngleRad);\\n        float2 bp; bp.x = bandCoord * rollerFreq; bp.y = 0.0f;\\n        const float modulator = 1.0f + (RisoFBM(bp, 3) - 0.5f) * rollerAmount;\\n        coverage.x = RisoClamp01(coverage.x * modulator);\\n        coverage.y = RisoClamp01(coverage.y * modulator);\\n        coverage.z = RisoClamp01(coverage.z * modulator);\\n        coverage.w = RisoClamp01(coverage.w * modulator);\\n    }\\n    return coverage;\\n}\\n\\n\\n\\n\\nstatic __inline__ void RisoPass3Kernel_Delegate( __global const float4* in"}]
