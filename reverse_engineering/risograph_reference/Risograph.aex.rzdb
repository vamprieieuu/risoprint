0x1801cfb0c=[{"size":130,"type":"s","subtype":56,"str":" Fluor Pink saturates fast, Federal Blue is more linear.\\nuniform vec4 inkCurve;              // C, M, Y, K  (0.5..2.0 each)\\n\\n// F-"}]
0x1801cfb94=[{"size":372,"type":"s","subtype":56,"str":" Multi-press / sequential impressions. impressions=1 (default)\\n// runs the ink mixing once with no jitter. >1 samples the halftone N\\n// times at jittered UVs and combines multiplicatively in transmittance\\n// space, simulating drum slip on re-feed.\\nuniform int   impressions;          // 1..3\\nuniform float impressionJitter;     // 0..1 (slider stored as 0..100/100)\\n\\n// F-"}]
0x1801cfd0e=[{"size":56,"type":"s","subtype":56,"str":" Per-render ink personality drift. inkDrift=0 (default) "}]
0x1801cfd49=[{"size":357,"type":"s","subtype":56,"str":" no\\n// drift, frame-stable inks. >0 introduces a per-frame hue shift on each\\n// ink colour seeded by frameTime (in seconds since comp start), giving\\n// the print-to-print drift seen on real Riso machines as ink mixes.\\nuniform float inkDrift;             // 0..1 (slider /100)\\nuniform float frameTime;            // seconds (current_time / time_scale)\\n\\n// F-"}]
0x1801cfeb4=[{"size":210,"type":"s","subtype":56,"str":" Reverse-print mode. 0 = off (default, normal dark-on-light print).\\n// 1 = invert ink-paper composite at end of Pass 3 BEFORE output gamma +\\n// lighting, so lighting still reads correctly on the inverted image "}]
