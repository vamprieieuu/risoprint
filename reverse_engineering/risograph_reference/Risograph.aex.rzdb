0x1801d78e0=[{"size":116,"type":"s","subtype":56,"str":" NTCMYK Mix.\\n    // We compute final-ink colors once, then do a single MULTIPLY chain.\\n    //\\n    //   (a) Ink Fade "}]
0x1801d7957=[{"size":124,"type":"s","subtype":56,"str":" per-channel toward white (+ K slightly toward C first),\\n    //       matching NTInkFade rates (C=0.3, M=0.95, Y=0.8, K=0.33"}]
