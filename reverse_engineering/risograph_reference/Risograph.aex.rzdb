a.z*(1.0f-ty) + sb.z*ty; d.w = sa.w*(1.0f-ty) + sb.w*ty; } while (0);\\n        float4 r;"}]
0x1801edd06=[{"size":2020,"type":"s","subtype":98,"str":"        r.x = (a.x + b.x + c.x + d.x) * 0.25f;\\n        r.y = (a.y + b.y + c.y + d.y) * 0.25f;\\n        r.z = (a.z + b.z + c.z + d.z) * 0.25f;\\n        r.w = (a.w + b.w + c.w + d.w) * 0.25f;\\n        return r;\\n    }\\n    float4 r;\\n    do { float fx = (centerUV.x) * (float)width - 0.5f; float fy = (centerUV.y) * (float)height - 0.5f; int x0 = (int)floor(fx); int y0 = (int)floor(fy); float tx = fx - (float)x0; float ty = fy - (float)y0; int x1 = x0 + 1; int y1 = y0 + 1; if (x0 < 0) x0 = 0; if (x0 >= width) x0 = width - 1; if (x1 < 0) x1 = 0; if (x1 >= width) x1 = width - 1; if (y0 < 0) y0 = 0; if (y0 >= height) y0 = height - 1; if (y1 < 0) y1 = 0; if (y1 >= height) y1 = height - 1; int row0 = basePixel + y0 * srcPitch; int row1 = basePixel + y1 * srcPitch; float4 s00 = ReadFloat4(cmykTex, row0 + x0, !!is16f); float4 s10 = ReadFloat4(cmykTex, row0 + x1, !!is16f); float4 s01 = ReadFloat4(cmykTex, row1 + x0, !!is16f); float4 s11 = ReadFloat4(cmykTex, row1 + x1, !!is16f); float omt = 1.0f - tx; float4 sa, sb; sa.x = s00.x*omt + s10.x*tx; sa.y = s00.y*omt + s10.y*tx; sa.z = s00.z*omt + s10.z*tx; sa.w = s00.w*omt + s10.w*tx; sb.x = s01.x*omt + s11.x*tx; sb.y = s01.y*omt + s11.y*tx; sb.z = s01.z*omt + s11.z*tx; sb.w = s01.w*omt + s11.w*tx; r.x = sa.x*(1.0f-ty) + sb.x*ty; r.y = sa.y*(1.0f-ty) + sb.y*ty; r.z = sa.z*(1.0f-ty) + sb.z*ty; r.w = sa.w*(1.0f-ty) + sb.w*ty; } while (0);\\n    return r;\\n    \\n}\\n\\n\\n\\n\\ninline float RisoBayer8Value(int px, int py)\\n{\\n    int x = px & 7, y = py & 7;\\n    int v = 0;\\n    v |= ((y >> 2) & 1); v <<= 1;\\n    v |= ((x >> 2) & 1); v <<= 1;\\n    v |= ((y >> 1) & 1); v <<= 1;\\n    v |= ((x >> 1) & 1); v <<= 1;\\n    v |= ( y       & 1); v <<= 1;\\n    v |=   x       & 1;\\n    return (float)v / 64.0f;\\n}\\n\\n\\n\\n\\n\\ninline float RisoPseudoBlueNoise(float2 cellPos)\\n{\\n    float h0 = RisoHash(cellPos);\\n    float2 cp1; cp1.x = cellPos.x + 13.7f; cp1.y = cellPos.y + 7.3f;\\n    float h1 = RisoHash(cp1);\\n    float2 cp2; cp2.x = cellPos.x - 5.1f;  cp2.y = cellPos.y - 17.9f;\\n    float h2 = RisoHash(cp2);"}]
0x1801ee4ea=[{"size":2038,"type":"s","subtype":98,"str":"    float v = (h0 + h1 + h2) / 3.0f;\\n    return fmax(0.0f, fmin(1.0f, v));\\n}\\n\\ninline float RisoClamp01(float v)\\n{\\n    return fmax(0.0f, fmin(1.0f, v));\\n}\\n\\ninline float RisoLuma3(float3 c)\\n{\\n    return c.x * 0.2126f + c.y * 0.7152f + c.z * 0.0722f;\\n}\\n\\ninline float3 RisoUnpremulHostPixelToRgbWorking(float4 src, int hostPixelLayout,\\n                                                int colorSpaceMode)\\n{\\n    float3 rgb = RisoUnpremulHostPixelToRgb(src, hostPixelLayout);\\n    rgb = RisoClampF3(rgb);\\n    if (colorSpaceMode == 2) {\\n        rgb = RisoSrgbToLinear3(rgb);\\n    }\\n    return rgb;\\n}\\n\\ninline float RisoLineArtMask(float centerLuma, float edgeContrast,\\n                             float threshold, float strength)\\n{\\n    threshold = RisoClamp01(threshold);\\n    strength = RisoClamp01(strength);\\n    float darkMask = RisoClamp01((threshold - centerLuma) * 4.0f);\\n    float edgeStart = 0.18f - threshold * 0.10f;\\n    float edgeMask = RisoClamp01((edgeContrast - edgeStart) * 5.0f);\\n    return RisoClamp01(fmax(darkMask, edgeMask) * strength);\\n}\\n\\ninline int RisoLineArtTargetChannel(int lineArtPlate, int colorMode, int spotPlateCount)\\n{\\n    if (lineArtPlate == 1) {\\n        return -1;\\n    }\\n\\n    int target = 3;\\n    if (lineArtPlate >= 3 && lineArtPlate <= 6) {\\n        target = lineArtPlate - 3;\\n    }\\n\\n    if (colorMode == 2) {\\n        int maxActive = spotPlateCount - 1;\\n        if (maxActive < 1) maxActive = 1;\\n        if (maxActive > 3) maxActive = 3;\\n        if (target > maxActive) target = maxActive;\\n    }\\n\\n    if (target < 0) target = 0;\\n    if (target > 3) target = 3;\\n    return target;\\n}\\n\\ninline float4 RisoApplyLineArt(float4 outColor, float lineMask,\\n                               int lineArtPlate, int colorMode, int spotPlateCount)\\n{\\n    int target = RisoLineArtTargetChannel(lineArtPlate, colorMode, spotPlateCount);\\n    if (target < 0 || lineMask <= 0.0f) {\\n        return outColor;\\n    }\\n\\n    if (target == 0) outColor.x = fmax(outColor.x, lineMask);\\n    if (target == 1) outColor.y = fmax(outColor.y, lineMask);"}]
0x1801eece0=[{"size":2025,"type":"s","subtype":98,"str":"    if (target == 2) outColor.z = fmax(outColor.z, lineMask);\\n    if (target == 3) outColor.w = fmax(outColor.w, lineMask);\\n    return outColor;\\n}\\n\\ninline float RisoDot3(float3 a, float3 b)\\n{\\n    return a.x*b.x + a.y*b.y + a.z*b.z;\\n}\\n\\ninline float3 RisoSpotResidual(float3 target,\\n                               float3 a0, float d0,\\n                               float3 a1, float d1,\\n                               float3 a2, float d2,\\n                               float3 a3, float d3)\\n{\\n    float3 r;\\n    r.x = target.x - d0*a0.x - d1*a1.x - d2*a2.x - d3*a3.x;\\n    r.y = target.y - d0*a0.y - d1*a1.y - d2*a2.y - d3*a3.y;\\n    r.z = target.z - d0*a0.z - d1*a1.z - d2*a2.z - d3*a3.z;\\n    return r;\\n}\\n\\ninline float RisoSpotCoordUpdate(float3 target, float3 axis, float current,\\n                                 float3 a0, float d0,\\n                                 float3 a1, float d1,\\n                                 float3 a2, float d2,\\n                                 float3 a3, float d3)\\n{\\n    float3 r = RisoSpotResidual(target, a0, d0, a1, d1, a2, d2, a3, d3);\\n    r.x += current * axis.x;\\n    r.y += current * axis.y;\\n    r.z += current * axis.z;\\n    return RisoClamp01(RisoDot3(axis, r) / fmax(RisoDot3(axis, axis), 1e-3f));\\n}\\n\\ninline float4 RisoSpotGreedyDecompose(float3 target,\\n                                      float3 a0, float3 a1, float3 a2, float3 a3,\\n                                      int spotPlateCount)\\n{\\n    float d0 = RisoClamp01(RisoDot3(a0, target) / fmax(RisoDot3(a0, a0), 1e-3f));\\n    target.x = fmax(0.0f, target.x - d0 * a0.x);\\n    target.y = fmax(0.0f, target.y - d0 * a0.y);\\n    target.z = fmax(0.0f, target.z - d0 * a0.z);\\n\\n    float d1 = RisoClamp01(RisoDot3(a1, target) / fmax(RisoDot3(a1, a1), 1e-3f));\\n    target.x = fmax(0.0f, target.x - d1 * a1.x);\\n    target.y = fmax(0.0f, target.y - d1 * a1.y);\\n    target.z = fmax(0.0f, target.z - d1 * a1.z);\\n\\n    float d2 = 0.0f;\\n    if (spotPlateCount >= 3) {\\n        d2 = RisoClamp01(RisoDot3(a2, target) / fmax(RisoDot3(a2, a2), 1e-3f));"}]
0x1801ef4c9=[{"size":2047,"type":"s","subtype":98,"str":"        target.x = fmax(0.0f, target.x - d2 * a2.x);\\n        target.y = fmax(0.0f, target.y - d2 * a2.y);\\n        target.z = fmax(0.0f, target.z - d2 * a2.z);\\n    }\\n\\n    float d3 = 0.0f;\\n    if (spotPlateCount >= 4) {\\n        d3 = RisoClamp01(RisoDot3(a3, target) / fmax(RisoDot3(a3, a3), 1e-3f));\\n    }\\n\\n    float4 outColor;\\n    outColor.x = d0;\\n    outColor.y = d1;\\n    outColor.z = d2;\\n    outColor.w = d3;\\n    return outColor;\\n}\\n\\ninline float4 RisoSpotBalancedDecompose(float3 target,\\n                                        float3 a0, float3 a1, float3 a2, float3 a3,\\n                                        int spotPlateCount)\\n{\\n    float d0 = 0.0f;\\n    float d1 = 0.0f;\\n    float d2 = 0.0f;\\n    float d3 = 0.0f;\\n\\n    for (int sweep = 0; sweep < 4; ++sweep) {\\n        d0 = RisoSpotCoordUpdate(target, a0, d0, a0, d0, a1, d1, a2, d2, a3, d3);\\n        d1 = RisoSpotCoordUpdate(target, a1, d1, a0, d0, a1, d1, a2, d2, a3, d3);\\n        if (spotPlateCount >= 3) {\\n            d2 = RisoSpotCoordUpdate(target, a2, d2, a0, d0, a1, d1, a2, d2, a3, d3);\\n        }\\n        if (spotPlateCount >= 4) {\\n            d3 = RisoSpotCoordUpdate(target, a3, d3, a0, d0, a1, d1, a2, d2, a3, d3);\\n        }\\n        if (spotPlateCount >= 3) {\\n            d2 = RisoSpotCoordUpdate(target, a2, d2, a0, d0, a1, d1, a2, d2, a3, d3);\\n        }\\n        d1 = RisoSpotCoordUpdate(target, a1, d1, a0, d0, a1, d1, a2, d2, a3, d3);\\n        d0 = RisoSpotCoordUpdate(target, a0, d0, a0, d0, a1, d1, a2, d2, a3, d3);\\n    }\\n\\n    float4 outColor;\\n    outColor.x = d0;\\n    outColor.y = d1;\\n    outColor.z = (spotPlateCount >= 3) ? d2 : 0.0f;\\n    outColor.w = (spotPlateCount >= 4) ? d3 : 0.0f;\\n    return outColor;\\n}\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\nstatic __inline__ void RisoPass1Kernel_Delegate( __global const float4* inSrc, __global float4* outDst  , float4 spotInk0, float4 spotInk1, float4 spotInk2, float4 spotInk3, int inSrcPitch, int inDstPitch, int in16f, unsigned int inWidth, unsigned int inHeight, float brightness, float contrast, float hueDeg, float saturation, "}]
0x1801efcc8=[{"size":2047,"type":"s","subtype":98,"str":"float valueDelta, float gamma, float enrichDarkTones, int colorMode, int spotPlateCount, float magZoom, float magCenterX, float magCenterY, int colorSpaceMode, int spotSeparationMode, int lineArtPlate, float lineArtThreshold, float lineArtStrength, int hostPixelLayout, unsigned int inFullWidth, unsigned int inFullHeight, int inOutputOriginX, int inOutputOriginY, int inSrcBasePixel  , uint2 inXY    ); __kernel void RisoPass1Kernel( __global const float4* inSrc, __global float4* outDst  , float4 spotInk0, float4 spotInk1, float4 spotInk2, float4 spotInk3, int inSrcPitch, int inDstPitch, int in16f, unsigned int inWidth, unsigned int inHeight, float brightness, float contrast, float hueDeg, float saturation, float valueDelta, float gamma, float enrichDarkTones, int colorMode, int spotPlateCount, float magZoom, float magCenterX, float magCenterY, int colorSpaceMode, int spotSeparationMode, int lineArtPlate, float lineArtThreshold, float lineArtStrength, int hostPixelLayout, unsigned int inFullWidth, unsigned int inFullHeight, int inOutputOriginX, int inOutputOriginY, int inSrcBasePixel  ) {   RisoPass1Kernel_Delegate( inSrc, outDst  , spotInk0, spotInk1, spotInk2, spotInk3, inSrcPitch, inDstPitch, in16f, inWidth, inHeight, brightness, contrast, hueDeg, saturation, valueDelta, gamma, enrichDarkTones, colorMode, spotPlateCount, magZoom, magCenterX, magCenterY, colorSpaceMode, spotSeparationMode, lineArtPlate, lineArtThreshold, lineArtStrength, hostPixelLayout, inFullWidth, inFullHeight, inOutputOriginX, inOutputOriginY, inSrcBasePixel  , KernelXYUnsigned()    ); } static __inline__ void RisoPass1Kernel_Delegate( __global const float4* inSrc, __global float4* outDst  , float4 spotInk0, float4 spotInk1, float4 spotInk2, float4 spotInk3, int inSrcPitch, int inDstPitch, int in16f, unsigned int inWidth, unsigned int inHeight, float brightness, float contrast, float hueDeg, float saturation, float valueDelta, float gamma, float enrichDarkTones, int colorMode, int spotPlateCount, float magZoom, float magCenterX, float magCent"}]
0x1801f04c7=[{"size":2033,"type":"s","subtype":98,"str":"erY, int colorSpaceMode, int spotSeparationMode, int lineArtPlate, float lineArtThreshold, float lineArtStrength, int hostPixelLayout, unsigned int inFullWidth, unsigned int inFullHeight, int inOutputOriginX, int inOutputOriginY, int inSrcBasePixel  , uint2 inXY    )\\n#line 1142 \\"C:\\\\\\\\AE\\\\\\\\Examples\\\\\\\\Effect\\\\\\\\Risograph\\\\\\\\core\\\\\\\\kernels\\\\\\\\Risograph_Kernel.cu\\"\\n{\\n    if (inXY.x >= inWidth || inXY.y >= inHeight) {\\n        return;\\n    }\\n\\n    \\n\\n\\n\\n    float2 uv;\\n    uv.x = ((float)inXY.x + (float)inOutputOriginX + 0.5f) / (float)inFullWidth;\\n    uv.y = ((float)inXY.y + (float)inOutputOriginY + 0.5f) / (float)inFullHeight;\\n\\n    float2 magCenter;\\n    magCenter.x = magCenterX;\\n    magCenter.y = magCenterY;\\n    float2 sampleUV = RisoMagnifyUV(uv, magZoom, magCenter);\\n\\n    \\n    int srcX = (int)(sampleUV.x * (float)inFullWidth) - inOutputOriginX;\\n    int srcY = (int)(sampleUV.y * (float)inFullHeight) - inOutputOriginY;\\n    if (srcX < 0) srcX = 0;\\n    if (srcX >= (int)inWidth)  srcX = (int)inWidth  - 1;\\n    if (srcY < 0) srcY = 0;\\n    if (srcY >= (int)inHeight) srcY = (int)inHeight - 1;\\n\\n    float4 src = ReadFloat4(inSrc, inSrcBasePixel + srcY * inSrcPitch + srcX, !!in16f);\\n    float3 rgb = RisoUnpremulHostPixelToRgb(src, hostPixelLayout);\\n\\n    \\n\\n\\n\\n    \\n\\n\\n\\n\\n    if (colorSpaceMode == 2) {\\n        rgb = RisoSrgbToLinear3(rgb);\\n    }\\n\\n    \\n    rgb = RisoClampF3(rgb);\\n    rgb.x = pow(rgb.x, 1.0f / gamma);\\n    rgb.y = pow(rgb.y, 1.0f / gamma);\\n    rgb.z = pow(rgb.z, 1.0f / gamma);\\n\\n    \\n    if (fabs(hueDeg) > 0.001f || fabs(saturation) > 0.001f || fabs(valueDelta) > 0.001f) {\\n        float3 hsv = RisoRGBToHSV(RisoClampF3(rgb));\\n        hsv.x = hsv.x + hueDeg / 360.0f;\\n        hsv.x = hsv.x - floor(hsv.x);  \\n        hsv.y = fmax(0.0f, fmin(1.0f, hsv.y * (1.0f + saturation / 100.0f)));\\n        hsv.z = fmax(0.0f, fmin(1.0f, hsv.z * (1.0f + valueDelta / 100.0f)));\\n        rgb = RisoHSVToRGB(hsv);\\n    }\\n\\n    \\n    float a = 1.0f + contrast / 100.0f;\\n    float b = brightness / 100.0f - 0.5f * (a - 1.0f);\\n    rgb.x = rgb.x * a + b;"}]
0x1801f0cb8=[{"size":2047,"type":"s","subtype":98,"str":"    rgb.y = rgb.y * a + b;\\n    rgb.z = rgb.z * a + b;\\n    rgb = RisoClampF3(rgb);\\n\\n    float lineArtMask = 0.0f;\\n    if (lineArtPlate != 1 && lineArtStrength > 0.0f) {\\n        float centerLuma = RisoLuma3(rgb);\\n        float3 rawCenter = RisoUnpremulHostPixelToRgbWorking(src, hostPixelLayout, colorSpaceMode);\\n        float rawCenterLuma = RisoLuma3(rawCenter);\\n\\n        int x0 = srcX > 0 ? srcX - 1 : srcX;\\n        int x1 = srcX + 1 < (int)inWidth ? srcX + 1 : srcX;\\n        int y0 = srcY > 0 ? srcY - 1 : srcY;\\n        int y1 = srcY + 1 < (int)inHeight ? srcY + 1 : srcY;\\n\\n        float3 lrgb = RisoUnpremulHostPixelToRgbWorking(ReadFloat4(inSrc, inSrcBasePixel + srcY * inSrcPitch + x0, !!in16f), hostPixelLayout, colorSpaceMode);\\n        float3 rrgb = RisoUnpremulHostPixelToRgbWorking(ReadFloat4(inSrc, inSrcBasePixel + srcY * inSrcPitch + x1, !!in16f), hostPixelLayout, colorSpaceMode);\\n        float3 urgb = RisoUnpremulHostPixelToRgbWorking(ReadFloat4(inSrc, inSrcBasePixel + y0 * inSrcPitch + srcX, !!in16f), hostPixelLayout, colorSpaceMode);\\n        float3 drgb = RisoUnpremulHostPixelToRgbWorking(ReadFloat4(inSrc, inSrcBasePixel + y1 * inSrcPitch + srcX, !!in16f), hostPixelLayout, colorSpaceMode);\\n\\n        float edgeContrast = 0.0f;\\n        edgeContrast = fmax(edgeContrast, fabs(rawCenterLuma - RisoLuma3(lrgb)));\\n        edgeContrast = fmax(edgeContrast, fabs(rawCenterLuma - RisoLuma3(rrgb)));\\n        edgeContrast = fmax(edgeContrast, fabs(rawCenterLuma - RisoLuma3(urgb)));\\n        edgeContrast = fmax(edgeContrast, fabs(rawCenterLuma - RisoLuma3(drgb)));\\n        lineArtMask = RisoLineArtMask(centerLuma, edgeContrast, lineArtThreshold, lineArtStrength);\\n    }\\n\\n    \\n    float4 outColor;\\n\\n    if (colorMode == 2) {\\n        \\n\\n\\n        float3 target;\\n        target.x = 1.0f - rgb.x;\\n        target.y = 1.0f - rgb.y;\\n        target.z = 1.0f - rgb.z;\\n\\n        float3 a0; a0.x = 1.0f - spotInk0.x; a0.y = 1.0f - spotInk0.y; a0.z = 1.0f - spotInk0.z;\\n        float3 a1; a1.x = 1.0f - spotInk1.x; a1.y = 1.0f - spotInk1.y; a1.z = 1."}]
0x1801f14b7=[{"size":2047,"type":"s","subtype":98,"str":"0f - spotInk1.z;\\n        float3 a2; a2.x = 1.0f - spotInk2.x; a2.y = 1.0f - spotInk2.y; a2.z = 1.0f - spotInk2.z;\\n        float3 a3; a3.x = 1.0f - spotInk3.x; a3.y = 1.0f - spotInk3.y; a3.z = 1.0f - spotInk3.z;\\n\\n        if (spotSeparationMode == 2) {\\n            outColor = RisoSpotBalancedDecompose(target, a0, a1, a2, a3, spotPlateCount);\\n        } else {\\n            outColor = RisoSpotGreedyDecompose(target, a0, a1, a2, a3, spotPlateCount);\\n        }\\n    } else {\\n        \\n\\n        float cmyR = 1.0f - rgb.x;\\n        float cmyG = 1.0f - rgb.y;\\n        float cmyB = 1.0f - rgb.z;\\n        float k = fmin(fmin(cmyR, cmyG), cmyB);\\n\\n        float cmyNormR, cmyNormG, cmyNormB;\\n        if (k >= 1.0f) {\\n            cmyNormR = 0.0f;\\n            cmyNormG = 0.0f;\\n            cmyNormB = 0.0f;\\n        } else {\\n            float invKK = 1.0f / (1.0f - k);\\n            cmyNormR = (cmyR - k) * invKK;\\n            cmyNormG = (cmyG - k) * invKK;\\n            cmyNormB = (cmyB - k) * invKK;\\n        }\\n\\n        \\n        outColor.x = cmyNormR + (cmyR - cmyNormR) * enrichDarkTones;  \\n        outColor.y = cmyNormG + (cmyG - cmyNormG) * enrichDarkTones;  \\n        outColor.z = cmyNormB + (cmyB - cmyNormB) * enrichDarkTones;  \\n        outColor.w = k * (1.0f - enrichDarkTones);                    \\n    }\\n\\n    outColor = RisoApplyLineArt(outColor, lineArtMask, lineArtPlate, colorMode, spotPlateCount);\\n\\n    WriteFloat4(outColor, outDst, inXY.y * inDstPitch + inXY.x, !!in16f);\\n}\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\nstatic __inline__ void RisoPass2Kernel_Delegate( __global const float4* inSrc, __global float4* outDst  , int inSrcPitch, int inDstPitch, int in16f, unsigned int inWidth, unsigned int inHeight, float scale, int dotShape, float halftoneIntensity, float softness, float distortion, float halftoneAspect, float dotSmoothness, 