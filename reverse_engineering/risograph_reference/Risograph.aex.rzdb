0x1801c256f=[{"size":327,"type":"s","subtype":56,"str":" Color-blindness simulation (0 = off, default).\\n//   1 = Protanopia (red-blind), 2 = Deuteranopia (green-blind),\\n//   3 = Tritanopia (blue-blind), 4 = Achromatopsia.\\n// Matrices are the standard Vienot/Brettel/Mollon simulation operators\\n// applied on linear RGB. Off = passthrough, zero perf cost.\\nuniform int   cbSim;\\n\\n// I5 "}]
0x1801c26b9=[{"size":83,"type":"s","subtype":56,"str":" Soft-proofing (0 = off, default). Each non-zero slot applies a\\n// paper-substrate "}]
0x1801c270e=[{"size":338,"type":"s","subtype":56,"str":" viewing-light multiply on linear RGB to simulate\\n// how the print would actually look on that combination. NOT a full\\n// ICC transform (see ROADMAP I1).\\n//   1 = Newsprint (warm/dim), 2 = Bond office (cool fluorescent),\\n//   3 = Art matte (D65), 4 = Recycled (D50 overcast),\\n//   5 = Glossy (cool flash).\\nuniform int   softProof;\\n\\n// G4 "}]
0x1801c2863=[{"size":332,"type":"s","subtype":56,"str":" Negative output. 0 = off (default, passthrough), 1 = on (invert\\n// linear RGB at this stage, AFTER I4/I5 transforms). Pure post-process\\n// film-negative simulation; doesn't affect Pass 1/2/3 math.\\nuniform int   negativeOutput;\\n\\nin vec2 out_uvs;\\nlayout(location = 0) out vec4 colourOut;\\n\\n// IEC 61966-2-1 sRGB OETF (encode): linear "}]
0x1801c29b2=[{"size":167,"type":"s","subtype":56,"str":" sRGB\\nvec3 linearToSrgb(vec3 c) {\\n    vec3 lo = c * 12.92;\\n    vec3 hi = 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055;\\n    return mix(lo, hi, step(0.0031308, c));\\n}\\n\\n// I4 "}]
0x1801c2a5c=[{"size":34,"type":"s","subtype":56,"str":" Daltonize simulation. Pre-baked 3"}]
0x1801c2a80=[{"size":1101,"type":"s","subtype":56,"str":"3 matrices on linear RGB.\\n// Source: Brettel/Vienot/Mollon 1997, refined by Machado 2009.\\n// We apply directly (no Daltonize correction step) because the user's\\n// intent here is to *preview* what a CVD viewer sees, not auto-correct\\n// for them.\\nvec3 applyCbSim(vec3 rgb, int mode) {\\n    if (mode == 1) {                                    // Protanopia\\n        return vec3(\\n            dot(rgb, vec3(0.567, 0.433, 0.000)),\\n            dot(rgb, vec3(0.558, 0.442, 0.000)),\\n            dot(rgb, vec3(0.000, 0.242, 0.758)));\\n    } else if (mode == 2) {                             // Deuteranopia\\n        return vec3(\\n            dot(rgb, vec3(0.625, 0.375, 0.000)),\\n            dot(rgb, vec3(0.700, 0.300, 0.000)),\\n            dot(rgb, vec3(0.000, 0.300, 0.700)));\\n    } else if (mode == 3) {                             // Tritanopia\\n        return vec3(\\n            dot(rgb, vec3(0.950, 0.050, 0.000)),\\n            dot(rgb, vec3(0.000, 0.433, 0.567)),\\n            dot(rgb, vec3(0.000, 0.475, 0.525)));\\n    } else if (mode == 4) {                             // Achromatopsia\\n        // Rec. 709 luma "}]
0x1801c2ed0=[{"size":132,"type":"s","subtype":56,"str":" no chroma at all.\\n        float y = dot(rgb, vec3(0.2126, 0.7152, 0.0722));\\n        return vec3(y);\\n    }\\n    return rgb;\\n}\\n\\n// I5 "}]
0x1801c2f57=[{"size":47,"type":"s","subtype":56,"str":" Soft-proof. Each profile is (paper_white_tint "}]
0x1801c2f88=[{"size":192,"type":"s","subtype":56,"str":" viewing_light_mul).\\n// Encoded as per-channel multiplier so the math stays a single mul. Tuned\\n// by eye to match the typical look of each substrate-lighting pair under\\n// ambient inspection "}]
0x1801c304b=[{"size":670,"type":"s","subtype":56,"str":" not a full ICC chain (which needs lcms2; see I1).\\nvec3 applySoftProof(vec3 rgb, int mode) {\\n    vec3 m = vec3(1.0);\\n    if      (mode == 1) m = vec3(0.96, 0.91, 0.78); // newsprint warm-yellow\\n    else if (mode == 2) m = vec3(0.94, 0.97, 1.02); // bond office cool fluo\\n    else if (mode == 3) m = vec3(1.00, 1.00, 1.00); // art matte D65 reference\\n    else if (mode == 4) m = vec3(0.91, 0.93, 0.96); // recycled cool grey\\n    else if (mode == 5) m = vec3(0.98, 1.00, 1.06); // glossy + flash bluish\\n    return rgb * m;\\n}\\n\\nvoid main()\\n{\\n    // ---- Sample the rendered output, optionally with magnifier ----\\n    // Zoomed UV = magCenter + (uv - 0.5) / magZoom\\n    //   "}]
0x1801c32ec=[{"size":86,"type":"s","subtype":56,"str":" At zoom=1 this is just `uv` (identity, plus a tiny shift if\\n    //     center != 0.5 "}]
0x1801c3345=[{"size":56,"type":"s","subtype":56,"str":" clamped below to keep within texture bounds).\\n    //   "}]
0x1801c3380=[{"size":26,"type":"s","subtype":56,"str":" At zoom=20 we sample a 5%"}]
0x1801c339c=[{"size":91,"type":"s","subtype":56,"str":"5% region centred on `magCenter`.\\n    // Vector mode (1) is handled UPSTREAM in Pass 1/2/3 "}]
0x1801c33fa=[{"size":853,"type":"s","subtype":56,"str":" by the time we\\n    // reach SwizzleOut the texture already holds the zoomed re-rendered\\n    // image, so we just pass through. Off (0) trivially passes through.\\n    // Only Smooth (2) and Pixel-perfect (3) need a post-process zoom here.\\n    if (magMode <= 1 || magZoom <= 1.0001) {\\n        colourOut = texture(videoTexture, out_uvs.xy);\\n    } else {\\n        vec2 zoomedUV = magCenter + (out_uvs - vec2(0.5)) / magZoom;\\n        // Clamp to texture bounds so the magnifier never reads garbage at\\n        // the edges (it just shows the edge pixel repeated, which is fine\\n        // visually and never produces texture-wrap artefacts).\\n        zoomedUV = clamp(zoomedUV, vec2(0.0), vec2(1.0));\\n        if (magMode == 3) {\\n            // Pixel-perfect: texelFetch ignores sampler filter so each\\n            // output pixel maps to one exact rendered pixel "}]
0x1801c3752=[{"size":939,"type":"s","subtype":56,"str":" ideal for\\n            // studying dot anatomy (jitter, edge softness, halo, plate\\n            // rotation drift, reticulation, specks).\\n            ivec2 ts = textureSize(videoTexture, 0);\\n            ivec2 px = ivec2(zoomedUV * vec2(ts));\\n            // Extra clamp so texelFetch can't go out of bounds with\\n            // floating-point jitter at the right/bottom edge.\\n            px = clamp(px, ivec2(0), ts - ivec2(1));\\n            colourOut = texelFetch(videoTexture, px, 0);\\n        } else {\\n            // Smooth (magMode == 2): bilinear sample of the rendered output.\\n            // Good for animated keyframed zooms but blurs at high zoom.\\n            colourOut = texture(videoTexture, zoomedUV);\\n        }\\n    }\\n\\n    if (colourOut.a == 0.0) {\\n        colourOut = vec4(0.0);\\n    } else {\\n        // Unpremultiply first (encode must operate on straight alpha).\\n        vec3 straight = colourOut.rgb / colourOut.a;\\n\\n        // I5 "}]
0x1801c3b00=[{"size":46,"type":"s","subtype":56,"str":" Soft-proof on linear RGB BEFORE CB-sim. Paper"}]
0x1801c3b30=[{"size":206,"type":"s","subtype":56,"str":"lighting\\n        // multiplies happen in the same domain the inks lived in.\\n        if (softProof > 0) {\\n            straight = applySoftProof(clamp(straight, 0.0, 1.0), softProof);\\n        }\\n        // I4 "}]
0x1801c3c01=[{"size":315,"type":"s","subtype":56,"str":" CB sim AFTER soft-proof so the simulated viewer sees the\\n        // proofed image (matches reality: CVD viewer looks at the print\\n        // under whatever ambient light the soft-proof modelled).\\n        if (cbSim > 0) {\\n            straight = applyCbSim(clamp(straight, 0.0, 1.0), cbSim);\\n        }\\n        // G4 "}]
0x1801c3d3f=[{"size":149,"type":"s","subtype":56,"str":" Negative output AFTER I4/I5 so the negative is taken of\\n        // the proofed + CVD-simulated view (matches the conceptual order:\\n        // print "}]
0x1801c3dd7=[{"size":6,"type":"s","subtype":56,"str":" view "}]
0x1801c3de0=[{"size":41,"type":"s","subtype":56,"str":" photograph the negative). Skip when off "}]
0x1801c3e0c=[{"size":441,"type":"s","subtype":98,"str":" zero\\n        // perf cost (default).\\n        if (negativeOutput != 0) {\\n            straight = vec3(1.0) - clamp(straight, 0.0, 1.0);\\n        }\\n\\n        if (srgbLinearize > 0.5) {\\n            straight = linearToSrgb(clamp(straight, 0.0, 1.0));\\n        }\\n        // RGBA (straight) -> ARGB layout expected by AE\\n        colourOut = vec4(colourOut.a, straight.r, straight.g, straight.b);\\n    }\\n    colourOut = colourOut / multiplier16bit;\\n}\\n"}]
0x1801c3fd0=[{"size":410,"type":"s","subtype":56,"str":"\\n#version 330\\nuniform sampler2D inputTex;\\nuniform float brightness;        // -100..100\\nuniform float contrast;          // -100..100\\nuniform float hue;               // -180..180  (degrees; 0 = no shift)\\nuniform float saturation;        // -100..100\\nuniform float value;             // -100..100  (HSV V multiplier)\\nuniform float gamma;             // 0.1..4.0\\nuniform float enrichDarkTones;   // 0..1\\n\\n// F1 "}]
0x1801c416d=[{"size":253,"type":"s","subtype":56,"str":" Color mode: 0 = CMYK (legacy), 1 = Spot Riso decomposition.\\n// In spot mode each channel becomes the density of a different spot ink\\n// (`spotInk0..3`) computed by per-ink projection onto the absorption-\\n// space target. Off-diagonal terms are ignored "}]
0x1801c426d=[{"size":667,"type":"s","subtype":56,"str":" fast, robust, and gives\\n// pleasing results for typical 2-4 ink Riso palettes. Properly orthogonal\\n// inks (Federal Blue + Fluor Pink + Sunflower + Black) decompose nearly\\n// perfectly; aggressively similar inks just produce some over-density,\\n// which the downstream TAC clamp can rein in.\\nuniform int  colorMode;\\nuniform int  spotSeparationMode; // 1=Greedy legacy, 2=Balanced Mix\\nuniform int  lineArtPlate;       // 1=Off 2=Black/K 3..6=Plate 1..4\\nuniform float lineArtThreshold;   // 0..1\\nuniform float lineArtStrength;    // 0..1\\nuniform vec3 spotInk0, spotInk1, spotInk2, spotInk3;\\nuniform int  spotPlateCount;     // 2..4 (ignored in CMYK mode)\\n\\n// Magnifier "}]
0x1801c450b=[{"size":277,"type":"s","subtype":56,"str":" Vector zoom (re-render at zoom). When magZoom > 1 the\\n// source UV is transformed BEFORE the input texture sample so the CMYK\\n// separation operates on the zoomed-in source region. Combined with\\n// matching transforms in Pass 2/3, the whole pipeline re-renders at the\\n// zoom "}]
0x1801c4623=[{"size":328,"type":"s","subtype":56,"str":" mathematically crisp dots at any zoom factor.\\nuniform float magZoom;\\nuniform vec2  magCenter;\\n\\nvec2 magnifyUV(vec2 uv) {\\n    if (magZoom > 1.001) {\\n        return clamp(magCenter + (uv - vec2(0.5)) / magZoom, vec2(0.0), vec2(1.0));\\n    }\\n    return uv;\\n}\\n\\nin vec2 out_uvs;\\nlayout(location = 0) out vec4 colourOut;\\n\\n// ---- RGB "}]
0x1801c476e=[{"size":2035,"type":"s","subtype":98,"str":" HSV (Sam Hocevar) ----\\nvec3 rgb2hsv(vec3 c) {\\n    vec4 K = vec4(0.0, -1.0/3.0, 2.0/3.0, -1.0);\\n    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));\\n    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));\\n    float d = q.x - min(q.w, q.y);\\n    float e = 1.0e-10;\\n    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);\\n}\\nvec3 hsv2rgb(vec3 c) {\\n    vec4 K = vec4(1.0, 2.0/3.0, 1.0/3.0, 3.0);\\n    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);\\n    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);\\n}\\n\\nfloat luma3(vec3 c) {\\n    return dot(c, vec3(0.2126, 0.7152, 0.0722));\\n}\\n\\nvec3 sampleLineRgb(vec2 uv) {\\n    vec4 s = texture(inputTex, clamp(uv, vec2(0.0), vec2(1.0)));\\n    return clamp((s.a > 0.0) ? s.rgb / s.a : vec3(0.0), 0.0, 1.0);\\n}\\n\\nfloat lineArtMaskFor(vec3 gradedRgb, vec2 uv) {\\n    if (lineArtPlate == 1 || lineArtStrength <= 0.0) return 0.0;\\n\\n    float threshold = clamp(lineArtThreshold, 0.0, 1.0);\\n    float centerLuma = luma3(gradedRgb);\\n    float darkMask = clamp((threshold - centerLuma) * 4.0, 0.0, 1.0);\\n\\n    vec2 texel = 1.0 / vec2(textureSize(inputTex, 0));\\n    float rawCenterLuma = luma3(sampleLineRgb(uv));\\n    float edgeContrast = 0.0;\\n    edgeContrast = max(edgeContrast, abs(rawCenterLuma - luma3(sampleLineRgb(uv + vec2(-texel.x, 0.0)))));\\n    edgeContrast = max(edgeContrast, abs(rawCenterLuma - luma3(sampleLineRgb(uv + vec2( texel.x, 0.0)))));\\n    edgeContrast = max(edgeContrast, abs(rawCenterLuma - luma3(sampleLineRgb(uv + vec2(0.0, -texel.y)))));\\n    edgeContrast = max(edgeContrast, abs(rawCenterLuma - luma3(sampleLineRgb(uv + vec2(0.0,  texel.y)))));\\n\\n    float edgeStart = 0.18 - threshold * 0.10;\\n    float edgeMask = clamp((edgeContrast - edgeStart) * 5.0, 0.0, 1.0);\\n    return clamp(max(darkMask, edgeMask) * clamp(lineArtStrength, 0.0, 1.0), 0.0, 1.0);\\n}\\n\\nint lineArtTargetChannel(int plate, int mode, int activePlateCount) {\\n    if (plate == 1) return -1;\\n    int target = 3;\\n    if (plate >= 3 && plate <= 6) target = plate - 3;"}]
0x1801c4f61=[{"size":2047,"type":"s","subtype":98,"str":"    if (mode == 1) {\\n        int maxActive = clamp(activePlateCount - 1, 1, 3);\\n        target = min(target, maxActive);\\n    }\\n    return clamp(target, 0, 3);\\n}\\n\\nvec4 applyLineArt(vec4 outColor, float lineMask, int plate, int mode, int activePlateCount) {\\n    int target = lineArtTargetChannel(plate, mode, activePlateCount);\\n    if (target < 0 || lineMask <= 0.0) return outColor;\\n    if (target == 0) outColor.x = max(outColor.x, lineMask);\\n    if (target == 1) outColor.y = max(outColor.y, lineMask);\\n    if (target == 2) outColor.z = max(outColor.z, lineMask);\\n    if (target == 3) outColor.w = max(outColor.w, lineMask);\\n    return outColor;\\n}\\n\\nvec3 spotResidual(vec3 target, vec3 a0, float d0, vec3 a1, float d1,\\n                  vec3 a2, float d2, vec3 a3, float d3) {\\n    return target - d0 * a0 - d1 * a1 - d2 * a2 - d3 * a3;\\n}\\n\\nfloat spotCoordUpdate(vec3 target, vec3 axis, float current,\\n                      vec3 a0, float d0, vec3 a1, float d1,\\n                      vec3 a2, float d2, vec3 a3, float d3) {\\n    vec3 r = spotResidual(target, a0, d0, a1, d1, a2, d2, a3, d3) + current * axis;\\n    return clamp(dot(axis, r) / max(dot(axis, axis), 1e-3), 0.0, 1.0);\\n}\\n\\nvec4 spotGreedy(vec3 target, vec3 a0, vec3 a1, vec3 a2, vec3 a3, int plateCount) {\\n    float d0 = clamp(dot(a0, target) / max(dot(a0, a0), 1e-3), 0.0, 1.0);\\n    target = max(target - d0 * a0, vec3(0.0));\\n\\n    float d1 = clamp(dot(a1, target) / max(dot(a1, a1), 1e-3), 0.0, 1.0);\\n    target = max(target - d1 * a1, vec3(0.0));\\n\\n    float d2 = 0.0;\\n    if (plateCount >= 3) {\\n        d2 = clamp(dot(a2, target) / max(dot(a2, a2), 1e-3), 0.0, 1.0);\\n        target = max(target - d2 * a2, vec3(0.0));\\n    }\\n\\n    float d3 = 0.0;\\n    if (plateCount >= 4) {\\n        d3 = clamp(dot(a3, target) / max(dot(a3, a3), 1e-3), 0.0, 1.0);\\n    }\\n\\n    return vec4(d0, d1, d2, d3);\\n}\\n\\nvec4 spotBalanced(vec3 target, vec3 a0, vec3 a1, vec3 a2, vec3 a3, int plateCount) {\\n    float d0 = 0.0;\\n    float d1 = 0.0;\\n    float d2 = 0.0;\\n    float d3 = 0.0;\\n\\n    for (int sweep = 0; sweep < 4; "}]
0x1801c5760=[{"size":757,"type":"s","subtype":56,"str":"++sweep) {\\n        d0 = spotCoordUpdate(target, a0, d0, a0, d0, a1, d1, a2, d2, a3, d3);\\n        d1 = spotCoordUpdate(target, a1, d1, a0, d0, a1, d1, a2, d2, a3, d3);\\n        if (plateCount >= 3) d2 = spotCoordUpdate(target, a2, d2, a0, d0, a1, d1, a2, d2, a3, d3);\\n        if (plateCount >= 4) d3 = spotCoordUpdate(target, a3, d3, a0, d0, a1, d1, a2, d2, a3, d3);\\n        if (plateCount >= 3) d2 = spotCoordUpdate(target, a2, d2, a0, d0, a1, d1, a2, d2, a3, d3);\\n        d1 = spotCoordUpdate(target, a1, d1, a0, d0, a1, d1, a2, d2, a3, d3);\\n        d0 = spotCoordUpdate(target, a0, d0, a0, d0, a1, d1, a2, d2, a3, d3);\\n    }\\n\\n    return vec4(d0, d1, plateCount >= 3 ? d2 : 0.0, plateCount >= 4 ? d3 : 0.0);\\n}\\n\\nvoid main()\\n{\\n    // Vector zoom (if enabled) "}]
