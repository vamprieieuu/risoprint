0x1801c1dd0=[{"size":137,"type":"s","subtype":56,"str":"\\n#version 330\\nuniform sampler2D videoTexture;\\nuniform float multiplier16bit;\\nuniform float srgbLinearize;   // 0 = passthrough, 1 = sRGB "}]
0x1801c1e5c=[{"size":109,"type":"s","subtype":56,"str":" linear\\nin vec2 out_uvs;\\nlayout(location = 0) out vec4 colourOut;\\n\\n// IEC 61966-2-1 sRGB EOTF (decode): sRGB "}]
0x1801c1ecc=[{"size":382,"type":"s","subtype":56,"str":" linear\\nvec3 srgbToLinear(vec3 c) {\\n    vec3 lo = c / 12.92;\\n    vec3 hi = pow((c + 0.055) / 1.055, vec3(2.4));\\n    return mix(lo, hi, step(0.04045, c));\\n}\\n\\nvoid main()\\n{\\n    colourOut = texture(videoTexture, out_uvs.xy);\\n    colourOut = colourOut * multiplier16bit;\\n    // ARGB -> RGBA\\n    colourOut = vec4(colourOut.g, colourOut.b, colourOut.a, colourOut.r);\\n    // Optional sRGB "}]
0x1801c204d=[{"size":390,"type":"s","subtype":98,"str":" linear on unpremultiplied colour (decode must happen\\n    // on *straight* alpha; if we linearized after premul, a half-transparent\\n    // black pixel would decode differently from an opaque one).\\n    if (srgbLinearize > 0.5) {\\n        colourOut.rgb = srgbToLinear(clamp(colourOut.rgb, 0.0, 1.0));\\n    }\\n    // premultiply\\n    colourOut = vec4(colourOut.rgb * colourOut.a, colourOut.a);\\n}\\n"}]
