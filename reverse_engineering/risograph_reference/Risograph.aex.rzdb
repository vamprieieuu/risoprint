0x1801d5710=[{"size":413,"type":"s","subtype":56,"str":" exaggerated.\\n    if (dotGain > 1.001) {\\n        float invGain = 1.0 / dotGain;\\n        cCov = pow(cCov, invGain);\\n        mCov = pow(mCov, invGain);\\n        yCov = pow(yCov, invGain);\\n        kCov = pow(kCov, invGain);\\n    }\\n\\n    // ====== 3a''. PER-INK RESPONSE CURVE (I2) ======\\n    // Per-plate tone curve: cov_out = cov_in ^ (1/curve). Different inks\\n    // saturate at different rates in real Riso machines "}]
