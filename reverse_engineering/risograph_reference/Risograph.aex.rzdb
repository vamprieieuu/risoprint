0x1801fa44e=[{"size":2024,"type":"s","subtype":98,"str":"ollerAngleRad, int overprintMode, float inkOpacityC, float inkOpacityM, float inkOpacityY, float inkOpacityK, float tacLimit, float inkPool, float haloRadius, float haloIntensity, float ghostOffsetX, float ghostOffsetY, float ghostOpacity, float reticulation, float reticulationScale, float showThrough, float drumAnimW, float plateMaskC, float plateMaskM, float plateMaskY, float plateMaskK, float lightIntensity, float lightAngleRad, float lightElevation, float ambientLight, float threePointLighting, float outputGamma, int quality, float magZoom, float magCenterX, float magCenterY, int proofMode, int paperType, int colorSpaceMode, float inkCurveC, float inkCurveM, float inkCurveY, float inkCurveK, int impressions, float impressionJitter, int cbSim, int softProof, int negativeOutput, int reversePrint, float inkDrift, float frameTimeSec, int backgroundMode, int isLicensed, int hostPixelLayout, unsigned int inFullWidth, unsigned int inFullHeight, int inOutputOriginX, int inOutputOriginY, int inOrigBasePixel, int inDstBasePixel, int inInputOriginX, int inInputOriginY, unsigned int inOutputWindowWidth, unsigned int inOutputWindowHeight  , uint2 inXY    )\\n#line 2108 \\"C:\\\\\\\\AE\\\\\\\\Examples\\\\\\\\Effect\\\\\\\\Risograph\\\\\\\\core\\\\\\\\kernels\\\\\\\\Risograph_Kernel.cu\\"\\n{\\n    if (inXY.x >= inOutputWindowWidth || inXY.y >= inOutputWindowHeight ||\\n        inXY.x >= inWidth || inXY.y >= inHeight) {\\n        return;\\n    }\\n\\n    float resW = (float)inFullWidth;\\n    float resH = (float)inFullHeight;\\n    uint2 absoluteXY;\\n    absoluteXY.x = inXY.x + (unsigned int)inOutputOriginX;\\n    absoluteXY.y = inXY.y + (unsigned int)inOutputOriginY;\\n\\n    \\n    float2 outUV;\\n    outUV.x = ((float)inXY.x + (float)inOutputOriginX + 0.5f) / resW;\\n    outUV.y = ((float)inXY.y + (float)inOutputOriginY + 0.5f) / resH;\\n    float2 magCenter; magCenter.x = magCenterX; magCenter.y = magCenterY;\\n    float2 uv = RisoMagnifyUV(outUV, magZoom, magCenter);\\n    \\n    int srcXi, srcYi;\\n    {\\n        float fx = uv.x * resW - 0.5f;\\n        float fy = uv.y * resH - 0.5f;"}]
0x1801fac36=[{"size":2047,"type":"s","subtype":98,"str":"        srcXi = (int)floor(fx) - inInputOriginX;\\n        srcYi = (int)floor(fy) - inInputOriginY;\\n        if (srcXi < 0) srcXi = 0; if (srcXi >= (int)inWidth)  srcXi = (int)inWidth  - 1;\\n        if (srcYi < 0) srcYi = 0; if (srcYi >= (int)inHeight) srcYi = (int)inHeight - 1;\\n    }\\n    \\n\\n\\n    float4 src = ReadFloat4(inOriginal, inOrigBasePixel + srcYi * inOrigPitch + srcXi, !!in16f);\\n    float srcAlpha = src.w;\\n    float3 srcRgb = RisoUnpremulHostPixelToRgb(src, hostPixelLayout);\\n    int usePaperBackground = (backgroundMode == 1);\\n    int transparentBackground = (backgroundMode == 2);\\n    int originalBackground = (backgroundMode == 3);\\n\\n    \\n    int noiseOctaves = 2 + quality * 2;\\n    if (noiseOctaves > 7) noiseOctaves = 7;\\n\\n    \\n    float crScale = paperScale * 0.5f;\\n    float2 crumpleLookupUV = (magZoom > 1.001f) ? outUV : uv;\\n    float2 nCr1; nCr1.x = crumpleLookupUV.x * crScale;        nCr1.y = crumpleLookupUV.y * crScale;\\n    float2 nCr2; nCr2.x = crumpleLookupUV.x * crScale + 7.3f; nCr2.y = crumpleLookupUV.y * crScale + 3.1f;\\n    float hC  = RisoFBM(nCr1, noiseOctaves);\\n    float hC2 = RisoFBM(nCr2, noiseOctaves);\\n\\n    \\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n    float2 halftoneUV;\\n    halftoneUV.x = RisoApplyProofCrumpleCoordinate(outUV.x, hC, paperCrumpling);\\n    halftoneUV.y = RisoApplyProofCrumpleCoordinate(outUV.y, hC2, paperCrumpling);\\n\\n    float4 coverage = RisoSampleProofCoverage(\\n        inSrc, inHaloBlur, halftoneUV, uv,\\n        resW, resH, inInputOriginX, inInputOriginY,\\n        (int)inWidth, (int)inHeight, inSrcPitch, inHaloPitch, in16f,\\n        impressions, impressionJitter, haloRadius, haloIntensity,\\n        ghostOffsetX, ghostOffsetY, ghostOpacity,\\n        inkIntensity, multiplyK, plateMaskC, plateMaskM, plateMaskY, plateMaskK,\\n        dotGain, inkCurveC, inkCurveM, inkCurveY, inkCurveK,\\n        rollerAmount, rollerFreq, rollerAngleRad);\\n\\n    \\n    if (srcAlpha == 0.0f && proofMode != 7) {\\n        float4 zero; zero.x = 0.0f; zero.y = 0.0f; zero.z = 0.0f; zero.w = 0.0f;\\n        zero = RisoApplyTrialWatermarkHost"}]
0x1801fb435=[{"size":2026,"type":"s","subtype":98,"str":"(zero, absoluteXY, inFullWidth, inFullHeight,\\n                                           isLicensed, hostPixelLayout);\\n        WriteFloat4(zero, outDst, inDstBasePixel + inXY.y * inDstPitch + inXY.x, !!in16f);\\n        return;\\n    }\\n\\n    \\n    float3 paper;\\n    if (originalBackground) {\\n        paper = srcRgb;\\n    } else if (transparentBackground) {\\n        paper.x = 1.0f; paper.y = 1.0f; paper.z = 1.0f;\\n    } else {\\n        paper.x = paperColorX; paper.y = paperColorY; paper.z = paperColorZ;\\n    }\\n\\n    \\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n    if (usePaperBackground && paperStructure > 0.0f) {\\n        float2 fp;\\n        fp.x = uv.x * paperScale * 2.0f;\\n        fp.y = uv.y * paperScale * 2.0f;\\n        float fiberStrength = 1.0f;\\n        float overlay = 0.5f;  \\n\\n        if (paperType == 2) {\\n            \\n            fp.x *= 2.5f; fp.y *= 2.5f;\\n            fiberStrength = 2.0f;\\n        } else if (paperType == 3) {\\n            \\n            fp.x *= 0.55f; fp.y *= 0.55f;\\n            fiberStrength = 0.7f;\\n        } else if (paperType == 4) {\\n            \\n\\n\\n\\n            fp.x *= 1.0f; fp.y *= 0.10f;\\n            fiberStrength = 1.5f;\\n            \\n\\n\\n            float bandY = uv.y * paperScale * 0.6f;\\n            float bandX = uv.x * paperScale * 0.08f;\\n            overlay = 0.5f + 0.18f * sin(bandY * 6.2832f) * cos(bandX * 6.2832f);\\n        } else if (paperType == 5) {\\n            \\n\\n\\n            fp.x *= 1.5f; fp.y *= 0.07f;\\n            fiberStrength = 1.7f;\\n            float bandY = uv.y * paperScale * 1.2f;\\n            overlay = 0.5f + 0.25f * sin(bandY * 6.2832f);\\n        } else if (paperType == 6) {\\n            \\n            fp.x *= 0.30f; fp.y *= 0.30f;\\n            fiberStrength = 0.20f;\\n        }\\n        \\n\\n\\n\\n        float fiber = RisoFBM(fp, noiseOctaves);\\n        \\n\\n        float combined = fiber * 0.6f + overlay * 0.4f;\\n        float fiberShade = 0.5f + (combined - 0.5f) * 0.85f * fiberStrength;\\n        float3 sl = RisoSoftLight(paper, fiberShade);\\n\\n        \\n\\n\\n\\n\\n\\n\\n        float typeBoost = (paperType == 1) ? 1.0f : 2.5f;"}]
0x1801fbc1f=[{"size":2047,"type":"s","subtype":98,"str":"        float effStruct = fmin(1.0f, paperStructure * typeBoost);\\n        paper.x = RisoMix(paper.x, sl.x, effStruct);\\n        paper.y = RisoMix(paper.y, sl.y, effStruct);\\n        paper.z = RisoMix(paper.z, sl.z, effStruct);\\n    }\\n\\n    \\n    if (usePaperBackground && paperTone > 0.0f) {\\n        float2 tp; tp.x = uv.x * paperScale * 0.8f; tp.y = uv.y * paperScale * 0.8f;\\n        float toneNoise = RisoFBM(tp, 2);\\n        float toneFac = paperTone * (0.7f + 0.6f * toneNoise);\\n        toneFac = fmax(0.0f, fmin(1.0f, toneFac));\\n        paper.x *= RisoMix(1.0f, paperToneR, toneFac);\\n        paper.y *= RisoMix(1.0f, paperToneG, toneFac);\\n        paper.z *= RisoMix(1.0f, paperToneB, toneFac);\\n    }\\n\\n    \\n\\n\\n\\n\\n\\n\\n    if (usePaperBackground && showThrough > 0.001f) {\\n        float2 stUV; stUV.x = uv.x; stUV.y = 1.0f - uv.y;\\n        float pxX = 1.5f / resW;\\n        float pxY = 1.5f / resH;\\n        float2 q1; q1.x = stUV.x + pxX; q1.y = stUV.y + pxY;\\n        float2 q2; q2.x = stUV.x - pxX; q2.y = stUV.y + pxY;\\n        float2 q3; q3.x = stUV.x + pxX; q3.y = stUV.y - pxY;\\n        float2 q4; q4.x = stUV.x - pxX; q4.y = stUV.y - pxY;\\n        float2 q1w = RisoFullToWindowUV(q1, resW, resH, inInputOriginX, inInputOriginY, inWidth, inHeight);\\n        float2 q2w = RisoFullToWindowUV(q2, resW, resH, inInputOriginX, inInputOriginY, inWidth, inHeight);\\n        float2 q3w = RisoFullToWindowUV(q3, resW, resH, inInputOriginX, inInputOriginY, inWidth, inHeight);\\n        float2 q4w = RisoFullToWindowUV(q4, resW, resH, inInputOriginX, inInputOriginY, inWidth, inHeight);\\n        float4 s1 = RisoSampleCMYKBlurred(inOriginal, q1w, 0.0f, inOrigPitch, (int)inWidth, (int)inHeight, inOrigBasePixel, in16f);\\n        float4 s2 = RisoSampleCMYKBlurred(inOriginal, q2w, 0.0f, inOrigPitch, (int)inWidth, (int)inHeight, inOrigBasePixel, in16f);\\n        float4 s3 = RisoSampleCMYKBlurred(inOriginal, q3w, 0.0f, inOrigPitch, (int)inWidth, (int)inHeight, inOrigBasePixel, in16f);\\n        float4 s4 = RisoSampleCMYKBlurred(inOriginal, q4w, 0.0f, inOrigPitch, (int)inW"}]
0x1801fc41e=[{"size":2047,"type":"s","subtype":98,"str":"idth, (int)inHeight, inOrigBasePixel, in16f);\\n        \\n        float3 st1 = RisoHostPixelToRgb(s1, hostPixelLayout);\\n        float3 st2 = RisoHostPixelToRgb(s2, hostPixelLayout);\\n        float3 st3 = RisoHostPixelToRgb(s3, hostPixelLayout);\\n        float3 st4 = RisoHostPixelToRgb(s4, hostPixelLayout);\\n        float3 stCol;\\n        stCol.x = (st1.x + st2.x + st3.x + st4.x) * 0.25f;\\n        stCol.y = (st1.y + st2.y + st3.y + st4.y) * 0.25f;\\n        stCol.z = (st1.z + st2.z + st3.z + st4.z) * 0.25f;\\n        float stDark = 1.0f - (stCol.x * 0.299f + stCol.y * 0.587f + stCol.z * 0.114f);\\n        float darkening = 1.0f - 0.35f * stDark;\\n        paper.x *= RisoMix(1.0f, darkening, showThrough);\\n        paper.y *= RisoMix(1.0f, darkening, showThrough);\\n        paper.z *= RisoMix(1.0f, darkening, showThrough);\\n    }\\n    paper = RisoClampF3(paper);\\n\\n    \\n    float3 paperNormal;\\n    if (!usePaperBackground) {\\n        paperNormal.x = 0.0f; paperNormal.y = 0.0f; paperNormal.z = 1.0f;\\n    } else\\n    {\\n        float epsRes = 1.5f / fmax(resW, resH);\\n        float2 ql; ql.x = (uv.x - epsRes) * crScale; ql.y = uv.y * crScale;\\n        float2 qr; qr.x = (uv.x + epsRes) * crScale; qr.y = uv.y * crScale;\\n        float2 qd; qd.x = uv.x * crScale; qd.y = (uv.y - epsRes) * crScale;\\n        float2 qu; qu.x = uv.x * crScale; qu.y = (uv.y + epsRes) * crScale;\\n        float hL = RisoFBM(ql, noiseOctaves);\\n        float hR = RisoFBM(qr, noiseOctaves);\\n        float hD = RisoFBM(qd, noiseOctaves);\\n        float hU = RisoFBM(qu, noiseOctaves);\\n        float amp = 0.5f + paperCrumpling * 12.0f;\\n        float3 nb;\\n        nb.x = (hL - hR) * amp;\\n        nb.y = (hD - hU) * amp;\\n        nb.z = 1.0f;\\n        paperNormal = RisoNormalize3(nb);\\n    }\\n\\n    \\n    float cCov = coverage.x;\\n    float mCov = coverage.y;\\n    float yCov = coverage.z;\\n    float kCov = coverage.w;\\n\\n    \\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n    if (proofMode != 1) {\\n        float intensity = 0.0f;\\n        float proofAlpha = srcAlpha;\\n        \\n        float3 inkColor; inkColor.x = 0.0f; in"}]
0x1801fcc1d=[{"size":2047,"type":"s","subtype":98,"str":"kColor.y = 0.0f; inkColor.z = 0.0f;\\n\\n        if (proofMode == 2) {\\n            \\n\\n\\n            intensity = fmax(fmax(cCov, mCov), fmax(yCov, kCov));\\n        } else if (proofMode == 3) {\\n            intensity = cCov;\\n            inkColor.x = inkCx; inkColor.y = inkCy; inkColor.z = inkCz;\\n        } else if (proofMode == 4) {\\n            intensity = mCov;\\n            inkColor.x = inkMx; inkColor.y = inkMy; inkColor.z = inkMz;\\n        } else if (proofMode == 5) {\\n            intensity = yCov;\\n            inkColor.x = inkYx; inkColor.y = inkYy; inkColor.z = inkYz;\\n        } else if (proofMode == 6) {\\n            intensity = kCov;\\n            inkColor.x = inkKx; inkColor.y = inkKy; inkColor.z = inkKz;\\n        } else if (proofMode == 7) {\\n            \\n\\n\\n            int qx = (uv.x < 0.5f) ? 0 : 1;\\n            int qy = (uv.y < 0.5f) ? 0 : 1;\\n            float2 quadUV;\\n            quadUV.x = (uv.x - 0.5f * (float)qx) * 2.0f;\\n            quadUV.y = (uv.y - 0.5f * (float)qy) * 2.0f;\\n            float2 quadCr1;\\n            quadCr1.x = quadUV.x * crScale;\\n            quadCr1.y = quadUV.y * crScale;\\n            float2 quadCr2;\\n            quadCr2.x = quadUV.x * crScale + 7.3f;\\n            quadCr2.y = quadUV.y * crScale + 3.1f;\\n            float quadHC = RisoFBM(quadCr1, noiseOctaves);\\n            float quadHC2 = RisoFBM(quadCr2, noiseOctaves);\\n            float2 quadHalftoneUV;\\n            quadHalftoneUV.x = RisoApplyProofCrumpleCoordinate(\\n                quadUV.x, quadHC, paperCrumpling);\\n            quadHalftoneUV.y = RisoApplyProofCrumpleCoordinate(\\n                quadUV.y, quadHC2, paperCrumpling);\\n            float4 quadCoverage = RisoSampleProofCoverage(\\n                inSrc, inHaloBlur, quadHalftoneUV, quadUV,\\n                resW, resH, inInputOriginX, inInputOriginY,\\n                (int)inWidth, (int)inHeight, inSrcPitch, inHaloPitch, in16f,\\n                impressions, impressionJitter, haloRadius, haloIntensity,\\n                ghostOffsetX, ghostOffsetY, ghostOpacity,\\n                inkIntensity, multiplyK, pla"}]
0x1801fd41c=[{"size":2040,"type":"s","subtype":98,"str":"teMaskC, plateMaskM, plateMaskY, plateMaskK,\\n                dotGain, inkCurveC, inkCurveM, inkCurveY, inkCurveK,\\n                rollerAmount, rollerFreq, rollerAngleRad);\\n            float quadAlpha = RisoSampleOriginalAlpha(\\n                inOriginal, quadUV, resW, resH,\\n                inInputOriginX, inInputOriginY,\\n                (int)inWidth, (int)inHeight, inOrigPitch, inOrigBasePixel, in16f);\\n            proofAlpha = quadAlpha;\\n            if      (qx == 0 && qy == 0) {\\n                intensity = quadCoverage.x;\\n                inkColor.x = inkCx; inkColor.y = inkCy; inkColor.z = inkCz;\\n            } else if (qx == 1 && qy == 0) {\\n                intensity = quadCoverage.y;\\n                inkColor.x = inkMx; inkColor.y = inkMy; inkColor.z = inkMz;\\n            } else if (qx == 0 && qy == 1) {\\n                intensity = quadCoverage.z;\\n                inkColor.x = inkYx; inkColor.y = inkYy; inkColor.z = inkYz;\\n            } else {\\n                intensity = quadCoverage.w;\\n                inkColor.x = inkKx; inkColor.y = inkKy; inkColor.z = inkKz;\\n            }\\n        }\\n        if (proofAlpha == 0.0f) {\\n            float4 zero; zero.x = 0.0f; zero.y = 0.0f; zero.z = 0.0f; zero.w = 0.0f;\\n            zero = RisoApplyTrialWatermarkHost(zero, absoluteXY, inFullWidth, inFullHeight,\\n                                               isLicensed, hostPixelLayout);\\n            WriteFloat4(zero, outDst, inDstBasePixel + inXY.y * inDstPitch + inXY.x, !!in16f);\\n            return;\\n        }\\n        \\n\\n\\n        if (proofMode == 7) {\\n            float guidePx = 1.0f / fmax(resW, resH);\\n            float distToVert = fabs(uv.x - 0.5f);\\n            float distToHorz = fabs(uv.y - 0.5f);\\n            if (distToVert < guidePx || distToHorz < guidePx) {\\n                intensity = 1.0f;\\n                inkColor.x = 0.0f; inkColor.y = 0.0f; inkColor.z = 0.0f;\\n            }\\n        }\\n        \\n\\n\\n\\n        float t = fmax(0.0f, fmin(1.0f, intensity));\\n        float3 result;\\n        result.x = RisoMix(1.0f, inkColor.x, t);"}]
0x1801fdc14=[{"size":2023,"type":"s","subtype":98,"str":"        result.y = RisoMix(1.0f, inkColor.y, t);\\n        result.z = RisoMix(1.0f, inkColor.z, t);\\n        float4 outF;\\n        outF = RisoStraightRgbAlphaToHostPixel(result, proofAlpha, hostPixelLayout);\\n        outF = RisoApplyTrialWatermarkHost(outF, absoluteXY, inFullWidth, inFullHeight,\\n                                           isLicensed, hostPixelLayout);\\n        WriteFloat4(outF, outDst, inDstBasePixel + inXY.y * inDstPitch + inXY.x, !!in16f);\\n        return;\\n    }\\n\\n    \\n    float tacExcess = 0.0f;\\n    if (tacLimit < 2.999f) {\\n        float covSum = cCov + mCov + yCov + kCov;\\n        if (covSum > tacLimit) {\\n            float scl = tacLimit / covSum;\\n            tacExcess = covSum - tacLimit;\\n            cCov *= scl; mCov *= scl; yCov *= scl; kCov *= scl;\\n        }\\n    }\\n\\n    \\n    if (usePaperBackground && paperStructure > 0.0f) {\\n        float2 pp; pp.x = uv.x * paperScale * 0.25f; pp.y = uv.y * paperScale * 0.25f;\\n        float paperNoise = RisoFBM(pp, 2);\\n        float structure = fmax(0.0f, fmin(1.0f, (paperNoise - 0.4f) / 0.14f));\\n        float interaction = paperStructure * 0.2f;\\n        float mod = RisoMix(1.0f, structure, interaction);\\n        cCov *= mod; mCov *= mod; yCov *= mod; kCov *= mod;\\n    }\\n\\n    \\n    float darkSpeckMask = 0.0f;\\n    if (darkSpecks > 0.0f) {\\n        float noiseScale = specksSize * 0.2f;\\n        float2 dp; dp.x = uv.x * noiseScale; dp.y = uv.y * noiseScale;\\n        float nFac = RisoFBM(dp, 2);\\n        float dMin = darkSpecks * 0.07f;\\n        float dMax = dMin + 0.05f;\\n        float t = (nFac - dMin) / fmax(dMax - dMin, 1e-4f);\\n        t = fmax(0.0f, fmin(1.0f, t));\\n        darkSpeckMask = (1.0f - t) * darkSpecks;\\n    }\\n\\n    \\n    float3 useC; useC.x = inkCx; useC.y = inkCy; useC.z = inkCz;\\n    float3 useM; useM.x = inkMx; useM.y = inkMy; useM.z = inkMz;\\n    float3 useY; useY.x = inkYx; useY.y = inkYy; useY.z = inkYz;\\n    float3 useK; useK.x = inkKx; useK.y = inkKy; useK.z = inkKz;\\n\\n    \\n\\n    if (inkDrift > 0.001f) {\\n        float maxShift = 0.0278f;"}]
0x1801fe3fb=[{"size":2047,"type":"s","subtype":98,"str":"        float dC = sin(frameTimeSec * 0.31f +  1.7f) * inkDrift * maxShift;\\n        float dM = sin(frameTimeSec * 0.43f +  4.1f) * inkDrift * maxShift;\\n        float dY = sin(frameTimeSec * 0.27f +  9.3f) * inkDrift * maxShift;\\n        float dK = sin(frameTimeSec * 0.19f + 13.7f) * inkDrift * maxShift;\\n        float3 hsv;\\n        hsv = RisoRGBToHSV(useC); hsv.x = hsv.x + dC; hsv.x = hsv.x - floor(hsv.x); useC = RisoHSVToRGB(hsv);\\n        hsv = RisoRGBToHSV(useM); hsv.x = hsv.x + dM; hsv.x = hsv.x - floor(hsv.x); useM = RisoHSVToRGB(hsv);\\n        hsv = RisoRGBToHSV(useY); hsv.x = hsv.x + dY; hsv.x = hsv.x - floor(hsv.x); useY = RisoHSVToRGB(hsv);\\n        hsv = RisoRGBToHSV(useK); hsv.x = hsv.x + dK; hsv.x = hsv.x - floor(hsv.x); useK = RisoHSVToRGB(hsv);\\n    }\\n\\n    \\n    if (inkColorFactor > 0.0f) {\\n        float3 mutedC; mutedC.x = 0.052823f; mutedC.y = 0.445925f; mutedC.z = 0.850980f;\\n        float3 mutedM; mutedM.x = 1.000000f; mutedM.y = 0.077374f; mutedM.z = 0.597661f;\\n        float3 mutedY; mutedY.x = 0.918134f; mutedY.y = 0.695481f; mutedY.z = 0.030740f;\\n        float3 mutedK; mutedK.x = 0.004287f; mutedK.y = 0.006604f; mutedK.z = 0.004020f;\\n        useC.x = RisoMix(useC.x, mutedC.x, inkColorFactor);\\n        useC.y = RisoMix(useC.y, mutedC.y, inkColorFactor);\\n        useC.z = RisoMix(useC.z, mutedC.z, inkColorFactor);\\n        useM.x = RisoMix(useM.x, mutedM.x, inkColorFactor);\\n        useM.y = RisoMix(useM.y, mutedM.y, inkColorFactor);\\n        useM.z = RisoMix(useM.z, mutedM.z, inkColorFactor);\\n        useY.x = RisoMix(useY.x, mutedY.x, inkColorFactor);\\n        useY.y = RisoMix(useY.y, mutedY.y, inkColorFactor);\\n        useY.z = RisoMix(useY.z, mutedY.z, inkColorFactor);\\n        useK.x = RisoMix(useK.x, mutedK.x, inkColorFactor);\\n        useK.y = RisoMix(useK.y, mutedK.y, inkColorFactor);\\n        useK.z = RisoMix(useK.z, mutedK.z, inkColorFactor);\\n    }\\n\\n    \\n    float fadeMask = 1.0f;\\n    if (inkFade > 0.0f) {\\n        float dx = cos(fadeDirRad), dy = sin(fadeDirRad);\\n        fadeMask = fmax(0.0f, fmin(1.0f"}]
0x1801febfa=[{"size":2028,"type":"s","subtype":98,"str":", 0.5f + (uv.x - 0.5f) * dx + (uv.y - 0.5f) * dy));\\n    }\\n    float effFade = inkFade * fadeMask;\\n    if (effFade > 0.0f) {\\n        useC.x = RisoMix(useC.x, 1.0f, effFade * 0.3f);\\n        useC.y = RisoMix(useC.y, 1.0f, effFade * 0.3f);\\n        useC.z = RisoMix(useC.z, 1.0f, effFade * 0.3f);\\n        useM.x = RisoMix(useM.x, 1.0f, effFade * 0.95f);\\n        useM.y = RisoMix(useM.y, 1.0f, effFade * 0.95f);\\n        useM.z = RisoMix(useM.z, 1.0f, effFade * 0.95f);\\n        useY.x = RisoMix(useY.x, 1.0f, effFade * 0.8f);\\n        useY.y = RisoMix(useY.y, 1.0f, effFade * 0.8f);\\n        useY.z = RisoMix(useY.z, 1.0f, effFade * 0.8f);\\n        \\n        useK.x = RisoMix(useK.x, useC.x, effFade * 0.33f);\\n        useK.y = RisoMix(useK.y, useC.y, effFade * 0.33f);\\n        useK.z = RisoMix(useK.z, useC.z, effFade * 0.33f);\\n        useK.x = RisoMix(useK.x, 1.0f, effFade * 0.02f);\\n        useK.y = RisoMix(useK.y, 1.0f, effFade * 0.02f);\\n        useK.z = RisoMix(useK.z, 1.0f, effFade * 0.02f);\\n    }\\n\\n    \\n    if (colorInconsistency > 0.0f) {\\n        float2 sp; sp.x = uv.x * paperScale * 0.25f; sp.y = uv.y * paperScale * 0.25f;\\n        float structNoise = RisoFBM(sp, 2);\\n        float hueShift = (structNoise - 0.5f) * colorInconsistency * 0.15f;\\n        float3 hsv;\\n        hsv = RisoRGBToHSV(useC); hsv.x = hsv.x + hueShift; hsv.x = hsv.x - floor(hsv.x); useC = RisoHSVToRGB(hsv);\\n        hsv = RisoRGBToHSV(useM); hsv.x = hsv.x + hueShift; hsv.x = hsv.x - floor(hsv.x); useM = RisoHSVToRGB(hsv);\\n        hsv = RisoRGBToHSV(useY); hsv.x = hsv.x + hueShift; hsv.x = hsv.x - floor(hsv.x); useY = RisoHSVToRGB(hsv);\\n        hsv = RisoRGBToHSV(useK); hsv.x = hsv.x + hueShift; hsv.x = hsv.x - floor(hsv.x); useK = RisoHSVToRGB(hsv);\\n    }\\n\\n    \\n    float3 result;\\n    if (overprintMode == 2) {\\n        \\n        float3 absorb; absorb.x = 0.0f; absorb.y = 0.0f; absorb.z = 0.0f;\\n        float fC = cCov * inkOpacityC;\\n        float fM = mCov * inkOpacityM;\\n        float fY = yCov * inkOpacityY;\\n        float fK = kCov * inkOpacityK;"}]
0x1801ff3e6=[{"size":2018,"type":"s","subtype":98,"str":"        absorb.x += fC * (1.0f - useC.x);\\n        absorb.y += fC * (1.0f - useC.y);\\n        absorb.z += fC * (1.0f - useC.z);\\n        absorb.x += fM * (1.0f - useM.x);\\n        absorb.y += fM * (1.0f - useM.y);\\n        absorb.z += fM * (1.0f - useM.z);\\n        absorb.x += fY * (1.0f - useY.x);\\n        absorb.y += fY * (1.0f - useY.y);\\n        absorb.z += fY * (1.0f - useY.z);\\n        absorb.x += fK * (1.0f - useK.x);\\n        absorb.y += fK * (1.0f - useK.y);\\n        absorb.z += fK * (1.0f - useK.z);\\n        result.x = paper.x * exp(-absorb.x);\\n        result.y = paper.y * exp(-absorb.y);\\n        result.z = paper.z * exp(-absorb.z);\\n    } else {\\n        \\n        result = paper;\\n        result.x = RisoMix(result.x, result.x * useC.x, cCov);\\n        result.y = RisoMix(result.y, result.y * useC.y, cCov);\\n        result.z = RisoMix(result.z, result.z * useC.z, cCov);\\n        result.x = RisoMix(result.x, result.x * useM.x, mCov);\\n        result.y = RisoMix(result.y, result.y * useM.y, mCov);\\n        result.z = RisoMix(result.z, result.z * useM.z, mCov);\\n        result.x = RisoMix(result.x, result.x * useY.x, yCov);\\n        result.y = RisoMix(result.y, result.y * useY.y, yCov);\\n        result.z = RisoMix(result.z, result.z * useY.z, yCov);\\n        result.x = RisoMix(result.x, result.x * useK.x, kCov);\\n        result.y = RisoMix(result.y, result.y * useK.y, kCov);\\n        result.z = RisoMix(result.z, result.z * useK.z, kCov);\\n    }\\n\\n    \\n    if (inkPool > 0.001f && tacExcess > 0.001f) {\\n        float pool = fmax(0.0f, fmin(0.6f, tacExcess * inkPool * 0.6f));\\n        float wsum = cCov + mCov + yCov + kCov + 1e-4f;\\n        float3 dominantInk;\\n        dominantInk.x = (useC.x * cCov + useM.x * mCov + useY.x * yCov + useK.x * kCov) / wsum;\\n        dominantInk.y = (useC.y * cCov + useM.y * mCov + useY.y * yCov + useK.y * kCov) / wsum;\\n        dominantInk.z = (useC.z * cCov + useM.z * mCov + useY.z * yCov + useK.z * kCov) / wsum;\\n        result.x = RisoMix(result.x, result.x * dominantInk.x, pool);"}]
0x1801ffbc8=[{"size":2018,"type":"s","subtype":98,"str":"        result.y = RisoMix(result.y, result.y * dominantInk.y, pool);\\n        result.z = RisoMix(result.z, result.z * dominantInk.z, pool);\\n    }\\n\\n    \\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n    if (reticulation > 0.001f) {\\n        float coverage = fmax(fmax(cCov, mCov), fmax(yCov, kCov));\\n        if (coverage > 0.35f) {\\n            \\n\\n\\n\\n\\n\\n\\n\\n            float2 wPos; wPos.x = outUV.x * reticulationScale; wPos.y = outUV.y * reticulationScale;\\n\\n            \\n\\n\\n            float n = RisoFBM(wPos, 3);\\n            float crackMask = RisoSmoothstep(0.47f, 0.50f, n) *\\n                              (1.0f - RisoSmoothstep(0.50f, 0.53f, n));\\n\\n            \\n\\n\\n\\n\\n\\n\\n            float2 sparsePos; sparsePos.x = wPos.x * 0.3f; sparsePos.y = wPos.y * 0.3f;\\n            float sparse = RisoSmoothstep(0.45f, 0.65f, RisoFBM(sparsePos, 2));\\n\\n            float covMask = RisoSmoothstep(0.35f, 0.85f, coverage);\\n            float reticAmount = crackMask * sparse * reticulation * 0.55f * covMask;\\n\\n            \\n\\n            result.x = RisoMix(result.x, paper.x, reticAmount);\\n            result.y = RisoMix(result.y, paper.y, reticAmount);\\n            result.z = RisoMix(result.z, paper.z, reticAmount);\\n        }\\n    }\\n\\n    \\n    if (darkSpeckMask > 0.0f) {\\n        float darkening = 1.0f - darkSpeckMask * 0.4f;\\n        result.x *= darkening;\\n        result.y *= darkening;\\n        result.z *= darkening;\\n    }\\n\\n    \\n\\n\\n\\n    if (reversePrint != 0) {\\n        result.x = 1.0f - fmax(0.0f, fmin(1.0f, result.x));\\n        result.y = 1.0f - fmax(0.0f, fmin(1.0f, result.y));\\n        result.z = 1.0f - fmax(0.0f, fmin(1.0f, result.z));\\n    }\\n\\n    \\n    if (outputGamma != 1.0f) {\\n        result.x = pow(fmax(result.x, 0.0f), outputGamma);\\n        result.y = pow(fmax(result.y, 0.0f), outputGamma);\\n        result.z = pow(fmax(result.z, 0.0f), outputGamma);\\n    }\\n\\n    \\n    float dirWeight = 1.0f - threePointLighting;\\n\\n    \\n    if (lightIntensity > 0.0f && dirWeight > 0.0f) {\\n        float ce = cos(lightElevation), se = sin(lightElevation);\\n        float3 lightDir;"}]
0x1802003aa=[{"size":2047,"type":"s","subtype":98,"str":"        lightDir.x = cos(lightAngleRad) * ce;\\n        lightDir.y = sin(lightAngleRad) * ce;\\n        lightDir.z = se;\\n        float diffuse = fmax(paperNormal.x * lightDir.x +\\n                             paperNormal.y * lightDir.y +\\n                             paperNormal.z * lightDir.z, 0.0f);\\n        float3 warmWhite;  warmWhite.x  = 1.00f; warmWhite.y  = 0.90f; warmWhite.z  = 0.86f;\\n        float3 coolBlue;   coolBlue.x   = 0.50f; coolBlue.y   = 0.72f; coolBlue.z   = 1.00f;\\n        float3 warmOrange; warmOrange.x = 1.00f; warmOrange.y = 0.70f; warmOrange.z = 0.55f;\\n        float wCool = fmax(0.0f, fmin(1.0f,  paperNormal.x * 0.5f + 0.5f));\\n        float wWarm = fmax(0.0f, fmin(1.0f, -paperNormal.y * 0.5f + 0.5f));\\n        float3 lightTint = warmWhite;\\n        lightTint.x = RisoMix(lightTint.x, coolBlue.x,   wCool * 0.3f);\\n        lightTint.y = RisoMix(lightTint.y, coolBlue.y,   wCool * 0.3f);\\n        lightTint.z = RisoMix(lightTint.z, coolBlue.z,   wCool * 0.3f);\\n        lightTint.x = RisoMix(lightTint.x, warmOrange.x, wWarm * 0.3f);\\n        lightTint.y = RisoMix(lightTint.y, warmOrange.y, wWarm * 0.3f);\\n        lightTint.z = RisoMix(lightTint.z, warmOrange.z, wWarm * 0.3f);\\n        float lighting = ambientLight + diffuse * lightIntensity;\\n        float3 lightVec;\\n        lightVec.x = fmax(0.0f, fmin(1.0f, lighting * lightTint.x));\\n        lightVec.y = fmax(0.0f, fmin(1.0f, lighting * lightTint.y));\\n        lightVec.z = fmax(0.0f, fmin(1.0f, lighting * lightTint.z));\\n        float3 lit = RisoSoftLight3(result, lightVec);\\n        result.x = RisoMix(result.x, lit.x, dirWeight);\\n        result.y = RisoMix(result.y, lit.y, dirWeight);\\n        result.z = RisoMix(result.z, lit.z, dirWeight);\\n    }\\n\\n    \\n    if (threePointLighting > 0.0f) {\\n        float3 L1_pos; L1_pos.x = -4.00f; L1_pos.y =  3.22f; L1_pos.z =  1.02f;\\n        float3 L2_pos; L2_pos.x =  5.25f; L2_pos.y = -2.48f; L2_pos.z = -0.30f;\\n        float3 L3_pos; L3_pos.x =  5.05f; L3_pos.y =  2.66f; L3_pos.z =  2.00f;\\n        float3 L1_col; L1_col.x = 1.000"}]
0x180200ba9=[{"size":2047,"type":"s","subtype":98,"str":"000f; L1_col.y = 0.903833f; L1_col.z = 0.862987f;\\n        float3 L2_col; L2_col.x = 0.132054f; L2_col.y = 0.525919f; L2_col.z = 1.000000f;\\n        float3 L3_col; L3_col.x = 1.000000f; L3_col.y = 0.504518f; L3_col.z = 0.277420f;\\n        float3 lampSum; lampSum.x = lampSum.y = lampSum.z = 0.0f;\\n        float3 c1 = RisoArtificialLamp(L1_pos, L1_col, 8.7f,  0.87f, paperNormal, uv, result);\\n        float3 c2 = RisoArtificialLamp(L2_pos, L2_col, 8.2f,  0.85f, paperNormal, uv, result);\\n        float3 c3 = RisoArtificialLamp(L3_pos, L3_col, 10.7f, 0.77f, paperNormal, uv, result);\\n        lampSum.x = c1.x + c2.x + c3.x;\\n        lampSum.y = c1.y + c2.y + c3.y;\\n        lampSum.z = c1.z + c2.z + c3.z;\\n        lampSum.x = fmax(0.0f, fmin(1.0f, lampSum.x));\\n        lampSum.y = fmax(0.0f, fmin(1.0f, lampSum.y));\\n        lampSum.z = fmax(0.0f, fmin(1.0f, lampSum.z));\\n        float3 lit = RisoSoftLight3(result, lampSum);\\n        result.x = RisoMix(result.x, lit.x, threePointLighting);\\n        result.y = RisoMix(result.y, lit.y, threePointLighting);\\n        result.z = RisoMix(result.z, lit.z, threePointLighting);\\n    }\\n\\n    result = RisoClampF3(result);\\n\\n    \\n\\n\\n\\n    if (softProof > 0) {\\n        float mx = 1.0f, my = 1.0f, mz = 1.0f;\\n        if      (softProof == 1) { mx = 0.96f; my = 0.91f; mz = 0.78f; } \\n        else if (softProof == 2) { mx = 0.94f; my = 0.97f; mz = 1.02f; } \\n        else if (softProof == 3) { mx = 1.00f; my = 1.00f; mz = 1.00f; } \\n        else if (softProof == 4) { mx = 0.91f; my = 0.93f; mz = 0.96f; } \\n        else if (softProof == 5) { mx = 0.98f; my = 1.00f; mz = 1.06f; } \\n        result.x *= mx;\\n        result.y *= my;\\n        result.z *= mz;\\n    }\\n\\n    \\n\\n\\n    if (cbSim > 0) {\\n        float r = result.x, g = result.y, b = result.z;\\n        if (cbSim == 1) {                                    \\n            result.x = 0.567f*r + 0.433f*g + 0.000f*b;\\n            result.y = 0.558f*r + 0.442f*g + 0.000f*b;\\n            result.z = 0.000f*r + 0.242f*g + 0.758f*b;\\n        } else if (cbSim == 2) {                    "}]
0x1802013a8=[{"size":1862,"type":"s","subtype":98,"str":"         \\n            result.x = 0.625f*r + 0.375f*g + 0.000f*b;\\n            result.y = 0.700f*r + 0.300f*g + 0.000f*b;\\n            result.z = 0.000f*r + 0.300f*g + 0.700f*b;\\n        } else if (cbSim == 3) {                             \\n            result.x = 0.950f*r + 0.050f*g + 0.000f*b;\\n            result.y = 0.000f*r + 0.433f*g + 0.567f*b;\\n            result.z = 0.000f*r + 0.475f*g + 0.525f*b;\\n        } else if (cbSim == 4) {                             \\n            float yLuma = 0.2126f*r + 0.7152f*g + 0.0722f*b;\\n            result.x = result.y = result.z = yLuma;\\n        }\\n    }\\n\\n    \\n\\n\\n    if (negativeOutput != 0) {\\n        result.x = 1.0f - fmax(0.0f, fmin(1.0f, result.x));\\n        result.y = 1.0f - fmax(0.0f, fmin(1.0f, result.y));\\n        result.z = 1.0f - fmax(0.0f, fmin(1.0f, result.z));\\n    }\\n\\n    \\n\\n\\n\\n\\n\\n    if (colorSpaceMode == 2) {\\n        result = RisoLinearToSrgb3(result);\\n    }\\n\\n    \\n    float outAlpha = srcAlpha;\\n    if (transparentBackground) {\\n        float printAlpha = fmax(fmax(cCov, mCov), fmax(yCov, kCov));\\n        printAlpha = fmax(printAlpha, darkSpeckMask * 0.6f);\\n        outAlpha = srcAlpha * fmax(0.0f, fmin(1.0f, printAlpha));\\n    }\\n    float4 outF = RisoStraightRgbAlphaToHostPixel(result, outAlpha, hostPixelLayout);\\n    outF = RisoApplyTrialWatermarkHost(outF, absoluteXY, inFullWidth, inFullHeight,\\n                                       isLicensed, hostPixelLayout);\\n    WriteFloat4(outF, outDst, inDstBasePixel + inXY.y * inDstPitch + inXY.x, !!in16f);\\n}\\n\\n#line 2894 \\"C:\\\\\\\\AE\\\\\\\\Examples\\\\\\\\Effect\\\\\\\\Risograph\\\\\\\\core\\\\\\\\kernels\\\\\\\\Risograph_Kernel.cu\\"\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n\\n#line 2906 \\"C:\\\\\\\\AE\\\\\\\\Examples\\\\\\\\Effect\\\\\\\\Risograph\\\\\\\\core\\\\\\\\kernels\\\\\\\\Risograph_Kernel.cu\\"\\n\\n#line 2908 \\"C:\\\\\\\\AE\\\\\\\\Exam