0x1801cd5c2=[{"size":516,"type":"s","subtype":56,"str":"0.10 smooth window. Voronoi uses this for\\n            // smooth-min cell distance; here we use it for a smooth threshold.\\n            if (edgeHalf > 0.0001) {\\n                dots[ch] = smoothstep((1.0 - val) - edgeHalf, (1.0 - val) + edgeHalf, threshold);\\n            } else {\\n                dots[ch] = step(1.0 - val, threshold);\\n            }\\n        }\\n        colourOut = dots;\\n        return;\\n    }\\n\\n\\n    // ---- screenType == RISO_SCREEN_VORONOI: Voronoi (legacy) path ----\\n    // Adaptive Voronoi randomness "}]
0x1801cd7c9=[{"size":194,"type":"s","subtype":56,"str":" Blender default 0.25 at normal scale,\\n    // up to 0.45 when cells shrink toward single-pixel size. Breaks the\\n    // pixel-grid resonance that otherwise produces rotation-dependent\\n    // Moir"}]
0x1801cd88d=[{"size":192,"type":"s","subtype":56,"str":" on ALL CMYK channels at high Scale.\\n    float cellPx     = resolution.y / max(scale, 1.0);\\n    float randomness = mix(0.45, 0.25, smoothstep(2.0, 6.0, cellPx));\\n\\n    // Subpixel offsets for 2"}]
