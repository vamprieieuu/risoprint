0x1801d1b5d=[{"size":91,"type":"s","subtype":56,"str":" color)\\n//\\n// Note: Blender does NOT clamp the Mix.002 output, so `fac` can be >1 or <0\\n// "}]
0x1801d1bbb=[{"size":871,"type":"s","subtype":56,"str":" lamps can both brighten AND darken. We mirror that; the caller clamps\\n// the final SUM before softLight to keep the blend stable.\\nvec3 artificialLampContrib(vec3 pos, vec3 color, float intensity, float radius,\\n                           vec3 normal, vec2 uv, vec3 img)\\n{\\n    vec2  shifted = uv - pos.xy;\\n    float scale   = 1.0 - clamp(radius, 0.0, 1.0);   // matches Math op=SUB clamp=1\\n    vec2  scaled  = shifted * scale;\\n    float len     = length(scaled);\\n    float rSph    = max(1.0 - len, 0.0);\\n    float grad    = rSph * rSph;                      // QUADRATIC_SPHERE\\n    float lit     = dot(normal, pos);\\n    // Clamp `lit` to non-negative. Mathematically Blender allows negative\\n    // (lamp \\"behind\\" the surface subtracts), but when the caller clamps\\n    // lampSum to [0,1] for SOFT_LIGHT, net-negative contributions collapse\\n    // to 0 and darken the base "}]
0x1801d1f25=[{"size":285,"type":"s","subtype":56,"str":" unwanted. Treating each lamp as\\n    // one-sided matches physical intuition and avoids the background\\n    // going near-black at uniform paper normals.\\n    float fac     = max(lit, 0.0) * grad * intensity;\\n    return fac * img * color;\\n}\\n\\nvoid main()\\n{\\n    // Vector zoom (if active) "}]
0x1801d2045=[{"size":362,"type":"s","subtype":56,"str":" every downstream `uv` reference (paper\\n    // noise, halftone lookup, ink mix, lighting normal, reticulation\\n    // Worley, ghost overlay, show-through mirror) automatically operates\\n    // on the zoomed source region. magnifyUV is identity at zoom=1.\\n    // Computed FIRST so the `src` alpha-gate sample below also reads from\\n    // the zoomed-source location "}]
0x1801d21b2=[{"size":1497,"type":"s","subtype":56,"str":" otherwise at Vector zoom the alpha\\n    // mask would lag behind the rest of the pipeline (e.g. transparent\\n    // corners of the source would gate-out the zoomed-in centre).\\n    vec2 uv = magnifyUV(out_uvs);\\n\\n    vec4 src = texture(inputTex, uv);\\n    float srcAlphaForBg = max(src.a, 1.0e-6);\\n    vec3 srcRgb = src.rgb / srcAlphaForBg;\\n    bool usePaperBackground = (backgroundMode == 1);\\n    bool transparentBackground = (backgroundMode == 2);\\n    bool originalBackground = (backgroundMode == 3);\\n\\n    // Paper / crumple noise octaves scale with Quality popup.\\n    // Blender's NTPaper Structure uses detail=7; we cap at 7 too at Ultra.\\n    //   Low=2, Medium=4, High=6, Ultra=7 (clamped).\\n    int noiseOctaves = min(7, 2 + quality * 2);\\n\\n    // ====== Crumple height field (shared by halftone warp + paper normal) ======\\n    // Two decorrelated fbm planes used both to distort the halftone lookup UV\\n    // and to derive a bump normal. Matching Blender, a single height field\\n    // drives both effects so lighting and halftone alignment stay consistent.\\n    float crScale = paperScale * 0.5;\\n    vec2 crumpleLookupUV = (magZoom > 1.001) ? out_uvs : uv;\\n    float hC  = fbm(crumpleLookupUV * crScale,                  noiseOctaves);\\n    float hC2 = fbm(crumpleLookupUV * crScale + vec2(7.3, 3.1), noiseOctaves);\\n\\n    // Halftone lookup UV: Blender uses a SOFT_LIGHT mix of UV with the\\n    // paper displacement texture. Approximate with additive displacement\\n    // using the same height field "}]
0x1801d278e=[{"size":52,"type":"s","subtype":56,"str":" geometrically this is what SOFT_LIGHT\\n    // at Fac"}]
