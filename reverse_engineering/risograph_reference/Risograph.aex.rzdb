0x1801d36ef=[{"size":248,"type":"s","subtype":56,"str":" `halftoneBlurTex` may not even be bound in that case.\\n    if (haloRadius > 0.001 && haloIntensity > 0.001) {\\n        vec4 haloDots = texture(halftoneBlurTex, halftoneUV);\\n        dots = max(dots, haloDots * haloIntensity);\\n    }\\n\\n    // ====== F9 "}]
0x1801d37ea=[{"size":787,"type":"s","subtype":56,"str":" Ghost / second-impression overlay ======\\n    // Samples halftoneTex at an offset and overlays via max(). max() (vs\\n    // additive) prevents over-saturation in already-solid areas: if the\\n    // sharp dot is already at 1.0, the ghost contributes nothing.\\n    if (ghostOpacity > 0.001) {\\n        vec2 ghostUV = halftoneUV + vec2(ghostOffsetX, ghostOffsetY) / resolution;\\n        vec4 ghostDots = texture(halftoneTex, ghostUV);\\n        dots = max(dots, ghostDots * ghostOpacity);\\n    }\\n\\n    float srcAlpha = src.a;\\n    if (srcAlpha == 0.0) {\\n        colourOut = vec4(0.0);\\n        return;\\n    }\\n\\n    // ====== 1. BACKGROUND / PAPER BASE ======\\n    vec3 paper = originalBackground ? srcRgb :\\n                 (transparentBackground ? vec3(1.0) : paperColor);\\n\\n    // Paper fiber structure "}]
0x1801d3b00=[{"size":186,"type":"s","subtype":56,"str":" high-frequency noise, blended SOFT_LIGHT for\\n    // a non-linear shading that preserves highlights/shadows more naturally\\n    // than pure additive does (matches Blender NTPaperTexture "}]
